<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="AppFont">Segoe UI, Nirmala UI</FontFamily>
  <Thickness x:Key="PagePadding">24</Thickness>
  <SolidColorBrush x:Key="ExpiryExpiredBrush" Color="#B42318"/>
  <SolidColorBrush x:Key="ExpiryCriticalBrush" Color="#B54708"/>
  <SolidColorBrush x:Key="ExpirySoonBrush" Color="#9A6700"/>
  <SolidColorBrush x:Key="ExpiryReadyBrush" Color="#067647"/>
  <SolidColorBrush x:Key="TableRuleBrush" Color="#D9DFE7"/>
  <SolidColorBrush x:Key="TableAlternateBrush" Color="#F5F7FA"/>
  <SolidColorBrush x:Key="SelectedTabBrush" Color="#E8F1FF"/>
  <SolidColorBrush x:Key="SelectedTabTextBrush" Color="#174EA6"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#B42318"/>
  <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FEF3F2"/>
  <SolidColorBrush x:Key="ErrorStrokeBrush" Color="#FECDCA"/>
  <SolidColorBrush x:Key="SelectionSurfaceBrush" Color="#EEF4FF"/>
  <SolidColorBrush x:Key="SelectionStrokeBrush" Color="#B2CCFF"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5B6472"/>
  <Style TargetType="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Table pages: one title row (title and actions), one filter row, the table, then the footer. -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>
  <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The previous/next page arrows beside a table footer's status line. -->
  <Style x:Key="PagerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="FilterLabel" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- Filter controls keep a 4 px bottom margin; matching it keeps labels on their line. -->
    <Setter Property="Margin" Value="0,0,6,4" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>
  <Style x:Key="StatusText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>
  <!-- Forms: title and context, grouped fields, inline errors, fixed footer actions. -->
  <Style x:Key="FormTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FormContext" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>
  <Style x:Key="FormSection" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,6,0,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SelectedTabTextBrush}" />
  </Style>
  <Style x:Key="FormPreview" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,2,0,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FormFooter" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <Style x:Key="CatalogCard" TargetType="Border">
    <Setter Property="Padding" Value="16"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
  </Style>
  <SolidColorBrush x:Key="TableGroupRuleBrush" Color="#9AA5B4"/>
  <Style x:Key="TableColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#EDF1F6"/>
    <Setter Property="BorderBrush" Value="{StaticResource TableRuleBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <!-- A header narrower than its text ends in an ellipsis and shows the full text on hover. -->
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TableCell" TargetType="DataGridCell">
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <!-- The stock cell template ignores padding and alignment, which left text at the top of each row. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The first column of a group of related columns, such as a bill line's sale side after its
       cost side, starts with a stronger rule. -->
  <Style x:Key="TableGroupHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableColumnHeader}">
    <Setter Property="BorderBrush" Value="{StaticResource TableGroupRuleBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,1,1"/>
  </Style>
  <Style x:Key="TableGroupCell" TargetType="DataGridCell" BasedOn="{StaticResource TableCell}">
    <Setter Property="BorderBrush" Value="{StaticResource TableGroupRuleBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
  </Style>
  <Style x:Key="CatalogGridBase" TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="CanUserResizeColumns" Value="True"/>
    <Setter Property="CanUserReorderColumns" Value="True"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="GridLinesVisibility" Value="All"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TableRuleBrush}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource TableRuleBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource TableAlternateBrush}"/>
    <Setter Property="RowBackground" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource TableRuleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="RowHeight" Value="54"/>
    <Setter Property="ColumnHeaderHeight" Value="40"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="EnableColumnVirtualization" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource TableColumnHeader}"/>
    <Setter Property="CellStyle" Value="{StaticResource TableCell}"/>
  </Style>
  <Style x:Key="CatalogGrid" TargetType="DataGrid" BasedOn="{StaticResource CatalogGridBase}"/>
  <!-- A tabbed table page: the tabs are the page header, without a frame, and the page places the
       active tab's actions at the right of the same line, so the table starts one row higher. -->
  <Style x:Key="PageTabs" TargetType="TabControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"
                              KeyboardNavigation.TabIndex="2"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" Margin="0,0,10,8" Background="#F4F6F9"
                  BorderBrush="{StaticResource TableRuleBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TabBorder" Property="Background" Value="#EAF0F8"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SelectedTabBrush}"/>
              <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3975C6"/>
              <Setter TargetName="TabBorder" Property="TextElement.Foreground" Value="{StaticResource SelectedTabTextBrush}"/>
              <Setter TargetName="TabBorder" Property="TextElement.FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
