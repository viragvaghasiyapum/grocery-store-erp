<Page
    x:Class="GroceryErp.App.Presentation.AssetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Assets_Title}">
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Assets_Title}"/>
    <WrapPanel Grid.Row="1" Margin="0,16,0,12" ItemHeight="68">
      <StackPanel Width="174" Margin="0,0,8,4"><TextBlock Text="{l:Tr Catalog_Name}"/><TextBox x:Name="AssetName"/></StackPanel>
      <StackPanel Width="132" Margin="0,0,8,4"><TextBlock Text="{l:Tr Catalog_Category}"/><ComboBox x:Name="AssetCategory" SelectedIndex="0" SelectionChanged="AssetCategory_OnSelectionChanged"><ComboBoxItem Tag="Furniture" Content="{l:Tr Assets_Furniture}"/><ComboBoxItem Tag="Equipment" Content="{l:Tr Assets_Equipment}"/><ComboBoxItem Tag="Electronics" Content="{l:Tr Assets_Electronics}"/><ComboBoxItem Tag="Vehicle" Content="{l:Tr Assets_Vehicle}"/><ComboBoxItem Tag="Other" Content="{l:Tr Assets_Other}"/></ComboBox></StackPanel>
      <StackPanel Width="130" Margin="0,0,8,4"><TextBlock Text="{l:Tr Assets_PurchaseDate}"/><DatePicker x:Name="PurchaseDate" SelectedDateFormat="Short"/></StackPanel>
      <StackPanel Width="130" Margin="0,0,8,4"><TextBlock Text="{l:Tr Assets_InUseDate}"/><DatePicker x:Name="InUseDate" SelectedDateFormat="Short"/></StackPanel>
      <StackPanel Width="104" Margin="0,0,8,4"><TextBlock Text="{l:Tr Assets_Cost}"/><TextBox x:Name="AssetCost"/></StackPanel>
      <StackPanel Width="84" Margin="0,0,8,4"><TextBlock Text="{l:Tr Assets_Method}"/><ComboBox x:Name="AssetMethod" SelectedIndex="0"><ComboBoxItem Tag="WDV" Content="WDV"/><ComboBoxItem Tag="SLM" Content="SLM"/></ComboBox></StackPanel>
      <StackPanel Width="82" Margin="0,0,8,4"><TextBlock Text="{l:Tr Assets_Rate}"/><TextBox x:Name="AssetRate" Text="15"/></StackPanel>
      <StackPanel Width="110" Margin="0,0,8,4"><TextBlock Text="{l:Tr Assets_Salvage}"/><TextBox x:Name="AssetSalvage" Text="0"/></StackPanel>
      <StackPanel Width="150" Margin="0,0,8,4"><TextBlock Text="{l:Tr Purchasing_Vendor}"/><ComboBox x:Name="AssetVendor" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
      <StackPanel Width="168" Margin="0,0,8,4"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="AssetNotes"/></StackPanel>
      <Button x:Name="SaveAssetButton" Margin="0,17,8,4" Click="AddAsset_OnClick" Content="{l:Tr Common_Save}"/>
      <Button Margin="0,17,0,4" Click="NewAsset_OnClick" Content="{l:Tr Assets_New}"/>
    </WrapPanel>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
      <DataGrid x:Name="AssetGrid" Style="{StaticResource CatalogGrid}" SelectionChanged="AssetGrid_OnSelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}"/>
          <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Category}" Binding="{Binding Category}"/>
          <DataGridTextColumn Width="125" Header="{l:Tr Assets_Cost}" Binding="{Binding Cost}"/>
          <DataGridTextColumn Width="90" Header="{l:Tr Assets_Method}" Binding="{Binding Method}"/>
          <DataGridTextColumn Width="90" Header="{l:Tr Assets_Rate}" Binding="{Binding Rate}"/>
          <DataGridTextColumn Width="140" Header="{l:Tr Assets_BookValue}" Binding="{Binding BookValue}"/>
          <DataGridTextColumn Width="140" Header="{l:Tr Assets_Disposed}" Binding="{Binding DisposedDate}"/>
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid x:Name="ScheduleGrid" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CatalogGrid}">
        <DataGrid.Columns><DataGridTextColumn Width="180" Header="{l:Tr Assets_Period}" Binding="{Binding Period}"/><DataGridTextColumn Width="180" Header="{l:Tr Assets_Opening}" Binding="{Binding OpeningValue}"/><DataGridTextColumn Width="180" Header="{l:Tr Assets_Depreciation}" Binding="{Binding Amount}"/><DataGridTextColumn Width="180" Header="{l:Tr Assets_Closing}" Binding="{Binding ClosingValue}"/></DataGrid.Columns>
      </DataGrid>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <DatePicker x:Name="DisposalDate" Width="135" SelectedDateFormat="Short"/>
        <TextBox x:Name="DisposalValue" Width="110" Margin="8,0" Text="0" ToolTip="{l:Tr Assets_Proceeds}"/>
        <Button Margin="0,0,8,0" Click="Dispose_OnClick" Content="{l:Tr Assets_Dispose}"/>
        <Button Margin="0,0,8,0" Click="Post_OnClick" Content="{l:Tr Assets_PostNow}"/>
        <Button Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Page>
