<Page
    x:Class="GroceryErp.App.Presentation.AssetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Assets_Title}" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European"
    ScrollViewer.CanContentScroll="False">
  <Grid Margin="14,8,14,8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource ToolbarButton}" Click="Post_OnClick" Content="{l:Tr Assets_PostNow}" ToolTip="{l:Tr Assets_PostAllHint}"/>
        <Button x:Name="DisposeButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="Dispose_OnClick" Content="{l:Tr Assets_Dispose}"/>
        <Button x:Name="EditAssetButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="EditAsset_OnClick" Content="{l:Tr Assets_EditSelected}"/>
        <Button Style="{StaticResource ToolbarButton}" Margin="0" Click="NewAsset_OnClick" Content="{l:Tr Assets_New}" FontWeight="SemiBold" ToolTip="Ctrl+N"/>
      </StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Assets_Title}"/>
    </DockPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,2">
      <ui:TextBox x:Name="AssetSearchBox" Width="260" Margin="0,0,6,4" PlaceholderText="{l:Tr Assets_SearchHint}"
                  TextChanged="Search_OnTextChanged" AutomationProperties.Name="{l:Tr Assets_Search}" ToolTip="Ctrl+F"/>
      <CheckBox x:Name="IncludeDisposedBox" IsChecked="True" VerticalAlignment="Center" Margin="4,0,12,4" Click="IncludeDisposed_OnClick" Content="{l:Tr Assets_IncludeDisposed}"/>
      <Button Style="{StaticResource ToolbarButton}" Margin="0,0,0,4" Click="ClearAssetFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <DataGrid x:Name="AssetGrid" Style="{StaticResource CompactTableGrid}" SelectionChanged="AssetGrid_OnSelectionChanged"
                MouseDoubleClick="AssetGrid_OnDoubleClick" AutomationProperties.Name="{l:Tr Assets_Title}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="125" Header="{l:Tr Assets_ViewTimeline}">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <Button Content="{l:Tr Assets_ViewTimeline}" Tag="{Binding}" Click="ViewTimeline_OnClick"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Height="28" MinHeight="0" MinWidth="0"
                      Padding="8,2" FontSize="11"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="2*" MinWidth="160" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}"/>
          <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Category}" Binding="{Binding Category}"/>
          <DataGridTextColumn Width="125" Header="{l:Tr Assets_Cost}" Binding="{Binding Cost}"/>
          <DataGridTextColumn Width="80" Header="{l:Tr Assets_Method}" Binding="{Binding Method}"/>
          <DataGridTextColumn Width="80" Header="{l:Tr Assets_Rate}" Binding="{Binding Rate}"/>
          <DataGridTextColumn Width="130" Header="{l:Tr Assets_BookValue}" Binding="{Binding BookValue}"/>
          <DataGridTextColumn Width="120" Header="{l:Tr Assets_Disposed}" Binding="{Binding DisposedDate, StringFormat=dd MMM yyyy}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{l:Tr Assets_Empty}"/>
    </Grid>
    <p:PagerBar x:Name="Pager" Grid.Row="3"/>
    <Grid x:Name="TimelineOverlay" Grid.RowSpan="4" Panel.ZIndex="10" Visibility="Collapsed">
      <Border x:Name="TimelineBackdrop" Background="#88000000" MouseDown="TimelineBackdrop_OnMouseDown"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="TimelinePanel" Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="18">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="TimelineHeading" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <Button Grid.Column="1" Margin="12,0,0,0" Click="CloseTimeline_OnClick" Content="{l:Tr Common_Close}"/>
            </Grid>
            <Expander Grid.Row="1" Margin="0,10,0,0" Header="{l:Tr Assets_TermHistory}">
              <ItemsControl x:Name="TermsList" MaxHeight="150" Margin="0,4,0,0"/>
            </Expander>
            <DataGrid x:Name="ScheduleGrid" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CatalogGrid}">
              <DataGrid.Columns><DataGridTextColumn Width="120" Header="{l:Tr Assets_Period}" Binding="{Binding Period}"/><DataGridTextColumn Width="150" Header="{l:Tr Assets_Opening}" Binding="{Binding OpeningValue}"/><DataGridTextColumn Width="150" Header="{l:Tr Assets_Depreciation}" Binding="{Binding Amount}"/><DataGridTextColumn Width="150" Header="{l:Tr Assets_Closing}" Binding="{Binding ClosingValue}"/><DataGridTextColumn Width="130" Header="{l:Tr Assets_ChargedOn}" Binding="{Binding ChargedOn}"/></DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="TimelinePageText" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="PreviousTimelineButton" Click="PreviousTimeline_OnClick" Content="{l:Tr Sales_Previous}"/>
              <Button x:Name="NextTimelineButton" Margin="6,0,0,0" Click="NextTimeline_OnClick" Content="{l:Tr Sales_Next}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Page>
