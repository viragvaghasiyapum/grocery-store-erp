<Window x:Class="GroceryErp.App.Presentation.DirectLotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        xmlns:p="clr-namespace:GroceryErp.App.Presentation"
        Title="{l:Tr Stock_AddDirectLot}" Width="560" Height="640" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
        NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="direct-lot">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr Stock_AddDirectLot}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Stock_DirectLotContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <UniformGrid x:Name="Fields" Columns="2" Margin="0,0,8,0" VerticalAlignment="Top">
        <p:FormField x:Name="QuantityField" Label="{l:Tr Stock_Quantity}" IsRequired="True"><TextBox x:Name="QuantityBox"/></p:FormField>
        <p:FormField x:Name="CostField" Label="{l:Tr Stock_UnitCost}" IsRequired="True" Hint="{l:Tr Stock_PurchasePriceHint}"><TextBox x:Name="CostBox"/></p:FormField>
        <p:FormField x:Name="TaxField" Label="{l:Tr Catalog_TaxRate}" IsRequired="True"><ComboBox x:Name="TaxBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></p:FormField>
        <!-- Worked out from the purchase price and tax rate; Purchase price + Tax/unit = incl. tax. -->
        <p:FormField x:Name="UnitTaxField" Label="{l:Tr Stock_UnitTax}"><TextBox x:Name="UnitTaxBox" IsReadOnly="True" IsTabStop="False"/></p:FormField>
        <p:FormField x:Name="InclTaxField" Label="{l:Tr Stock_CostInclTax}"><TextBox x:Name="InclTaxBox" IsReadOnly="True" IsTabStop="False"/></p:FormField>
        <p:FormField x:Name="PriceField" Label="{l:Tr Catalog_Price}" IsRequired="True"><TextBox x:Name="PriceBox"/></p:FormField>
        <p:FormField x:Name="MrpField" Label="{l:Tr Stock_Mrp}"><TextBox x:Name="MrpBox"/></p:FormField>
        <p:FormField x:Name="BatchField" Label="{l:Tr Stock_Batch}"><TextBox x:Name="BatchBox" MaxLength="40"/></p:FormField>
        <p:FormField x:Name="ExpiryField" Label="{l:Tr Stock_Expiry}"><DatePicker x:Name="ExpiryBox" SelectedDateFormat="Short"/></p:FormField>
        <p:FormField x:Name="DateField" Label="{l:Tr Purchasing_Received}" IsRequired="True"><DatePicker x:Name="DateBox" SelectedDateFormat="Short"/></p:FormField>
        <p:FormField x:Name="ReasonField" Label="{l:Tr Stock_DirectReason}" IsRequired="True"><TextBox x:Name="ReasonBox" MaxLength="500"/></p:FormField>
      </UniformGrid>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveButton" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Common_Save}"/>
    </StackPanel>
  </Grid>
</Window>
