<Window x:Class="GroceryErp.App.Presentation.DirectLotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Stock_AddDirectLot}" Width="530" Height="510" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{l:Tr Stock_AddDirectLot}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,8,10"><TextBlock Text="{l:Tr Stock_Quantity}"/><TextBox x:Name="QuantityBox"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Stock_UnitCost}"/><TextBox x:Name="CostBox"/></StackPanel>
      <StackPanel Grid.Row="1" Margin="0,0,8,10"><TextBlock Text="{l:Tr Catalog_Price}"/><TextBox x:Name="PriceBox"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Stock_Mrp}"/><TextBox x:Name="MrpBox"/></StackPanel>
      <StackPanel Grid.Row="2" Margin="0,0,8,10"><TextBlock Text="{l:Tr Stock_Batch}"/><TextBox x:Name="BatchBox"/></StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Stock_Expiry}"/><DatePicker x:Name="ExpiryBox"/></StackPanel>
      <StackPanel Grid.Row="3" Margin="0,0,8,10"><TextBlock Text="{l:Tr Purchasing_Received}"/><DatePicker x:Name="DateBox"/></StackPanel>
      <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Stock_DirectReason}"/><TextBox x:Name="ReasonBox" MaxLength="500"/></StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="Crimson" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="SaveButton" Content="{l:Tr Common_Save}" Click="Save_OnClick" Margin="0,0,8,0"/>
      <Button Content="{l:Tr Common_Cancel}" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
