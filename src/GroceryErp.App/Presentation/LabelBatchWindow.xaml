<Window x:Class="GroceryErp.App.Presentation.LabelBatchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr Catalog_PrintLabels}" Width="1080" Height="720" MinWidth="880" MinHeight="590"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="label-batch">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
      <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Catalog_PrintLabels}"/>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,16,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{l:Tr Catalog_LabelTemplate}"/>
        <ComboBox AutomationProperties.Name="{l:Tr Catalog_LabelTemplate}" x:Name="TemplateBox" DisplayMemberPath="Name" SelectionChanged="Template_OnChanged"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="{l:Tr Catalog_PrinterName}"/>
        <TextBox AutomationProperties.Name="{l:Tr Catalog_PrinterName}" x:Name="PrinterBox"/>
        <ComboBox x:Name="PrinterModeBox" SelectedIndex="0" Margin="0,6,0,0" AutomationProperties.Name="{l:Tr Catalog_PrinterMode}">
          <ComboBoxItem Tag="TSPL" Content="{l:Tr Catalog_PrinterModeTspl}"/>
          <ComboBoxItem Tag="DRIVER" Content="{l:Tr Catalog_PrinterModeDriver}"/>
        </ComboBox>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="LabelsGrid" Style="{StaticResource CatalogGrid}" IsReadOnly="False" RowHeight="64" RowDetailsVisibilityMode="Visible"
                SelectionChanged="LabelsGrid_OnSelectionChanged" CurrentCellChanged="LabelsGrid_OnCurrentCellChanged">
        <DataGrid.RowDetailsTemplate>
          <DataTemplate>
            <Grid Margin="18,0,0,6" Visibility="{Binding ExpandedLotsVisibility}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Background="#EDF1F6" Height="28">
                <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="8,6" Text="{l:Tr Catalog_Select}"/>
                <TextBlock Grid.Column="1" Margin="8,6" Text="{l:Tr Catalog_LabelSource}"/>
                <TextBlock Grid.Column="2" Margin="8,6" Text="{l:Tr Catalog_Price}"/>
                <TextBlock Grid.Column="3" Margin="8,6" Text="{l:Tr Catalog_Copies}"/>
              </Grid>
              <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="38" Background="White" MouseLeftButtonDown="LotRow_OnMouseDown">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Click="LotCheck_OnClick"/>
                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="{Binding Source}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Text="{Binding Price}"/>
                        <TextBox Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center" Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DataTemplate>
        </DataGrid.RowDetailsTemplate>
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="55" Header="{l:Tr Catalog_Select}"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPrintable}" Click="ProductLabelCheck_OnClick"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Width="210" Header="{l:Tr Catalog_Name}">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <Button HorizontalAlignment="Left" Margin="0,3,0,0" Padding="0" MinHeight="18"
                      BorderThickness="0" Background="Transparent" FontSize="11" FontWeight="Normal"
                      Visibility="{Binding LotsVisibility}" Click="ToggleLots_OnClick">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{l:Tr Stock_Lots}"/><TextBlock Margin="4,0,0,0" Text="{Binding LotsArrow}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
          <DataGridTextColumn Width="145" IsReadOnly="True" Header="{l:Tr Catalog_LabelSource}" Binding="{Binding Source}"/>
          <DataGridTextColumn Width="90" IsReadOnly="True" Header="{l:Tr Catalog_Price}" Binding="{Binding Price}"/>
          <DataGridTextColumn Width="75" Header="{l:Tr Catalog_Copies}" Binding="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}"/>
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Column="1" Margin="18,0,0,0">
        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{l:Tr Catalog_LabelPreview}"/>
        <Border Height="270" BorderBrush="#777" BorderThickness="1" Background="White" Padding="16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="PreviewName" FontSize="20" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"/>
            <TextBlock x:Name="PreviewLocal" Grid.Row="1" FontSize="16" Foreground="#333" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
              <Image x:Name="PreviewBarcode" Height="56" Margin="10,0" Stretch="Fill"/>
              <TextBlock x:Name="PreviewBarcodeText" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="Black"/>
            </StackPanel>
            <Grid Grid.Row="3">
              <TextBlock x:Name="PreviewPrice" FontSize="26" FontWeight="Bold" Foreground="Black"/>
              <TextBlock x:Name="PreviewMrp" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#333"/>
            </Grid>
          </Grid>
        </Border>
        <TextBlock Margin="0,10,0,0" Opacity="0.7" Text="{l:Tr Catalog_LabelSelectionHint}" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Margin="0,0,340,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="Crimson"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" Margin="0,0,8,0">
          <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Common_RowsPerPage}"/>
          <Menu VerticalAlignment="Center" Margin="0,0,8,0">
            <MenuItem x:Name="PageSizeMenu" Header="50 ▾" ToolTip="{l:Tr Common_RowsPerPage}">
              <MenuItem Tag="20" Header="20" Click="PageSize_OnClick"/>
              <MenuItem Tag="30" Header="30" Click="PageSize_OnClick"/>
              <MenuItem Tag="50" Header="50" Click="PageSize_OnClick"/>
              <MenuItem Tag="100" Header="100" Click="PageSize_OnClick"/>
            </MenuItem>
          </Menu>
          <Button x:Name="PreviousLotsButton" Margin="0,0,6,0" IsEnabled="False" Click="PreviousLots_OnClick" Content="{l:Tr Sales_Previous}"/>
          <Button x:Name="NextLotsButton" Margin="0,0,8,0" IsEnabled="False" Click="NextLots_OnClick" Content="{l:Tr Sales_Next}"/>
        </StackPanel>
        <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Close}"/>
        <Button x:Name="SaveButton" Margin="0,0,8,0" Click="Save_OnClick" Content="{l:Tr Catalog_SavePrintFile}"/>
        <Button x:Name="PrintButton" Click="Print_OnClick" Content="{l:Tr Catalog_Print}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
