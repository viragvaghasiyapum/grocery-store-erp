<Window x:Class="GroceryErp.App.Presentation.InternalUseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        xmlns:p="clr-namespace:GroceryErp.App.Presentation"
        Title="{l:Tr Stock_ConsumeInternal}" Width="460" Height="380" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
        NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="internal-use">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr Stock_ConsumeInternal}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Stock_InternalUseContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <StackPanel x:Name="Fields" Grid.Row="2" Margin="0,8,0,0">
      <p:FormField x:Name="QuantityField" Label="{l:Tr Stock_Quantity}" IsRequired="True"><TextBox x:Name="QuantityBox"/></p:FormField>
      <p:FormField x:Name="ReasonField" Label="{l:Tr Stock_DirectReason}" IsRequired="True"><TextBox x:Name="ReasonBox" MaxLength="500"/></p:FormField>
    </StackPanel>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveButton" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Common_Save}"/>
    </StackPanel>
  </Grid>
</Window>
