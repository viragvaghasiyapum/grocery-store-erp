<ui:FluentWindow x:Class="GroceryErp.App.Presentation.RestoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Settings_RestoreTitle}" Width="660" Height="580" MinWidth="600" MinHeight="540"
    WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN"
    NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="restore">
  <DockPanel>
    <ui:TitleBar DockPanel.Dock="Top" Title="{l:Tr Settings_RestoreTitle}"/>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
      <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
      <TextBlock FontSize="26" FontWeight="SemiBold" Text="{l:Tr Settings_RestoreTitle}"/>
    </DockPanel>
    <TextBlock Grid.Row="1" Margin="0,8,0,20" Text="{l:Tr Settings_RestoreWarning}" TextWrapping="Wrap"/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock FontWeight="SemiBold" FontSize="18" Text="{l:Tr Settings_CurrentData}"/><TextBlock x:Name="CurrentSummary" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="27"/></StackPanel></ScrollViewer>
      </Border>
      <Border Grid.Column="2" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock FontWeight="SemiBold" FontSize="18" Text="{l:Tr Settings_BackupData}"/><TextBlock x:Name="BackupSummary" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="27"/></StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock Text="{l:Tr Settings_TypeRestore}"/><TextBox AutomationProperties.Name="{l:Tr Settings_TypeRestore}" x:Name="Confirmation" Margin="0,6,0,0" TextChanged="Confirmation_OnTextChanged"/></StackPanel>
    <StackPanel Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Margin="0,0,8,0" Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="RestoreButton" IsEnabled="False" Click="Restore_OnClick" Content="{l:Tr Settings_RestoreAction}"/>
    </StackPanel>
  </Grid>
  </DockPanel>
</ui:FluentWindow>
