<Window x:Class="GroceryErp.App.Presentation.ProductStockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Stock_Title}" Width="900" Height="620" MinWidth="720" MinHeight="460"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock x:Name="ProductNameText" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="SkuText" Margin="0,4,0,0" Opacity="0.7"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <Button x:Name="PrintLotButton" IsEnabled="False" Margin="0,0,8,8" Click="PrintLot_OnClick" Content="{l:Tr Catalog_PrintLabels}"/>
      <Button x:Name="CorrectLotButton" IsEnabled="False" Margin="0,0,8,8" Click="CorrectLot_OnClick" Content="{l:Tr Stock_CorrectLot}"/>
      <Button x:Name="WriteOffButton" IsEnabled="False" Margin="0,0,8,8" Click="WriteOff_OnClick" Content="{l:Tr Stock_WriteOffExpired}"/>
      <Button x:Name="OpenSourceButton" IsEnabled="False" Margin="0,0,0,8" Click="OpenSource_OnClick" Content="{l:Tr Stock_OpenSource}"/>
    </WrapPanel>
    <TabControl x:Name="StockTabs" Grid.Row="2">
      <TabItem Header="{l:Tr Stock_Lots}">
        <DataGrid x:Name="LotsGrid" Style="{StaticResource CatalogGrid}" SelectionChanged="LotsGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="120" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchNumber}"/>
            <DataGridTextColumn Width="115" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate, StringFormat=dd MMM yyyy}"/>
            <DataGridTextColumn Width="95" Header="{l:Tr Stock_ExpiryStatus}" Binding="{Binding ExpiryBucketCode,Converter={StaticResource ExpiryBucketConverter}}" ElementStyle="{StaticResource ExpiryBucketStyle}"/>
            <DataGridTextColumn Width="95" Header="{l:Tr Stock_OnHand}" Binding="{Binding OnHand}"/>
            <DataGridTextColumn Width="95" Header="{l:Tr Catalog_Price}" Binding="{Binding SellingPrice}"/>
            <DataGridTextColumn Width="95" Header="{l:Tr Stock_Mrp}" Binding="{Binding Mrp}"/>
            <DataGridCheckBoxColumn Width="70" Header="{l:Tr Catalog_Active}" Binding="{Binding IsActive}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Stock_Ledger}">
        <DataGrid x:Name="LedgerGrid" Style="{StaticResource CatalogGrid}" SelectionChanged="LedgerGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="105" Header="{l:Tr Stock_MoveDate}" Binding="{Binding MoveDate, StringFormat=dd MMM yyyy}"/>
            <DataGridTextColumn Width="115" Header="{l:Tr Stock_MovementType}" Binding="{Binding Type}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
            <DataGridTextColumn Width="95" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
            <DataGridTextColumn Width="95" Header="{l:Tr Stock_OnHand}" Binding="{Binding LotBalance}"/>
            <DataGridTextColumn Width="*" MinWidth="180" Header="{l:Tr Purchasing_Notes}" Binding="{Binding Note}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_Source}" Binding="{Binding RefType}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Common_RowsPerPage}"/>
        <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="65" Margin="0,0,8,0" SelectedIndex="2" SelectionChanged="PageSize_OnChanged"><ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox>
        <Button x:Name="PreviousLotButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousLot_OnClick" Content="{l:Tr Sales_Previous}"/>
        <Button x:Name="NextLotButton" IsEnabled="False" Margin="0,0,8,0" Click="NextLot_OnClick" Content="{l:Tr Sales_Next}"/>
        <Button x:Name="PreviousLedgerButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousLedger_OnClick" Content="{l:Tr Sales_Previous}"/>
        <Button x:Name="NextLedgerButton" IsEnabled="False" Margin="0,0,8,0" Click="NextLedger_OnClick" Content="{l:Tr Sales_Next}"/>
        <Button IsCancel="True" Content="{l:Tr Common_Close}"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
