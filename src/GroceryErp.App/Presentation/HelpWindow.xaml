<Window x:Class="GroceryErp.App.Presentation.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Width="760" MinWidth="480" MinHeight="320" SizeToContent="Height" ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="TitleText" Style="{StaticResource FormTitle}"/>
      <TextBlock x:Name="SummaryText" Style="{StaticResource FormContext}"/>
    </StackPanel>
    <!-- Focused first, so the arrow and page keys scroll the help; Enter or Esc still closes it. -->
    <ScrollViewer x:Name="Scroll" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
      <StackPanel x:Name="Body" Margin="0,0,10,0"/>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" MinWidth="96" IsDefault="True" IsCancel="True"
              Click="Close_OnClick" Content="{l:Tr Common_Close}"/>
      <TextBlock Style="{StaticResource StatusText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,12,0"
                 Text="{l:Tr Help_FieldHint}"/>
    </DockPanel>
  </Grid>
</Window>
