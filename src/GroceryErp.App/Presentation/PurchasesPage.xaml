<Page
    x:Class="GroceryErp.App.Presentation.PurchasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Purchasing_Title}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Purchasing_Title}" />
    <WrapPanel Grid.Row="1" Margin="0,16,0,4">
      <Button Margin="0,0,8,8" Click="NewPurchase_OnClick" Content="{l:Tr Purchasing_NewPurchase}" />
      <Button Margin="0,0,8,8" Click="NewVendor_OnClick" Content="{l:Tr Purchasing_NewVendor}" />
      <Button x:Name="PaymentButton" Margin="0,0,8,8" Click="Payment_OnClick" Content="{l:Tr Purchasing_Payment}" />
      <Button x:Name="OpenDraftButton" IsEnabled="False" Margin="0,0,8,8" Click="OpenDraft_OnClick" Content="{l:Tr Purchasing_EditDraft}" />
      <Button x:Name="EditVendorButton" IsEnabled="False" Margin="0,0,8,8" Click="EditVendor_OnClick" Content="{l:Tr Purchasing_EditVendor}" />
      <Button x:Name="VendorLedgerButton" IsEnabled="False" Margin="0,0,8,8" Click="VendorLedger_OnClick" Content="{l:Tr Purchasing_VendorLedger}" />
      <Button x:Name="CancelPurchaseButton" IsEnabled="False" Margin="0,0,8,8" Click="CancelPurchase_OnClick" Content="{l:Tr Purchasing_CancelPurchase}" />
      <Button x:Name="VendorReturnButton" IsEnabled="False" Margin="0,0,8,8" Click="VendorReturn_OnClick" Content="{l:Tr Purchasing_VendorReturn}" />
      <Button Margin="0,0,8,8" Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}" />
      <DatePicker x:Name="PurchaseFromBox" Width="130" Margin="0,0,8,8" ToolTip="{l:Tr Reports_From}"/>
      <DatePicker x:Name="PurchaseToBox" Width="130" Margin="0,0,8,8" ToolTip="{l:Tr Reports_To}"/>
      <ComboBox x:Name="PurchaseVendorFilter" Width="170" Margin="0,0,8,8"
                DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="{l:Tr Purchasing_Vendor}"/>
      <Button Margin="0,0,8,8" Click="FilterPurchases_OnClick" Content="{l:Tr Purchasing_Filter}"/>
      <Button Margin="0,0,8,8" Click="ClearPurchaseFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
    </WrapPanel>
    <TabControl Grid.Row="2" Margin="0,8,0,0">
      <TabItem Header="{l:Tr Purchasing_Purchases}">
        <DataGrid x:Name="PurchasesGrid" Style="{StaticResource CatalogGrid}" SelectionChanged="PurchasesGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Grn}" Binding="{Binding DocumentNumber}" />
            <DataGridTextColumn Width="250" Header="{l:Tr Purchasing_Vendor}" Binding="{Binding VendorName}" />
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Invoice}" Binding="{Binding VendorInvoiceNumber}" />
            <DataGridTextColumn Width="110" Header="{l:Tr Purchasing_Received}" Binding="{Binding ReceivedDate}" />
            <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_Status}" Binding="{Binding Status}" />
            <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Total}" Binding="{Binding GrandTotal}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_Vendors}">
        <DataGrid x:Name="VendorsGrid" Style="{StaticResource CatalogGrid}" SelectionChanged="VendorsGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="280" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}" />
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Phone}" Binding="{Binding Phone}" />
            <DataGridTextColumn Width="180" Header="GSTIN" Binding="{Binding Gstin}" />
            <DataGridTextColumn Width="140" Header="{l:Tr Purchasing_Balance}" Binding="{Binding BalanceDue}" />
            <DataGridCheckBoxColumn Width="90" Header="{l:Tr Catalog_Active}" Binding="{Binding IsActive}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="PreviousPurchaseButton" IsEnabled="False" Margin="8,0" Click="PreviousPurchase_OnClick" Content="{l:Tr Sales_Previous}"/>
        <Button x:Name="NextPurchaseButton" IsEnabled="False" Click="NextPurchase_OnClick" Content="{l:Tr Sales_Next}"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </Grid>
</Page>
