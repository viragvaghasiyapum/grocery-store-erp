<Page x:Class="GroceryErp.App.Presentation.PurchasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Purchasing_Title}" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European"
    ScrollViewer.CanContentScroll="False" p:ScreenHelp.Topic="purchases">
  <Grid x:Name="Layout" Margin="14,8,14,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel x:Name="TitleRow" Margin="0,0,0,6">
      <!-- Most important first: when the row is narrow the last actions fold behind More. -->
      <StackPanel x:Name="TitleActions" DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource ToolbarButton}" Click="NewPurchase_OnClick" Content="{l:Tr Purchasing_NewPurchase}" FontWeight="SemiBold"
                ToolTip="Ctrl+N"/>
        <Button x:Name="OpenButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="Open_OnClick" Content="{l:Tr Purchasing_Open}"/>
        <Button x:Name="VendorReturnButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="VendorReturn_OnClick" Content="{l:Tr Purchasing_VendorReturn}"/>
        <Button x:Name="CancelPurchaseButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="CancelPurchase_OnClick" Content="{l:Tr Purchasing_CancelPurchase}"/>
        <Button x:Name="ReturnHistoryButton" Style="{StaticResource ToolbarButton}" Margin="0" IsEnabled="False" Click="ReturnHistory_OnClick" Content="{l:Tr Purchasing_ReturnHistory}"/>
        <Menu x:Name="MoreActionsMenu" VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed">
          <MenuItem x:Name="MoreActions" Header="{l:Tr Common_MoreActions}"/>
        </Menu>
      </StackPanel>
      <StackPanel x:Name="TitleHeader" Orientation="Horizontal">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Text="{l:Tr Purchasing_Title}" Margin="0,0,6,0"/>
        <p:HelpButton VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>
    <WrapPanel x:Name="FilterBar" Grid.Row="1" Margin="0,0,0,2">
      <ui:TextBox x:Name="DocumentFilter" Width="190" Margin="0,0,6,4" PlaceholderText="{l:Tr Purchasing_DocumentFilter}"
                  TextChanged="Text_OnChanged" AutomationProperties.Name="{l:Tr Purchasing_DocumentFilter}" ToolTip="Ctrl+F"/>
      <ComboBox x:Name="VendorFilter" Width="190" Margin="0,0,6,4" DisplayMemberPath="Name" SelectedValuePath="Id"
                SelectionChanged="Filter_OnChanged" AutomationProperties.Name="{l:Tr Purchasing_Vendor}"/>
      <ComboBox x:Name="StatusFilter" Width="120" Margin="0,0,6,4" SelectedIndex="0" SelectionChanged="Filter_OnChanged"
                AutomationProperties.Name="{l:Tr Purchasing_Status}">
        <ComboBoxItem Tag="" Content="{l:Tr Purchasing_AnyStatus}"/>
        <ComboBoxItem Tag="DRAFT" Content="{l:Tr Purchasing_StatusDraft}"/>
        <ComboBoxItem Tag="POSTED" Content="{l:Tr Purchasing_StatusPosted}"/>
        <ComboBoxItem Tag="CANCELLED" Content="{l:Tr Purchasing_StatusVoided}"/>
      </ComboBox>
      <TextBlock x:Name="FromLabel" Style="{StaticResource FilterLabel}" Text="{l:Tr Reports_From}"/>
      <DatePicker x:Name="FromBox" SelectedDateFormat="Short" Width="132" Margin="0,0,6,4" SelectedDateChanged="Date_OnChanged" AutomationProperties.Name="{l:Tr Reports_From}"/>
      <TextBlock x:Name="ToLabel" Style="{StaticResource FilterLabel}" Text="{l:Tr Reports_To}"/>
      <DatePicker x:Name="ToBox" SelectedDateFormat="Short" Width="132" Margin="0,0,6,4" SelectedDateChanged="Date_OnChanged" AutomationProperties.Name="{l:Tr Reports_To}"/>
      <ToggleButton x:Name="MoreFiltersToggle" Margin="0,0,6,4" MinHeight="32" Padding="10,4" Click="MoreFilters_OnClick"
                    Content="{l:Tr Common_MoreFilters}"/>
      <Button Style="{StaticResource ToolbarButton}" Margin="0,0,0,4" Click="ClearFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
    </WrapPanel>
    <WrapPanel x:Name="MoreFiltersPanel" Grid.Row="2" Margin="0,0,0,2" Visibility="Collapsed">
      <ComboBox x:Name="TypeFilter" Width="150" Margin="0,0,6,4" SelectedIndex="0" SelectionChanged="Filter_OnChanged"
                AutomationProperties.Name="{l:Tr Purchasing_LineType}">
        <ComboBoxItem Tag="" Content="{l:Tr Purchasing_AnyLineType}"/>
        <ComboBoxItem Tag="PRODUCT" Content="{l:Tr Purchasing_TypeProduct}"/>
        <ComboBoxItem Tag="INTERNAL" Content="{l:Tr Purchasing_TypeInternal}"/>
        <ComboBoxItem Tag="EXPENSE" Content="{l:Tr Purchasing_TypeExpense}"/>
      </ComboBox>
      <ui:TextBox x:Name="ProductFilter" Width="200" Margin="0,0,10,4" PlaceholderText="{l:Tr Purchasing_ProductFilter}"
                  TextChanged="Text_OnChanged" AutomationProperties.Name="{l:Tr Purchasing_ProductFilter}"/>
      <CheckBox x:Name="ReturnableFilter" Margin="0,0,0,4" VerticalAlignment="Center" Click="Check_OnClick" Content="{l:Tr Purchasing_ReturnableOnly}"/>
    </WrapPanel>
    <Grid Grid.Row="3">
      <DataGrid x:Name="PurchasesGrid" Style="{StaticResource CompactTableGrid}" SelectionMode="Single"
                SelectionChanged="PurchasesGrid_OnSelectionChanged" MouseDoubleClick="PurchasesGrid_OnDoubleClick"
                PreviewKeyDown="PurchasesGrid_OnPreviewKeyDown" AutomationProperties.Name="{l:Tr Purchasing_Purchases}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="48" MinWidth="44" CanUserReorder="False">
            <DataGridTemplateColumn.HeaderTemplate><DataTemplate>
              <CheckBox Style="{StaticResource RowCheck}" IsThreeState="True" Loaded="PageCheck_OnLoaded" Click="PageCheck_OnClick"
                        AutomationProperties.Name="{l:Tr Selection_ThisPage}"/>
            </DataTemplate></DataGridTemplateColumn.HeaderTemplate>
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <CheckBox Style="{StaticResource RowCheck}" Loaded="RowCheck_OnLoaded" Click="RowCheck_OnClick"
                        AutomationProperties.Name="{l:Tr Purchasing_SelectPurchase}"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Grn}" Binding="{Binding DocumentNumber}"/>
          <DataGridTextColumn Width="2*" MinWidth="160" Header="{l:Tr Purchasing_Vendor}" Binding="{Binding VendorName}"/>
          <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Invoice}" Binding="{Binding VendorInvoiceNumber}"/>
          <DataGridTextColumn Width="118" Header="{l:Tr Purchasing_Received}" Binding="{Binding ReceivedDate, StringFormat=dd MMM yyyy}"/>
          <DataGridTextColumn Width="95" Header="{l:Tr Purchasing_Status}" Binding="{Binding Status, Converter={StaticResource PurchaseStatusConverter}}"/>
          <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Total}" Binding="{Binding GrandTotal}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" Text="{l:Tr Purchasing_Empty}"/>
    </Grid>
    <p:PagerBar x:Name="Pager" Grid.Row="4">
      <p:PagerBar.Selection>
        <p:SelectionBar x:Name="Selection">
          <p:SelectionBar.Actions>
            <Menu VerticalAlignment="Center" Background="Transparent">
              <MenuItem Header="{l:Tr Catalog_BulkActions}">
                <MenuItem Click="BulkVoid_OnClick" Header="{l:Tr Purchasing_CancelSelected}"/>
              </MenuItem>
            </Menu>
          </p:SelectionBar.Actions>
        </p:SelectionBar>
      </p:PagerBar.Selection>
    </p:PagerBar>
    <!-- An opened purchase shows beside the list, at full width until the operator chooses, and
         follows the selection. A draft is still finished in the purchase form. -->
    <p:DetailPanel x:Name="Invoice" Grid.Column="1" Grid.RowSpan="5" Margin="10,-8,-14,-8" Visibility="Collapsed"
                   CloseRequested="Invoice_OnCloseRequested">
      <p:DetailPanel.Actions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="InvoiceEditButton" Style="{StaticResource ToolbarButton}" Click="Open_OnClick" Content="{l:Tr Purchasing_Open}"/>
          <Button x:Name="InvoiceVendorReturnButton" Style="{StaticResource ToolbarButton}" Click="VendorReturn_OnClick" Content="{l:Tr Purchasing_VendorReturn}"/>
          <Button x:Name="InvoiceCancelButton" Style="{StaticResource ToolbarButton}" Click="CancelPurchase_OnClick" Content="{l:Tr Purchasing_CancelPurchase}"/>
          <Button x:Name="InvoiceReturnHistoryButton" Style="{StaticResource ToolbarButton}" Click="ReturnHistory_OnClick" Content="{l:Tr Purchasing_ReturnHistory}"/>
        </StackPanel>
      </p:DetailPanel.Actions>
      <p:PurchaseInvoiceView x:Name="InvoiceView"/>
    </p:DetailPanel>
  </Grid>
</Page>
