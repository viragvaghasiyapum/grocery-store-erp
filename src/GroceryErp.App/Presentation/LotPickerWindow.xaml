<Window x:Class="GroceryErp.App.Presentation.LotPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
 Title="{l:Tr Sales_ChooseLot}" Width="760" Height="500" MinWidth="650" MinHeight="420"
 WindowStartupLocation="CenterOwner" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="lot-picker">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
    <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{l:Tr Sales_ChooseLot}"/>
  </DockPanel>
  <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,10,0,0" TextChanged="SearchBox_OnChanged" ToolTip="{l:Tr Stock_LotFilterSearch}" AutomationProperties.Name="{l:Tr Stock_LotFilterSearch}"/>
  <DataGrid x:Name="LotsGrid" Grid.Row="2" Margin="0,16,0,16" Style="{StaticResource CatalogGrid}"
            MouseDoubleClick="LotsGrid_OnDoubleClick">
   <DataGrid.Columns>
    <DataGridTextColumn Width="140" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
    <DataGridTextColumn Width="110" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchNumber}"/>
    <DataGridTextColumn Width="105" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate, StringFormat=dd MMM yyyy}"/>
    <DataGridTextColumn Width="90" Header="{l:Tr Stock_OnHand}" Binding="{Binding OnHand}"/>
    <DataGridTextColumn Width="105" Header="{l:Tr Pos_Price}" Binding="{Binding SellingPrice}"/>
    <DataGridTextColumn Width="90" Header="{l:Tr Stock_Mrp}" Binding="{Binding Mrp}"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
   <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="120" Margin="0,0,8,0" SelectedIndex="2" SelectionChanged="PageSize_OnChanged"><ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox>
   <Button x:Name="PreviousButton" IsEnabled="False" Click="Previous_OnClick" Content="{l:Tr Sales_Previous}" Margin="0,0,8,0"/>
   <Button x:Name="NextButton" IsEnabled="False" Click="Next_OnClick" Content="{l:Tr Sales_Next}" Margin="0,0,8,0"/>
   <Button Width="100" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
   <Button Width="120" Margin="8,0,0,0" IsDefault="True" Click="Select_OnClick" Content="{l:Tr Sales_UseLot}"/>
  </StackPanel>
 </Grid>
</Window>
