<Window x:Class="GroceryErp.App.Presentation.RepeatExpensesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr MoneyOut_RepeatLastMonth}" Width="820" Height="560" MinWidth="640" MinHeight="420"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="repeat-expenses">
  <Window.Resources>
    <p:MoneyModeConverter x:Key="MoneyMode"/>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.ColumnSpan="2">
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr MoneyOut_RepeatLastMonth}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr MoneyOut_RepeatContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1" Grid.ColumnSpan="2"/>
    <DockPanel Grid.Row="2" Margin="0,8,0,0">
      <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="Find_OnClick" Content="{l:Tr MoneyOut_FindLastMonth}"/>
      <ListBox x:Name="Categories" SelectionMode="Multiple" AutomationProperties.Name="{l:Tr MoneyOut_RepeatCategories}">
        <ListBox.ItemTemplate><DataTemplate>
          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <DataGrid x:Name="DraftGrid" Grid.Row="2" Grid.Column="1" Margin="12,8,0,0" Style="{StaticResource CatalogGrid}"
              IsReadOnly="False" CanUserAddRows="False" RowHeight="34" AutomationProperties.Name="{l:Tr MoneyOut_Drafts}">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Width="44" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Width="105" Header="{l:Tr Purchasing_Date}" Binding="{Binding DateText}"/>
        <DataGridTextColumn Width="*" MinWidth="120" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryName}" IsReadOnly="True"/>
        <DataGridTextColumn Width="100" Header="{l:Tr MoneyOut_Amount}" Binding="{Binding AmountText}"/>
        <DataGridTextColumn Width="80" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode, Converter={StaticResource MoneyMode}}" IsReadOnly="True"/>
        <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_PaidTo}" Binding="{Binding PaidTo}"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}"/>
      <StackPanel Style="{StaticResource FormFooter}" Margin="0">
        <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Close}"/>
        <Button x:Name="SaveButton" IsEnabled="False" Click="Save_OnClick" Content="{l:Tr MoneyOut_SaveSelected}"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
