<ui:FluentWindow
    x:Class="GroceryErp.App.Presentation.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Login_Title}" Width="440" Height="390" MinWidth="400" MinHeight="380" ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen" FontFamily="{StaticResource AppFont}">
  <DockPanel>
    <ui:TitleBar DockPanel.Dock="Top" Title="{l:Tr Login_Title}"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{l:Tr Login_Title}"/>
    <TextBlock Grid.Row="1" Margin="0,22,0,6" Text="{l:Tr Login_Username}"/>
    <TextBox x:Name="UsernameBox" Grid.Row="2" Height="34" Text="owner"/>
    <TextBlock Grid.Row="3" Margin="0,14,0,6" Text="{l:Tr Login_Password}"/>
    <PasswordBox x:Name="PasswordBox" Grid.Row="4" Height="34" KeyDown="PasswordBox_OnKeyDown"/>
    <StackPanel Grid.Row="5" Margin="0,20,0,0">
      <TextBlock x:Name="ErrorText" Margin="0,0,0,8" Foreground="Crimson" TextWrapping="Wrap"/>
      <Button Height="36" Click="Login_OnClick" Content="{l:Tr Login_Action}"/>
    </StackPanel>
  </Grid>
  </ScrollViewer>
  </DockPanel>
</ui:FluentWindow>
