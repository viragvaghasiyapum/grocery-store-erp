<ui:FluentWindow
    x:Class="GroceryErp.App.Presentation.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Login_Title}" Width="900" Height="500" MinWidth="760" MinHeight="430" ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen" FontFamily="{StaticResource AppFont}" p:ScreenHelp.Topic="login">
  <DockPanel>
    <ui:TitleBar DockPanel.Dock="Top" Title="{l:Tr Login_Title}" Icon="{StaticResource StoreLogoIcon}"/>
    <Grid Background="White" Margin="34,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="280"/>
        <ColumnDefinition Width="2"/>
        <ColumnDefinition Width="*" MinWidth="330"/>
      </Grid.ColumnDefinitions>
      <Image Source="/GroceryErp.App;component/Assets/logo.jpeg" Stretch="Uniform"
             MaxWidth="350" MaxHeight="350" Margin="12,0,28,0" VerticalAlignment="Center"/>
      <Border Grid.Column="1" Width="2" Margin="0,14" Background="#B7C4D5"/>
      <ScrollViewer Grid.Column="2" Margin="28,0,0,0" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
        <StackPanel MaxWidth="340">
          <DockPanel>
            <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Login_Title}"/>
          </DockPanel>
          <TextBlock Margin="0,24,0,6" Text="{l:Tr Login_Username}"/>
          <TextBox AutomationProperties.Name="{l:Tr Login_Username}" x:Name="UsernameBox" Height="36" Text="owner"/>
          <TextBlock Margin="0,18,0,6" Text="{l:Tr Login_Password}"/>
          <PasswordBox AutomationProperties.Name="{l:Tr Login_Password}" x:Name="PasswordBox" Height="36" KeyDown="PasswordBox_OnKeyDown"/>
          <TextBlock x:Name="ErrorText" Margin="0,14,0,0" Foreground="Crimson" TextWrapping="Wrap"/>
          <Button Height="38" Margin="0,18,0,0" Click="Login_OnClick" Content="{l:Tr Login_Action}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</ui:FluentWindow>
