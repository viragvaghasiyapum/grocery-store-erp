<Window x:Class="GroceryErp.App.Presentation.LotPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        xmlns:p="clr-namespace:GroceryErp.App.Presentation"
        Title="{l:Tr Stock_EditDetails}" Width="480" Height="430" MinHeight="380" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
        NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr Stock_EditDetails}"/>
      <TextBlock x:Name="LotText" Style="{StaticResource FormContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Fields" Margin="0,0,8,0">
        <UniformGrid Columns="2">
          <p:FormField x:Name="PriceField" Label="{l:Tr Catalog_Price}" IsRequired="True"><TextBox x:Name="PriceBox"/></p:FormField>
          <p:FormField x:Name="MrpField" Label="{l:Tr Catalog_Mrp}"><TextBox x:Name="MrpBox"/></p:FormField>
          <p:FormField x:Name="ExpiryField" Label="{l:Tr Stock_Expiry}"><DatePicker x:Name="ExpiryBox" SelectedDateFormat="Short"/></p:FormField>
        </UniformGrid>
        <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Stock_CompletedBillPrices}"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveButton" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Common_Save}"/>
    </StackPanel>
  </Grid>
</Window>
