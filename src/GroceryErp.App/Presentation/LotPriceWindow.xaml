<Window x:Class="GroceryErp.App.Presentation.LotPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Stock_EditDetails}" Width="460" Height="360" MinHeight="340" WindowStartupLocation="CenterOwner"
        NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
    <TextBlock x:Name="LotText" FontWeight="SemiBold" Margin="0,0,0,14"/>
    <TextBlock Text="{l:Tr Stock_Expiry}"/><DatePicker x:Name="ExpiryBox" Margin="0,4,0,10"/>
    <TextBlock Text="{l:Tr Catalog_Price}"/><TextBox x:Name="PriceBox" Margin="0,4,0,10"/>
    <TextBlock Text="{l:Tr Catalog_Mrp}"/><TextBox x:Name="MrpBox" Margin="0,4,0,10"/>
    <TextBlock Text="{l:Tr Stock_CompletedBillPrices}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
    <TextBlock x:Name="ErrorText" Foreground="Crimson"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
    <Button Margin="0,0,8,0" Click="Save_OnClick" Content="{l:Tr Common_Save}"/>
    <Button Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/>
  </StackPanel>
  </Grid>
</Window>
