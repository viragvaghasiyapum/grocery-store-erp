<Window x:Class="GroceryErp.App.Presentation.VendorLedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Purchasing_VendorLedger}" Width="900" Height="620" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock x:Name="VendorTitle" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{l:Tr Purchasing_LedgerHint}" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <TabControl x:Name="HistoryTabs" Grid.Row="1" SelectionChanged="HistoryTabs_OnSelectionChanged">
      <TabItem Header="{l:Tr Purchasing_Purchases}">
        <DataGrid x:Name="PurchasesGrid" Style="{StaticResource CatalogGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="140" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
            <DataGridTextColumn Width="230" Header="{l:Tr Purchasing_Document}" Binding="{Binding Reference}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Total}" Binding="{Binding Debit}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Balance}" Binding="{Binding Balance}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_Payments}">
        <DataGrid x:Name="PaymentsGrid" Style="{StaticResource CatalogGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="140" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
            <DataGridTextColumn Width="230" Header="{l:Tr Purchasing_Reference}" Binding="{Binding Reference}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Amount}" Binding="{Binding Credit}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Balance}" Binding="{Binding Balance}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_VendorReturns}">
        <DataGrid x:Name="ReturnsGrid" Style="{StaticResource CatalogGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="140" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
            <DataGridTextColumn Width="230" Header="{l:Tr Purchasing_Document}" Binding="{Binding Reference}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Credit}" Binding="{Binding Credit}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Balance}" Binding="{Binding Balance}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_VendorLedger}">
        <DataGrid x:Name="LedgerGrid" Style="{StaticResource CatalogGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Kind}"/>
            <DataGridTextColumn Width="180" Header="{l:Tr Purchasing_Document}" Binding="{Binding Reference}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Debit}" Binding="{Binding Debit}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Credit}" Binding="{Binding Credit}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Balance}" Binding="{Binding Balance}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_LotsSupplied}">
        <DataGrid x:Name="LotsGrid" Style="{StaticResource CatalogGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="240" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchNumber}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Received}" Binding="{Binding ReceivedDate}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_OnHand}" Binding="{Binding OnHand}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="ErrorText" Foreground="Crimson" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="PreviousPageButton" Margin="0,0,8,0" IsEnabled="False" Click="PreviousPage_OnClick" Content="{l:Tr Sales_Previous}"/>
        <Button x:Name="NextPageButton" Margin="0,0,8,0" IsEnabled="False" Click="NextPage_OnClick" Content="{l:Tr Sales_Next}"/>
        <Button Click="Close_OnClick" Content="{l:Tr Common_Close}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
