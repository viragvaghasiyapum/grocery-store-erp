<Window x:Class="GroceryErp.App.Presentation.SplitPaymentWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
 Title="{l:Tr Sales_PaymentTitle}" Width="510" Height="410" MinWidth="480" MinHeight="390"
 WindowStartupLocation="CenterOwner" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="split-payment">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <DockPanel>
    <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
    <TextBlock x:Name="TotalText" FontSize="28" FontWeight="SemiBold"/>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,22,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock VerticalAlignment="Center" Text="{l:Tr Sales_CashLabel}"/>
   <TextBox AutomationProperties.Name="{l:Tr Sales_CashLabel}" x:Name="CashBox" Grid.Column="1" Height="36" TextChanged="Amounts_OnChanged"/>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock VerticalAlignment="Center" Text="{l:Tr Sales_UpiLabel}"/>
   <TextBox AutomationProperties.Name="{l:Tr Sales_UpiLabel}" x:Name="UpiBox" Grid.Column="1" Height="36" TextChanged="Amounts_OnChanged"/>
   <TextBox x:Name="UpiReferenceBox" Grid.Column="2" Margin="10,0,0,0" Height="36"
            ToolTip="{l:Tr Sales_UpiReference}" AutomationProperties.Name="{l:Tr Sales_UpiReference}"/>
  </Grid>
  <Grid Grid.Row="3" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock VerticalAlignment="Center" Text="{l:Tr Sales_CardLabel}"/>
   <TextBox AutomationProperties.Name="{l:Tr Sales_CardLabel}" x:Name="CardBox" Grid.Column="1" Height="36" TextChanged="Amounts_OnChanged"/>
   <TextBox x:Name="CardReferenceBox" Grid.Column="2" Margin="10,0,0,0" Height="36"
            ToolTip="{l:Tr Sales_CardReference}" AutomationProperties.Name="{l:Tr Sales_CardReference}"/>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,18,0,0">
   <TextBlock x:Name="BalanceText" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="ErrorText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="Firebrick"/>
  </StackPanel>
  <StackPanel Grid.Row="5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal">
   <Button Width="100" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
   <Button Width="120" Margin="8,0,0,0" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Sales_ConfirmPayment}"/>
  </StackPanel>
 </Grid>
</Window>
