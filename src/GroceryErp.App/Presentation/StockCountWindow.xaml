<Window x:Class="GroceryErp.App.Presentation.StockCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Stock_Count}" Width="980" Height="660" MinWidth="780" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{l:Tr Stock_Count}"/>
      <TextBlock Text="{l:Tr Stock_CountHint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
      <TextBlock x:Name="ProgressText" FontWeight="SemiBold"/>
      <TextBlock x:Name="ReviewText" Margin="0,4,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Common_RowsPerPage}"/><ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="65" SelectedIndex="2" SelectionChanged="PageSize_OnChanged"><ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox></StackPanel>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBox x:Name="CountSearchBox" KeyDown="CountSearch_OnKeyDown" ToolTip="{l:Tr Stock_CountSearchHint}"/>
      <Button Grid.Column="1" Margin="8,0,0,0" Click="CountSearch_OnClick" Content="{l:Tr Stock_FindLot}"/>
      <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Stock_CountSearchHint}"/>
    </Grid>
    <DataGrid Style="{StaticResource CatalogGrid}" x:Name="CountGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="40" ColumnHeaderHeight="40"
              CurrentCellChanged="CountGrid_OnCurrentCellChanged" CellEditEnding="CountGrid_OnCellEditEnding">
      <DataGrid.Columns>
        <DataGridTextColumn Width="240" IsReadOnly="True" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="120" IsReadOnly="True" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
        <DataGridTextColumn Width="110" IsReadOnly="True" Header="{l:Tr Stock_Expected}" Binding="{Binding Expected}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Stock_Counted}" Binding="{Binding Counted}"/>
        <DataGridTextColumn Width="110" IsReadOnly="True" Header="{l:Tr Stock_SinceSnapshot}" Binding="{Binding Movement}"/>
        <DataGridTextColumn Width="110" IsReadOnly="True" Header="{l:Tr Stock_Difference}" Binding="{Binding Difference}"/>
        <DataGridTextColumn Width="120" IsReadOnly="True" Header="{l:Tr Stock_DifferenceValue}" Binding="{Binding DifferenceValue}"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="ErrorText" Foreground="Crimson" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="PreviousButton" Margin="0,0,8,0" Click="Previous_OnClick" Content="{l:Tr Sales_Previous}"/><Button x:Name="NextButton" Margin="0,0,8,0" Click="Next_OnClick" Content="{l:Tr Sales_Next}"/><Button Margin="0,0,8,0" Click="Print_OnClick" Content="{l:Tr Stock_PrintCount}"/><Button x:Name="RefreshButton" Margin="0,0,8,0" Click="Refresh_OnClick" Content="{l:Tr Stock_RefreshLots}"/><Button x:Name="SaveButton" Margin="0,0,8,0" Click="Save_OnClick" Content="{l:Tr Stock_SaveCount}"/><Button x:Name="ReviewButton" Margin="0,0,8,0" Click="Review_OnClick" Content="{l:Tr Stock_ReviewCount}"/><Button x:Name="PostButton" IsEnabled="False" Margin="0,0,8,0" Click="Post_OnClick" Content="{l:Tr Purchasing_Post}"/><Button Click="Cancel_OnClick" Content="{l:Tr Stock_DiscardCount}"/></StackPanel></Grid>
  </Grid>
</Window>
