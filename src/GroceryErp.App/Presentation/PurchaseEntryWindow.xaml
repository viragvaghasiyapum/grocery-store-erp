<Window x:Class="GroceryErp.App.Presentation.PurchaseEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Purchasing_NewPurchase}" Width="1240" Height="750" MinWidth="940" MinHeight="610" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{l:Tr Purchasing_NewPurchase}"/>
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Purchasing_EntryHint}"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,8"><TextBlock Text="{l:Tr Purchasing_Vendor}"/><ComboBox x:Name="VendorBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,8,8"><TextBlock Text="{l:Tr Purchasing_Invoice}"/><TextBox x:Name="InvoiceBox"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="8,0,8,8"><TextBlock Text="{l:Tr Purchasing_InvoiceDate}"/><DatePicker x:Name="InvoiceDateBox" SelectedDateFormat="Short"/></StackPanel>
      <StackPanel Grid.Column="3" Margin="8,0,0,8"><TextBlock Text="{l:Tr Purchasing_Received}"/><DatePicker x:Name="ReceivedDateBox" SelectedDateFormat="Short"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,8,0,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBox x:Name="ProductSearchBox" KeyDown="ProductSearchBox_OnKeyDown" ToolTip="{l:Tr Purchasing_ProductSearchHint}"/>
      <Button Grid.Column="1" Margin="8,0,0,0" Click="FindProduct_OnClick" Content="{l:Tr Purchasing_FindProduct}"/>
      <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Purchasing_ProductSearchHint}"/>
    </Grid>
    <DataGrid Style="{StaticResource CatalogGrid}" x:Name="LinesGrid" Grid.Row="3" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="True" IsReadOnly="False"
              Margin="0,8,0,0" GridLinesVisibility="All" HeadersVisibility="Column" RowHeight="38" ColumnHeaderHeight="38"
              CurrentCellChanged="LinesGrid_OnCurrentCellChanged" CellEditEnding="LinesGrid_OnCellEditEnding">
      <DataGrid.Columns>
        <DataGridComboBoxColumn Width="195" Header="{l:Tr Catalog_Name}" SelectedValueBinding="{Binding ProductId}" SelectedValuePath="Id" DisplayMemberPath="Name" x:Name="ProductColumn"/>
        <DataGridTextColumn Width="90" Header="{l:Tr Stock_Batch}" Binding="{Binding Batch}"/>
        <DataGridTextColumn Width="95" Header="{l:Tr Purchasing_MfgDate}" Binding="{Binding ManufacturingDate}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Stock_Expiry}" Binding="{Binding Expiry}"/>
        <DataGridTextColumn Width="70" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
        <DataGridTextColumn Width="70" Header="{l:Tr Purchasing_FreeQty}" Binding="{Binding FreeQuantity}"/>
        <DataGridTextColumn Width="75" Header="{l:Tr Purchasing_Rate}" Binding="{Binding Rate}"/>
        <DataGridTextColumn Width="75" Header="{l:Tr Purchasing_Discount}" Binding="{Binding Discount}"/>
        <DataGridTextColumn Width="65" Header="{l:Tr Purchasing_Gst}" Binding="{Binding TaxRate}"/>
        <DataGridTextColumn Width="75" Header="MRP" Binding="{Binding Mrp}"/>
        <DataGridTextColumn Width="80" Header="{l:Tr Catalog_Price}" Binding="{Binding SellingPrice}"/>
        <DataGridTextColumn Width="105" IsReadOnly="True" Header="{l:Tr Purchasing_Landed}" Binding="{Binding LandedCostText}"/>
        <DataGridTextColumn Width="85" IsReadOnly="True" Header="{l:Tr Purchasing_Margin}" Binding="{Binding MarginText}">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Style.Triggers><DataTrigger Binding="{Binding MarginNegative}" Value="True"><Setter Property="Foreground" Value="Crimson"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="NotesBox"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{l:Tr Purchasing_OtherCharges}"/><TextBox x:Name="ChargesBox" Text="0" TextChanged="TotalsInput_OnTextChanged"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="{l:Tr Purchasing_BillTotal}"/><TextBox x:Name="BillTotalBox" TextChanged="TotalsInput_OnTextChanged"/></StackPanel>
    </Grid>
    <Border Grid.Row="5" Style="{StaticResource CatalogCard}" Margin="0,14,0,0" Padding="14,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{l:Tr Purchasing_Subtotal}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="SubtotalText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="{l:Tr Purchasing_Discount}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DiscountText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{l:Tr Purchasing_TaxTotal}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="TaxText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="{l:Tr Purchasing_RoundOff}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="RoundOffText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="{l:Tr Purchasing_ComputedTotal}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ComputedText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel>
        <StackPanel Grid.Column="5"><TextBlock Text="{l:Tr Purchasing_Difference}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DifferenceText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel>
        <TextBlock x:Name="WarningText" Grid.Row="1" Grid.ColumnSpan="6" Margin="0,8,0,0" Foreground="DarkOrange" TextWrapping="Wrap"/>
      </Grid>
    </Border>
    <Grid Grid.Row="6" Margin="0,14,0,0">
      <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Foreground="Crimson" TextWrapping="Wrap"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="SaveButton" Margin="0,0,8,0" Click="Save_OnClick" Content="{l:Tr Purchasing_SaveDraft}"/><Button x:Name="PostButton" Margin="0,0,8,0" Click="Post_OnClick" Content="{l:Tr Purchasing_Post}"/><Button Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
