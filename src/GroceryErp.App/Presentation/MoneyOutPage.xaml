<Page
    x:Class="GroceryErp.App.Presentation.MoneyOutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr MoneyOut_Title}">
  <Page.Resources>
    <DataTemplate x:Key="ExpiryLotTemplate">
      <Grid Margin="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90"/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/>
          <ColumnDefinition Width="105"/><ColumnDefinition Width="75"/><ColumnDefinition Width="95"/>
          <ColumnDefinition Width="110"/><ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Sku}"/>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding ProductName}"/><TextBlock FontSize="11" Foreground="Gray" Text="{Binding ProductNameLocal}"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding LotCode}"/>
        <TextBlock Grid.Column="3" Text="{Binding ExpiryDate}"/>
        <TextBlock Grid.Column="4" Text="{Binding DaysLeft}"/>
        <TextBlock Grid.Column="5" Text="{Binding Quantity}"/>
        <TextBlock Grid.Column="6" Text="{Binding CostValue}"/>
        <TextBlock Grid.Column="7" Text="{Binding VendorName}"/>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr MoneyOut_Title}" />
    <TabControl Grid.Row="1" Margin="0,18,0,0" SelectionChanged="Tabs_OnSelectionChanged">
      <TabItem Header="{l:Tr MoneyOut_Expiry}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ComboBox x:Name="DamageReason" Width="150" SelectedIndex="0">
              <ComboBoxItem Content="EXPIRED"/><ComboBoxItem Content="BROKEN"/><ComboBoxItem Content="SPOILED"/>
              <ComboBoxItem Content="PEST"/><ComboBoxItem Content="LOST"/><ComboBoxItem Content="OTHER"/>
            </ComboBox>
            <TextBox x:Name="DamageQuantity" Width="100" Margin="8,0" ToolTip="Quantity" />
            <TextBox x:Name="DamageRecovered" Width="110" Margin="0,0,8,0" Text="0" ToolTip="Recovered amount" />
            <Button Margin="0,0,8,0" Click="RecordDamage_OnClick" Content="{l:Tr MoneyOut_RecordDamage}" />
            <Button Margin="0,0,8,0" Click="BulkWriteOff_OnClick" Content="{l:Tr MoneyOut_WriteOff}" />
            <Button Margin="0,0,8,0" Click="BlockLot_OnClick" Content="{l:Tr MoneyOut_BlockLot}" />
            <Button Margin="0,0,8,0" Click="MarkDown_OnClick" Content="{l:Tr MoneyOut_MarkDown}" />
            <Button Click="PrintExpiry_OnClick" Content="{l:Tr MoneyOut_PrintVendorList}" />
          </StackPanel>
          <TabControl x:Name="ExpiryTabs">
            <TabItem Header="{l:Tr MoneyOut_Expired}"><ListBox x:Name="ExpiredList" ItemTemplate="{StaticResource ExpiryLotTemplate}" SelectionMode="Extended"/></TabItem>
            <TabItem Header="{l:Tr MoneyOut_Critical}"><ListBox x:Name="CriticalList" ItemTemplate="{StaticResource ExpiryLotTemplate}" SelectionMode="Extended"/></TabItem>
            <TabItem Header="{l:Tr MoneyOut_Soon}"><ListBox x:Name="SoonList" ItemTemplate="{StaticResource ExpiryLotTemplate}" SelectionMode="Extended"/></TabItem>
          </TabControl>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Damages}">
        <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <ComboBox x:Name="DamageLot" Width="240" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="ProductName"/>
          <TextBox x:Name="DamageAnyQuantity" Width="90" Margin="8,0" ToolTip="{l:Tr Stock_Quantity}"/>
          <ComboBox x:Name="DamageAnyReason" Width="135" SelectedIndex="0"><ComboBoxItem Content="EXPIRED"/><ComboBoxItem Content="BROKEN"/><ComboBoxItem Content="SPOILED"/><ComboBoxItem Content="PEST"/><ComboBoxItem Content="LOST"/><ComboBoxItem Content="CUSTOMER_RETURN"/><ComboBoxItem Content="OTHER"/></ComboBox>
          <TextBox x:Name="DamageAnyRecovered" Width="100" Margin="8,0" Text="0" ToolTip="{l:Tr MoneyOut_Recovered}"/>
          <TextBox x:Name="DamageNotes" Width="180" ToolTip="{l:Tr Purchasing_Notes}"/>
          <Button Margin="8,0,0,0" Click="RecordAnyDamage_OnClick" Content="{l:Tr MoneyOut_RecordDamage}"/>
        </WrapPanel>
        <DataGrid x:Name="DamageGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Document}" Binding="{Binding DocumentNumber}"/>
            <DataGridTextColumn Width="105" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
            <DataGridTextColumn Width="2*" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
            <DataGridTextColumn Width="115" Header="{l:Tr MoneyOut_Cost}" Binding="{Binding CostValue}"/>
            <DataGridTextColumn Width="115" Header="{l:Tr MoneyOut_Recovered}" Binding="{Binding RecoveredAmount}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_Reason}" Binding="{Binding Reason}"/>
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Expenses}">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <DatePicker x:Name="ExpenseDate" Width="140"/>
            <ComboBox x:Name="ExpenseCategory" Width="180" Margin="8,0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <TextBox x:Name="ExpenseAmount" Width="110" ToolTip="Amount"/>
            <ComboBox x:Name="ExpenseMode" Width="100" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="CASH"/><ComboBoxItem Content="UPI"/><ComboBoxItem Content="BANK"/><ComboBoxItem Content="CARD"/><ComboBoxItem Content="OTHER"/></ComboBox>
            <TextBox x:Name="ExpensePaidTo" Width="150" ToolTip="Paid to"/>
            <TextBox x:Name="ExpenseReference" Width="120" Margin="8,0,0,0" ToolTip="{l:Tr MoneyOut_Reference}"/>
            <TextBox x:Name="ExpenseNotes" Width="150" Margin="8,0,0,0" ToolTip="{l:Tr Purchasing_Notes}"/>
            <Button Margin="8,0" Click="SaveExpense_OnClick" Content="{l:Tr MoneyOut_SaveExpense}"/>
            <Button Click="RepeatExpense_OnClick" Content="{l:Tr MoneyOut_RepeatLastMonth}"/>
            <Button Margin="8,0,0,0" Click="OpenAssets_OnClick" Content="{l:Tr MoneyOut_OpenAssets}"/>
          </WrapPanel>
          <DataGrid x:Name="RepeatDraftGrid" DockPanel.Dock="Top" Height="110" Margin="0,0,0,10" AutoGenerateColumns="False" CanUserAddRows="False" Visibility="Collapsed" SelectionChanged="RepeatDraftGrid_OnSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryId}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Amount}" Binding="{Binding Amount}"/>
              <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
              <DataGridTextColumn Width="2*" Header="{l:Tr MoneyOut_PaidTo}" Binding="{Binding PaidTo}"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal">
            <TextBox x:Name="NewCategoryName" Width="180" ToolTip="Category name"/>
            <TextBox x:Name="NewCategoryLocal" Width="180" Margin="8,0" ToolTip="Gujarati name"/>
            <Button Click="AddCategory_OnClick" Content="{l:Tr MoneyOut_AddCategory}"/>
          </StackPanel>
          <DataGrid x:Name="ExpenseGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Width="110" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
              <DataGridTextColumn Width="2*" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryName}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Amount}" Binding="{Binding Amount}"/>
              <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
              <DataGridTextColumn Width="2*" Header="{l:Tr MoneyOut_PaidTo}" Binding="{Binding PaidTo}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Payroll}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,10">
            <TextBox x:Name="EmployeeName" Width="180" ToolTip="Employee name"/>
            <TextBox x:Name="EmployeePhone" Width="120" Margin="8,0,0,0" ToolTip="{l:Tr MoneyOut_Phone}"/>
            <TextBox x:Name="EmployeeRole" Width="140" Margin="8,0" ToolTip="Role"/>
            <DatePicker x:Name="EmployeeJoinDate" Width="130"/>
            <DatePicker x:Name="EmployeeLeaveDate" Width="130" Margin="8,0"/>
            <TextBox x:Name="EmployeeSalary" Width="110" ToolTip="Monthly salary"/>
            <Button Margin="8,0" Click="AddEmployee_OnClick" Content="{l:Tr MoneyOut_AddEmployee}"/>
            <TextBox x:Name="SalaryPeriod" Width="90" Text="2026-09" ToolTip="YYYY-MM"/>
            <DatePicker x:Name="SalaryPayDate" Width="130" Margin="8,0"/>
            <ComboBox x:Name="SalaryMode" Width="90" SelectedIndex="2"><ComboBoxItem Content="CASH"/><ComboBoxItem Content="UPI"/><ComboBoxItem Content="BANK"/><ComboBoxItem Content="OTHER"/></ComboBox>
            <Button Margin="8,0" Click="PrepareSalary_OnClick" Content="{l:Tr MoneyOut_PrepareSalary}"/>
            <Button Click="PostSalary_OnClick" Content="{l:Tr MoneyOut_PostSalary}"/>
            <TextBox x:Name="AdvanceAmount" Width="100" Margin="8,0" ToolTip="{l:Tr MoneyOut_Advance}"/>
            <TextBox x:Name="AdvanceNotes" Width="140" ToolTip="{l:Tr Purchasing_Notes}"/>
            <Button Margin="8,0,0,0" Click="RecordAdvance_OnClick" Content="{l:Tr MoneyOut_RecordAdvance}"/>
          </WrapPanel>
          <DataGrid x:Name="EmployeeGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns><DataGridTextColumn Width="2*" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}"/><DataGridTextColumn Width="140" Header="{l:Tr MoneyOut_Role}" Binding="{Binding Role}"/><DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding MonthlySalary}"/></DataGrid.Columns>
          </DataGrid>
          <DataGrid x:Name="SalaryGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Width="90" Header="ID" Binding="{Binding EmployeeId}" IsReadOnly="True"/>
              <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding BaseSalary}"/>
              <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_LeaveDeduction}" Binding="{Binding LeaveDeduction}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Overtime}" Binding="{Binding Overtime}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Bonus}" Binding="{Binding Bonus}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" />
  </Grid>
</Page>
