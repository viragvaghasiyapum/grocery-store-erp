<Page
    x:Class="GroceryErp.App.Presentation.MoneyOutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr MoneyOut_Title}">
  <Page.Resources>
    <DataTemplate x:Key="ExpiryHeaderTemplate">
      <Border Background="#EDF1F6" Padding="8,8" BorderBrush="{StaticResource TableRuleBrush}" BorderThickness="1,1,1,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="35"/><ColumnDefinition Width="90"/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/>
            <ColumnDefinition Width="105"/><ColumnDefinition Width="75"/><ColumnDefinition Width="95"/>
            <ColumnDefinition Width="110"/><ColumnDefinition Width="140"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{l:Tr Catalog_Sku}"/>
          <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{l:Tr Catalog_Name}"/>
          <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{l:Tr Stock_LotCode}"/>
          <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="{l:Tr Stock_Expiry}"/>
          <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="{l:Tr MoneyOut_DaysLeft}"/>
          <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="{l:Tr Stock_Quantity}"/>
          <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="{l:Tr MoneyOut_Cost}"/>
          <TextBlock Grid.Column="8" FontWeight="SemiBold" Text="{l:Tr Purchasing_Vendor}"/>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ExpiryLotTemplate">
      <Border Padding="8,6" BorderBrush="{StaticResource TableRuleBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="35"/><ColumnDefinition Width="90"/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/>
          <ColumnDefinition Width="105"/><ColumnDefinition Width="75"/><ColumnDefinition Width="95"/>
          <ColumnDefinition Width="110"/><ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" Loaded="ExpiryCheck_OnLoaded" Click="ExpiryCheck_OnClick" AutomationProperties.Name="Select lot"/>
        <TextBlock Grid.Column="1" Text="{Binding Sku}"/>
        <StackPanel Grid.Column="2"><TextBlock Text="{Binding ProductName}"/><TextBlock FontSize="11" Foreground="Gray" Text="{Binding ProductNameLocal}"/></StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding LotCode}"/>
        <TextBlock Grid.Column="4" Text="{Binding ExpiryDate}"/>
        <TextBlock Grid.Column="5" Text="{Binding DaysLeft}"/>
        <TextBlock Grid.Column="6" Text="{Binding Quantity}"/>
        <TextBlock Grid.Column="7" Text="{Binding CostValue}"/>
        <TextBlock Grid.Column="8" Text="{Binding VendorName}"/>
      </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" DockPanel.Dock="Right" Width="65" SelectedIndex="2" SelectionChanged="PageSize_OnChanged"><ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox><TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr MoneyOut_Title}" /></DockPanel>
    <TabControl x:Name="MoneyOutTabs" Grid.Row="1" Margin="0,18,0,0" SelectionChanged="Tabs_OnSelectionChanged">
      <TabItem Header="{l:Tr MoneyOut_Expiry}">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" HorizontalAlignment="Right">
            <ComboBox x:Name="DamageReason" Width="150" SelectedIndex="0">
              <ComboBoxItem Tag="EXPIRED" Content="{l:Tr MoneyOut_ReasonExpired}"/><ComboBoxItem Tag="BROKEN" Content="{l:Tr MoneyOut_ReasonBroken}"/><ComboBoxItem Tag="SPOILED" Content="{l:Tr MoneyOut_ReasonSpoiled}"/>
              <ComboBoxItem Tag="PEST" Content="{l:Tr MoneyOut_ReasonPest}"/><ComboBoxItem Tag="LOST" Content="{l:Tr MoneyOut_ReasonLost}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/>
            </ComboBox>
            <TextBox x:Name="DamageQuantity" Width="100" Margin="8,0" ToolTip="{l:Tr Stock_Quantity}" />
            <TextBox x:Name="DamageRecovered" Width="110" Margin="0,0,8,0" Text="0" ToolTip="{l:Tr MoneyOut_Recovered}" />
            <Button Margin="0,0,8,0" Click="RecordDamage_OnClick" Content="{l:Tr MoneyOut_RecordDamage}" />
            <Button x:Name="BulkWriteOffButton" IsEnabled="False" Margin="0,0,8,0" Click="BulkWriteOff_OnClick" Content="{l:Tr MoneyOut_WriteOff}" />
            <Button Margin="0,0,8,0" Click="BlockLot_OnClick" Content="{l:Tr MoneyOut_BlockLot}" />
            <Button Margin="0,0,8,0" Click="MarkDown_OnClick" Content="{l:Tr MoneyOut_MarkDown}" />
            <Button Click="PrintExpiry_OnClick" Content="{l:Tr MoneyOut_PrintVendorList}" />
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Margin="0,0,8,0" Click="SelectExpiryPage_OnClick" Content="{l:Tr Selection_ThisPage}"/>
            <Button x:Name="SelectAllExpiryButton" Margin="0,0,8,0" Click="SelectAllExpiry_OnClick" Content="{l:Tr Selection_AllMatching}"/>
            <Button x:Name="ClearExpirySelectionButton" IsEnabled="False" Margin="0,0,8,0" Click="ClearExpirySelection_OnClick" Content="{l:Tr Selection_Clear}"/>
            <TextBlock x:Name="ExpirySelectedCount" VerticalAlignment="Center" Text="0 selected"/>
          </WrapPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="PreviousExpiryButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousExpiry_OnClick" Content="{l:Tr Sales_Previous}"/>
            <Button x:Name="NextExpiryButton" IsEnabled="False" Click="NextExpiry_OnClick" Content="{l:Tr Sales_Next}"/>
          </StackPanel>
          <TabControl x:Name="ExpiryTabs" Margin="0,12,0,0" SelectionChanged="ExpiryTabs_OnSelectionChanged">
            <TabItem Header="{l:Tr MoneyOut_Expired}"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ContentControl Content=" " ContentTemplate="{StaticResource ExpiryHeaderTemplate}"/><ListBox x:Name="ExpiredList" Grid.Row="1" ItemTemplate="{StaticResource ExpiryLotTemplate}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
            <TabItem Header="{l:Tr MoneyOut_Critical}"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ContentControl Content=" " ContentTemplate="{StaticResource ExpiryHeaderTemplate}"/><ListBox x:Name="CriticalList" Grid.Row="1" ItemTemplate="{StaticResource ExpiryLotTemplate}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
            <TabItem Header="{l:Tr MoneyOut_Soon}"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ContentControl Content=" " ContentTemplate="{StaticResource ExpiryHeaderTemplate}"/><ListBox x:Name="SoonList" Grid.Row="1" ItemTemplate="{StaticResource ExpiryLotTemplate}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
          </TabControl>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Damages}">
        <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <DatePicker x:Name="DamageFromBox" Width="140" Margin="0,0,8,8" SelectedDateFormat="Short"/>
          <DatePicker x:Name="DamageToBox" Width="140" Margin="0,0,8,8" SelectedDateFormat="Short"/>
          <Button Click="DamageFilter_OnClick" Content="Search history"/>
          <Button x:Name="CorrectDamageButton" Margin="8,0,0,0" IsEnabled="False" Click="CorrectDamage_OnClick" Content="{l:Tr MoneyOut_CorrectPosted}"/>
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" ItemHeight="64">
            <StackPanel Width="260" Margin="0,0,8,0"><TextBlock Text="{l:Tr Stock_Lots}"/><TextBox x:Name="DamageLotSearchBox" ToolTip="Product or lot"/><Button Click="SearchDamageLot_OnClick" Content="Search"/><ComboBox x:Name="DamageLot" IsTextSearchEnabled="True" TextSearch.TextPath="ProductName"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ProductName}"/><TextBlock FontSize="11" Text="{Binding LotCode}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
          <StackPanel Width="95" Margin="0,0,8,0"><TextBlock Text="{l:Tr Stock_Quantity}"/><TextBox x:Name="DamageAnyQuantity"/></StackPanel>
          <StackPanel Width="150" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Reason}"/><ComboBox x:Name="DamageAnyReason" SelectedIndex="0"><ComboBoxItem Tag="EXPIRED" Content="{l:Tr MoneyOut_ReasonExpired}"/><ComboBoxItem Tag="BROKEN" Content="{l:Tr MoneyOut_ReasonBroken}"/><ComboBoxItem Tag="SPOILED" Content="{l:Tr MoneyOut_ReasonSpoiled}"/><ComboBoxItem Tag="PEST" Content="{l:Tr MoneyOut_ReasonPest}"/><ComboBoxItem Tag="LOST" Content="{l:Tr MoneyOut_ReasonLost}"/><ComboBoxItem Tag="CUSTOMER_RETURN" Content="{l:Tr MoneyOut_ReasonReturn}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/></ComboBox></StackPanel>
          <StackPanel Width="110" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Recovered}"/><TextBox x:Name="DamageAnyRecovered" Text="0"/></StackPanel>
          <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="DamageNotes"/></StackPanel>
          <Button Margin="0,17,0,0" Click="RecordAnyDamage_OnClick" Content="{l:Tr MoneyOut_RecordDamage}"/>
        </WrapPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
          <Button x:Name="PreviousDamageButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousDamage_OnClick" Content="{l:Tr Sales_Previous}"/>
          <Button x:Name="NextDamageButton" IsEnabled="False" Click="NextDamage_OnClick" Content="{l:Tr Sales_Next}"/>
        </StackPanel>
        <DataGrid Style="{StaticResource CatalogGrid}" x:Name="DamageGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="DamageGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Document}" Binding="{Binding DocumentNumber}"/>
            <DataGridTextColumn Width="105" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
            <DataGridTextColumn Width="240" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
            <DataGridTextColumn Width="115" Header="{l:Tr MoneyOut_Cost}" Binding="{Binding CostValue}"/>
            <DataGridTextColumn Width="115" Header="{l:Tr MoneyOut_Recovered}" Binding="{Binding RecoveredAmount}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_Reason}" Binding="{Binding Reason}"/>
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Expenses}">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <DatePicker x:Name="ExpenseFromBox" Width="140" Margin="0,0,8,8" SelectedDateFormat="Short"/>
            <DatePicker x:Name="ExpenseToBox" Width="140" Margin="0,0,8,8" SelectedDateFormat="Short"/>
            <Button Click="ExpenseFilter_OnClick" Content="Search history"/>
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" ItemHeight="64">
            <StackPanel Width="140" Margin="0,0,8,4"><TextBlock Text="{l:Tr Purchasing_Date}"/><DatePicker x:Name="ExpenseDate" SelectedDateFormat="Short"/></StackPanel>
            <StackPanel Width="180" Margin="0,0,8,4"><TextBlock Text="{l:Tr Catalog_Category}"/><ComboBox x:Name="ExpenseCategory" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
            <StackPanel Width="110" Margin="0,0,8,4"><TextBlock Text="{l:Tr MoneyOut_Amount}"/><TextBox x:Name="ExpenseAmount"/></StackPanel>
            <StackPanel Width="100" Margin="0,0,8,4"><TextBlock Text="{l:Tr Purchasing_Mode}"/><ComboBox x:Name="ExpenseMode" SelectedIndex="0"><ComboBoxItem Tag="CASH" Content="{l:Tr MoneyOut_ModeCash}"/><ComboBoxItem Tag="UPI" Content="UPI"/><ComboBoxItem Tag="BANK" Content="{l:Tr MoneyOut_ModeBank}"/><ComboBoxItem Tag="CARD" Content="{l:Tr MoneyOut_ModeCard}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/></ComboBox></StackPanel>
            <StackPanel Width="150" Margin="0,0,8,4"><TextBlock Text="{l:Tr MoneyOut_PaidTo}"/><TextBox x:Name="ExpensePaidTo"/></StackPanel>
            <StackPanel Width="120" Margin="0,0,8,4"><TextBlock Text="{l:Tr MoneyOut_Reference}"/><TextBox x:Name="ExpenseReference"/></StackPanel>
            <StackPanel Width="150" Margin="0,0,8,4"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="ExpenseNotes"/></StackPanel>
            <Button Margin="0,17,8,4" Click="SaveExpense_OnClick" Content="{l:Tr MoneyOut_SaveExpense}"/>
            <Button Margin="0,17,8,4" Click="NewExpense_OnClick" Content="{l:Tr MoneyOut_NewEntry}"/>
            <Button Margin="0,17,8,4" Click="RepeatExpense_OnClick" Content="{l:Tr MoneyOut_RepeatLastMonth}"/>
            <Button Margin="0,17,0,4" Click="OpenAssets_OnClick" Content="{l:Tr MoneyOut_OpenAssets}"/>
          </WrapPanel>
          <StackPanel x:Name="ExpenseCorrectionPanel" DockPanel.Dock="Top" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr MoneyOut_RequiredCorrectionReason}"/>
            <TextBox x:Name="ExpenseCorrectionReason" Width="330" MaxLength="240"/>
          </StackPanel>
          <Expander DockPanel.Dock="Top" Header="{l:Tr MoneyOut_RepeatCategories}" Margin="0,0,0,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Click="ClearRepeatCategories_OnClick" Content="{l:Tr Selection_Clear}" Margin="0,0,8,0"/>
                <TextBlock x:Name="RepeatCategorySelectedCount" VerticalAlignment="Center"/>
              </StackPanel>
              <ListBox x:Name="RepeatCategories" Height="82" SelectionMode="Multiple" SelectionChanged="RepeatCategories_OnSelectionChanged">
                <ListBox.ItemTemplate><DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Expander>
          <DataGrid Style="{StaticResource CatalogGrid}" x:Name="RepeatDraftGrid" DockPanel.Dock="Top" Height="110" Margin="0,0,0,10" AutoGenerateColumns="False" CanUserAddRows="False" Visibility="Collapsed" SelectionChanged="RepeatDraftGrid_OnSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryId}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Amount}" Binding="{Binding Amount}"/>
              <DataGridTextColumn Width="145" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
              <DataGridTextColumn Width="220" Header="{l:Tr MoneyOut_PaidTo}" Binding="{Binding PaidTo}"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" ItemHeight="62">
            <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_ChooseCategory}"/><ComboBox x:Name="CategoryMaster" DisplayMemberPath="Name" SelectionChanged="ExpenseCategory_OnSelectionChanged"/></StackPanel>
            <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_CategoryName}"/><TextBox x:Name="NewCategoryName"/></StackPanel>
            <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_LocalName}"/><TextBox x:Name="NewCategoryLocal"/></StackPanel>
            <CheckBox x:Name="CategoryActive" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Content="{l:Tr MoneyOut_Active}"/>
            <Button Margin="0,17,8,0" Click="NewCategory_OnClick" Content="{l:Tr MoneyOut_New}"/>
            <Button Margin="0,17,0,0" Click="AddCategory_OnClick" Content="{l:Tr Common_Save}"/>
          </WrapPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="PreviousExpenseButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousExpense_OnClick" Content="{l:Tr Sales_Previous}"/>
            <Button x:Name="NextExpenseButton" IsEnabled="False" Click="NextExpense_OnClick" Content="{l:Tr Sales_Next}"/>
          </StackPanel>
          <DataGrid Style="{StaticResource CatalogGrid}" x:Name="ExpenseGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="ExpenseGrid_OnSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Width="110" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
              <DataGridTextColumn Width="220" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryName}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Amount}" Binding="{Binding Amount}"/>
              <DataGridTextColumn Width="145" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
              <DataGridTextColumn Width="220" Header="{l:Tr MoneyOut_PaidTo}" Binding="{Binding PaidTo}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Payroll}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,10">
            <WrapPanel ItemHeight="62">
              <StackPanel Width="170" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_EmployeeName}"/><TextBox x:Name="EmployeeName"/></StackPanel>
              <StackPanel Width="120" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Phone}"/><TextBox x:Name="EmployeePhone"/></StackPanel>
              <StackPanel Width="130" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Role}"/><TextBox x:Name="EmployeeRole"/></StackPanel>
              <StackPanel Width="125" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_JoinDate}"/><DatePicker x:Name="EmployeeJoinDate" SelectedDateFormat="Short"/></StackPanel>
              <StackPanel Width="125" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_LeaveDate}"/><DatePicker x:Name="EmployeeLeaveDate" SelectedDateFormat="Short"/></StackPanel>
              <StackPanel Width="110" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Salary}"/><TextBox x:Name="EmployeeSalary"/></StackPanel>
              <StackPanel Width="145" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="EmployeeNotes"/></StackPanel>
              <CheckBox x:Name="EmployeeActive" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Content="{l:Tr MoneyOut_Active}"/>
              <Button Margin="0,16,8,0" Click="NewEmployee_OnClick" Content="{l:Tr MoneyOut_New}"/>
              <Button Margin="0,16,0,0" Click="AddEmployee_OnClick" Content="{l:Tr Common_Save}"/>
            </WrapPanel>
            <WrapPanel ItemHeight="60">
              <StackPanel Width="95" Margin="0,0,8,0"><TextBlock Text="{l:Tr Assets_Period}"/><TextBox x:Name="SalaryPeriod" Text="2026-09"/></StackPanel>
              <StackPanel Width="125" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_PayDate}"/><DatePicker x:Name="SalaryPayDate" SelectedDateFormat="Short"/></StackPanel>
              <StackPanel Width="115" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Mode}"/><ComboBox x:Name="SalaryMode" SelectedIndex="2"><ComboBoxItem Tag="CASH" Content="{l:Tr MoneyOut_ModeCash}"/><ComboBoxItem Tag="UPI" Content="UPI"/><ComboBoxItem Tag="BANK" Content="{l:Tr MoneyOut_ModeBank}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/></ComboBox></StackPanel>
              <Button Margin="0,16,8,0" Click="PrepareSalary_OnClick" Content="{l:Tr MoneyOut_PrepareSalary}"/>
              <Button Margin="0,16,8,0" Click="PostSalary_OnClick" Content="{l:Tr MoneyOut_PostSalary}"/>
              <StackPanel Width="110" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Advance}"/><TextBox x:Name="AdvanceAmount"/></StackPanel>
              <StackPanel Width="135" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="AdvanceNotes"/></StackPanel>
              <Button Margin="0,16,0,0" Click="RecordAdvance_OnClick" Content="{l:Tr MoneyOut_RecordAdvance}"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="EmployeeGrid" Grid.Row="1" Style="{StaticResource CatalogGrid}" SelectionChanged="EmployeeGrid_OnSelectionChanged">
            <DataGrid.Columns><DataGridTextColumn Width="260" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}"/><DataGridTextColumn Width="160" Header="{l:Tr MoneyOut_Role}" Binding="{Binding Role}"/><DataGridTextColumn Width="150" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding MonthlySalary}"/></DataGrid.Columns>
          </DataGrid>
          <TabControl Grid.Row="2">
            <TabItem Header="{l:Tr MoneyOut_PrepareSalary}">
              <DataGrid Style="{StaticResource CatalogGrid}" x:Name="SalaryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_EmployeeId}" Binding="{Binding EmployeeId}" IsReadOnly="True"/>
                  <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding BaseSalary}"/>
                  <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_LeaveDeduction}" Binding="{Binding LeaveDeduction}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Overtime}" Binding="{Binding Overtime}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Bonus}" Binding="{Binding Bonus}"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="{l:Tr MoneyOut_PostedPayments}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                  <Button Margin="0,0,8,0" Click="RefreshSalaryRegister_OnClick" Content="{l:Tr Stock_Refresh}"/>
                  <Button x:Name="CorrectSalaryButton" IsEnabled="False" Click="CorrectSalary_OnClick" Content="{l:Tr MoneyOut_CorrectPosted}"/>
                </StackPanel>
                <DataGrid Style="{StaticResource CatalogGrid}" x:Name="SalaryRegisterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="SalaryRegisterGrid_OnSelectionChanged">
                  <DataGrid.Columns>
                    <DataGridTextColumn Width="180" Header="{l:Tr MoneyOut_EmployeeName}" Binding="{Binding EmployeeName}"/>
                    <DataGridTextColumn Width="110" Header="{l:Tr Assets_Period}" Binding="{Binding Period}"/>
                    <DataGridTextColumn Width="110" Header="{l:Tr MoneyOut_PayDate}" Binding="{Binding PayDate}"/>
                    <DataGridTextColumn Width="110" Header="{l:Tr MoneyOut_Reason}" Binding="{Binding Kind}"/>
                    <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding Amount}"/>
                    <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
                    <DataGridTextColumn Width="220" Header="{l:Tr Purchasing_Notes}" Binding="{Binding Notes}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" />
  </Grid>
</Page>
