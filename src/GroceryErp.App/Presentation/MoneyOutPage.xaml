<Page
    x:Class="GroceryErp.App.Presentation.MoneyOutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr MoneyOut_Title}" ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <ControlTemplate x:Key="ExpiryTabsTemplate" TargetType="TabControl">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TabPanel x:Name="HeaderPanel" Grid.Column="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tag}" HorizontalAlignment="Right"/>
        </Grid>
        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
      </Grid>
    </ControlTemplate>
    <DataTemplate x:Key="ExpiryCheckTemplate">
      <CheckBox Loaded="ExpiryCheck_OnLoaded" Click="ExpiryCheck_OnClick"
                HorizontalAlignment="Center" AutomationProperties.Name="Select lot"/>
    </DataTemplate>
    <DataTemplate x:Key="ExpiryHeaderCheckTemplate">
      <CheckBox Loaded="ExpiryHeaderCheck_OnLoaded" Unloaded="ExpiryHeaderCheck_OnUnloaded"
                Click="ExpiryHeaderCheck_OnClick" HorizontalAlignment="Center"
                Tag="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}}"
                AutomationProperties.Name="{l:Tr Selection_ThisPage}"/>
    </DataTemplate>
    <DataTemplate x:Key="ExpiryNameTemplate">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis"/>
        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding ProductNameLocal}"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>
  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{l:Tr MoneyOut_Title}" />
    <TabControl x:Name="MoneyOutTabs" Grid.Row="1" Margin="0,8,0,0" SelectedIndex="1" SelectionChanged="Tabs_OnSelectionChanged">
      <TabItem Header="{l:Tr MoneyOut_Expiry}" Visibility="Collapsed">
        <DockPanel>
          <TabControl x:Name="ExpiryTabs" Margin="0,6,0,0" Template="{StaticResource ExpiryTabsTemplate}" SelectionChanged="ExpiryTabs_OnSelectionChanged">
            <TabControl.Tag>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,8">
                <TextBlock x:Name="ExpirySelectedCount" VerticalAlignment="Center" Margin="0,0,12,0" Text="0 selected"/>
                <Button x:Name="ExpiryRecordDamageButton" IsEnabled="False" Margin="0,0,8,0" Click="OpenExpiryDamage_OnClick" Content="{l:Tr MoneyOut_RecordDamage}" />
                <Button x:Name="BulkWriteOffButton" IsEnabled="False" Margin="0,0,8,0" Click="BulkWriteOff_OnClick" Content="{l:Tr MoneyOut_WriteOff}" />
                <Button x:Name="PrintExpiryButton" Click="PrintExpiry_OnClick" Content="{l:Tr MoneyOut_PrintVendorList}" />
                <Popup x:Name="ExpiryDamagePopup" PlacementTarget="{Binding ElementName=ExpiryRecordDamageButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                  <Border Background="White" BorderBrush="{StaticResource TableRuleBrush}" BorderThickness="1" Padding="12"
                          MinWidth="420" Margin="0,4,0,0">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="{l:Tr MoneyOut_DamageEntry}"/>
                      <WrapPanel>
                        <StackPanel Width="150" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Reason}"/><ComboBox x:Name="DamageReason" SelectedIndex="0">
                          <ComboBoxItem Tag="EXPIRED" Content="{l:Tr MoneyOut_ReasonExpired}"/><ComboBoxItem Tag="BROKEN" Content="{l:Tr MoneyOut_ReasonBroken}"/><ComboBoxItem Tag="SPOILED" Content="{l:Tr MoneyOut_ReasonSpoiled}"/>
                          <ComboBoxItem Tag="PEST" Content="{l:Tr MoneyOut_ReasonPest}"/><ComboBoxItem Tag="LOST" Content="{l:Tr MoneyOut_ReasonLost}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/>
                        </ComboBox></StackPanel>
                        <StackPanel Width="100" Margin="0,0,8,0"><TextBlock Text="{l:Tr Stock_Quantity}"/><TextBox x:Name="DamageQuantity"/></StackPanel>
                        <StackPanel Width="110"><TextBlock Text="{l:Tr MoneyOut_Recovered}"/><TextBox x:Name="DamageRecovered" Text="0"/></StackPanel>
                      </WrapPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Click="RecordDamage_OnClick" Content="{l:Tr Common_Save}" Margin="0,0,8,0" />
                        <Button x:Name="ExpiryBlockLotButton" IsEnabled="False" Margin="0,0,8,0" Click="BlockLot_OnClick" Content="{l:Tr MoneyOut_BlockLot}" />
                        <Button x:Name="ExpiryMarkDownButton" IsEnabled="False" Click="MarkDown_OnClick" Content="{l:Tr MoneyOut_MarkDown}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
            </TabControl.Tag>
            <TabItem Header="{l:Tr MoneyOut_Expired}">
              <DataGrid x:Name="ExpiredList" Margin="0,10,0,0" Style="{StaticResource CompactTableGrid}" AutoGenerateColumns="False" SelectionChanged="ExpiryList_OnSelectionChanged">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" HeaderTemplate="{StaticResource ExpiryHeaderCheckTemplate}" CellTemplate="{StaticResource ExpiryCheckTemplate}"/>
                  <DataGridTextColumn Width="100" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}"/>
                  <DataGridTemplateColumn Width="240" Header="{l:Tr Catalog_Name}" CellTemplate="{StaticResource ExpiryNameTemplate}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
                  <DataGridTextColumn Width="110" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate}"/>
                  <DataGridTextColumn Width="85" Header="{l:Tr MoneyOut_DaysLeft}" Binding="{Binding DaysLeft}"/>
                  <DataGridTextColumn Width="105" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Cost}" Binding="{Binding CostValue}"/>
                  <DataGridTextColumn Width="160" Header="{l:Tr Purchasing_Vendor}" Binding="{Binding VendorName}"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="{l:Tr MoneyOut_Critical}">
              <DataGrid x:Name="CriticalList" Margin="0,10,0,0" Style="{StaticResource CompactTableGrid}" AutoGenerateColumns="False" SelectionChanged="ExpiryList_OnSelectionChanged">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" HeaderTemplate="{StaticResource ExpiryHeaderCheckTemplate}" CellTemplate="{StaticResource ExpiryCheckTemplate}"/>
                  <DataGridTextColumn Width="100" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}"/>
                  <DataGridTemplateColumn Width="240" Header="{l:Tr Catalog_Name}" CellTemplate="{StaticResource ExpiryNameTemplate}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
                  <DataGridTextColumn Width="110" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate}"/>
                  <DataGridTextColumn Width="85" Header="{l:Tr MoneyOut_DaysLeft}" Binding="{Binding DaysLeft}"/>
                  <DataGridTextColumn Width="105" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Cost}" Binding="{Binding CostValue}"/>
                  <DataGridTextColumn Width="160" Header="{l:Tr Purchasing_Vendor}" Binding="{Binding VendorName}"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="{l:Tr MoneyOut_Soon}">
              <DataGrid x:Name="SoonList" Margin="0,10,0,0" Style="{StaticResource CompactTableGrid}" AutoGenerateColumns="False" SelectionChanged="ExpiryList_OnSelectionChanged">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" HeaderTemplate="{StaticResource ExpiryHeaderCheckTemplate}" CellTemplate="{StaticResource ExpiryCheckTemplate}"/>
                  <DataGridTextColumn Width="100" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}"/>
                  <DataGridTemplateColumn Width="240" Header="{l:Tr Catalog_Name}" CellTemplate="{StaticResource ExpiryNameTemplate}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
                  <DataGridTextColumn Width="110" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate}"/>
                  <DataGridTextColumn Width="85" Header="{l:Tr MoneyOut_DaysLeft}" Binding="{Binding DaysLeft}"/>
                  <DataGridTextColumn Width="105" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Cost}" Binding="{Binding CostValue}"/>
                  <DataGridTextColumn Width="160" Header="{l:Tr Purchasing_Vendor}" Binding="{Binding VendorName}"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Damages}">
        <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Reports_From}"/>
          <DatePicker x:Name="DamageFromBox" Width="140" Margin="0,0,12,0" SelectedDateFormat="Short"/>
          <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Reports_To}"/>
          <DatePicker x:Name="DamageToBox" Width="140" Margin="0,0,12,0" SelectedDateFormat="Short"/>
          <Button Click="DamageFilter_OnClick" Content="{l:Tr MoneyOut_SearchHistory}"/>
          <Button x:Name="CorrectDamageButton" Margin="12,0,0,0" IsEnabled="False" Click="CorrectDamage_OnClick" Content="{l:Tr MoneyOut_CorrectPosted}"/>
        </WrapPanel>
        <p:AnimatedSection DockPanel.Dock="Top" Header="{l:Tr MoneyOut_DamageEntry}" Margin="0,0,0,8" IsExpanded="False">
        <WrapPanel Margin="0,8,0,0">
          <StackPanel Width="300" Margin="0,0,8,0">
            <TextBlock Text="{l:Tr Stock_Lots}"/>
            <DockPanel Margin="0,4,0,6">
              <Button DockPanel.Dock="Right" Margin="6,0,0,0" Click="SearchDamageLot_OnClick" Content="Search"/>
              <TextBox x:Name="DamageLotSearchBox" ToolTip="Product or lot"/>
            </DockPanel>
            <ComboBox x:Name="DamageLot" IsTextSearchEnabled="True" TextSearch.TextPath="ProductName">
              <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ProductName}"/><TextBlock FontSize="11" Text="{Binding LotCode}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Width="95" Margin="0,0,8,0"><TextBlock Text="{l:Tr Stock_Quantity}"/><TextBox x:Name="DamageAnyQuantity"/></StackPanel>
          <StackPanel Width="150" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Reason}"/><ComboBox x:Name="DamageAnyReason" SelectedIndex="0"><ComboBoxItem Tag="EXPIRED" Content="{l:Tr MoneyOut_ReasonExpired}"/><ComboBoxItem Tag="BROKEN" Content="{l:Tr MoneyOut_ReasonBroken}"/><ComboBoxItem Tag="SPOILED" Content="{l:Tr MoneyOut_ReasonSpoiled}"/><ComboBoxItem Tag="PEST" Content="{l:Tr MoneyOut_ReasonPest}"/><ComboBoxItem Tag="LOST" Content="{l:Tr MoneyOut_ReasonLost}"/><ComboBoxItem Tag="CUSTOMER_RETURN" Content="{l:Tr MoneyOut_ReasonReturn}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/></ComboBox></StackPanel>
          <StackPanel Width="110" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Recovered}"/><TextBox x:Name="DamageAnyRecovered" Text="0"/></StackPanel>
          <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="DamageNotes"/></StackPanel>
          <Button Height="36" VerticalAlignment="Top" Margin="0,18,0,0" Click="RecordAnyDamage_OnClick" Content="{l:Tr MoneyOut_RecordDamage}"/>
        </WrapPanel>
        </p:AnimatedSection>
        <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="DamageGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="DamageGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Document}" Binding="{Binding DocumentNumber}"/>
            <DataGridTextColumn Width="105" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
            <DataGridTextColumn Width="240" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
            <DataGridTextColumn Width="115" Header="{l:Tr MoneyOut_Cost}" Binding="{Binding CostValue}"/>
            <DataGridTextColumn Width="115" Header="{l:Tr MoneyOut_Recovered}" Binding="{Binding RecoveredAmount}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_Reason}" Binding="{Binding Reason}"/>
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Expenses}">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Reports_From}"/>
            <DatePicker x:Name="ExpenseFromBox" Width="140" Margin="0,0,12,0" SelectedDateFormat="Short"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Reports_To}"/>
            <DatePicker x:Name="ExpenseToBox" Width="140" Margin="0,0,12,0" SelectedDateFormat="Short"/>
            <Button Margin="0,0,12,0" Click="ExpenseFilter_OnClick" Content="{l:Tr MoneyOut_SearchHistory}"/>
            <Button Click="OpenAssets_OnClick" Content="{l:Tr MoneyOut_OpenAssets}"/>
          </WrapPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="ExpenseEntryTab" Margin="0,0,8,0" Checked="ExpenseSection_OnChanged" Unchecked="ExpenseSection_OnChanged" Content="{l:Tr MoneyOut_ExpenseEntry}"/>
            <ToggleButton x:Name="ExpenseCategoryTab" Checked="ExpenseSection_OnChanged" Unchecked="ExpenseSection_OnChanged" Content="{l:Tr MoneyOut_CategoryDetails}"/>
          </StackPanel>
          <StackPanel x:Name="ExpenseEntryPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed" ClipToBounds="True">
          <WrapPanel MaxWidth="950" HorizontalAlignment="Left" Margin="0,0,0,8" ItemHeight="64">
            <StackPanel Width="140" Margin="0,0,8,4"><TextBlock Text="{l:Tr Purchasing_Date}"/><DatePicker x:Name="ExpenseDate" SelectedDateFormat="Short"/></StackPanel>
            <StackPanel Width="180" Margin="0,0,8,4"><TextBlock Text="{l:Tr Catalog_Category}"/><ComboBox x:Name="ExpenseCategory" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
            <StackPanel Width="110" Margin="0,0,8,4"><TextBlock Text="{l:Tr MoneyOut_Amount}"/><TextBox x:Name="ExpenseAmount"/></StackPanel>
            <StackPanel Width="100" Margin="0,0,8,4"><TextBlock Text="{l:Tr Purchasing_Mode}"/><ComboBox x:Name="ExpenseMode" SelectedIndex="0"><ComboBoxItem Tag="CASH" Content="{l:Tr MoneyOut_ModeCash}"/><ComboBoxItem Tag="UPI" Content="UPI"/><ComboBoxItem Tag="BANK" Content="{l:Tr MoneyOut_ModeBank}"/><ComboBoxItem Tag="CARD" Content="{l:Tr MoneyOut_ModeCard}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/></ComboBox></StackPanel>
            <StackPanel Width="150" Margin="0,0,8,4"><TextBlock Text="{l:Tr MoneyOut_PaidTo}"/><TextBox x:Name="ExpensePaidTo"/></StackPanel>
            <StackPanel Width="120" Margin="0,0,8,4"><TextBlock Text="{l:Tr MoneyOut_Reference}"/><TextBox x:Name="ExpenseReference"/></StackPanel>
            <StackPanel Width="150" Margin="0,0,8,4"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="ExpenseNotes"/></StackPanel>
            <Button Margin="0,17,8,4" Click="SaveExpense_OnClick" Content="{l:Tr MoneyOut_SaveExpense}"/>
            <Button Margin="0,17,8,4" Click="NewExpense_OnClick" Content="{l:Tr MoneyOut_NewEntry}"/>
            <Button Margin="0,17,0,4" Click="RepeatExpense_OnClick" Content="{l:Tr MoneyOut_RepeatLastMonth}"/>
          </WrapPanel>
          <StackPanel x:Name="ExpenseCorrectionPanel" DockPanel.Dock="Top" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr MoneyOut_RequiredCorrectionReason}"/>
            <TextBox x:Name="ExpenseCorrectionReason" Width="330" MaxLength="240"/>
          </StackPanel>
          <p:AnimatedSection DockPanel.Dock="Top" Header="{l:Tr MoneyOut_RepeatCategories}" Margin="0,0,0,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Click="ClearRepeatCategories_OnClick" Content="{l:Tr Selection_Clear}" Margin="0,0,8,0"/>
                <TextBlock x:Name="RepeatCategorySelectedCount" VerticalAlignment="Center"/>
              </StackPanel>
              <ListBox x:Name="RepeatCategories" Height="82" SelectionMode="Multiple" SelectionChanged="RepeatCategories_OnSelectionChanged">
                <ListBox.ItemTemplate><DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </p:AnimatedSection>
          <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="RepeatDraftGrid" DockPanel.Dock="Top" Height="110" Margin="0,0,0,10" AutoGenerateColumns="False" CanUserAddRows="False" Visibility="Collapsed" SelectionChanged="RepeatDraftGrid_OnSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryId}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Amount}" Binding="{Binding Amount}"/>
              <DataGridTextColumn Width="145" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
              <DataGridTextColumn Width="220" Header="{l:Tr MoneyOut_PaidTo}" Binding="{Binding PaidTo}"/>
            </DataGrid.Columns>
          </DataGrid>
          </StackPanel>
          <WrapPanel x:Name="ExpenseCategoryPanel" Grid.Row="1" Margin="0,8,0,0" ItemHeight="62" Visibility="Collapsed" ClipToBounds="True">
            <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_ChooseCategory}"/><ComboBox x:Name="CategoryMaster" DisplayMemberPath="Name" SelectionChanged="ExpenseCategory_OnSelectionChanged"/></StackPanel>
            <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_CategoryName}"/><TextBox x:Name="NewCategoryName"/></StackPanel>
            <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_LocalName}"/><TextBox x:Name="NewCategoryLocal"/></StackPanel>
            <CheckBox x:Name="CategoryActive" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Content="{l:Tr MoneyOut_Active}"/>
            <Button Margin="0,17,8,0" Click="NewCategory_OnClick" Content="{l:Tr MoneyOut_New}"/>
            <Button Margin="0,17,0,0" Click="AddCategory_OnClick" Content="{l:Tr Common_Save}"/>
          </WrapPanel>
          </Grid>
          <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="ExpenseGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="ExpenseGrid_OnSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Width="110" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
              <DataGridTextColumn Width="220" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryName}"/>
              <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Amount}" Binding="{Binding Amount}"/>
              <DataGridTextColumn Width="145" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
              <DataGridTextColumn Width="220" Header="{l:Tr MoneyOut_PaidTo}" Binding="{Binding PaidTo}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Payroll}">
        <TabControl x:Name="PayrollTabs" Margin="0,8,0,0">
          <TabItem Header="{l:Tr MoneyOut_Employees}">
            <DockPanel Margin="0,8,0,0">
            <p:AnimatedSection x:Name="EmployeeDetailsExpander" DockPanel.Dock="Top" Header="{l:Tr MoneyOut_EmployeeDetails}" Margin="0,0,0,8" IsExpanded="False">
            <WrapPanel MaxWidth="950" HorizontalAlignment="Left" Margin="0,8,0,0" ItemHeight="62">
              <StackPanel Width="170" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_EmployeeName}"/><TextBox x:Name="EmployeeName"/></StackPanel>
              <StackPanel Width="120" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Phone}"/><TextBox x:Name="EmployeePhone"/></StackPanel>
              <StackPanel Width="130" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Role}"/><TextBox x:Name="EmployeeRole"/></StackPanel>
              <StackPanel Width="125" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_JoinDate}"/><DatePicker x:Name="EmployeeJoinDate" SelectedDateFormat="Short"/></StackPanel>
              <StackPanel Width="125" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_LeaveDate}"/><DatePicker x:Name="EmployeeLeaveDate" SelectedDateFormat="Short"/></StackPanel>
              <StackPanel Width="110" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Salary}"/><TextBox x:Name="EmployeeSalary"/></StackPanel>
              <StackPanel Width="145" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="EmployeeNotes"/></StackPanel>
              <CheckBox x:Name="EmployeeActive" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Content="{l:Tr MoneyOut_Active}"/>
              <Button Margin="0,16,8,0" Click="NewEmployee_OnClick" Content="{l:Tr MoneyOut_New}"/>
              <Button Margin="0,16,0,0" Click="AddEmployee_OnClick" Content="{l:Tr Common_Save}"/>
            </WrapPanel>
            </p:AnimatedSection>
            <DataGrid x:Name="EmployeeGrid" Style="{StaticResource CompactTableGrid}" SelectionChanged="EmployeeGrid_OnSelectionChanged">
            <DataGrid.Columns><DataGridTextColumn Width="260" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}"/><DataGridTextColumn Width="160" Header="{l:Tr MoneyOut_Role}" Binding="{Binding Role}"/><DataGridTextColumn Width="150" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding MonthlySalary}"/></DataGrid.Columns>
            </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="{l:Tr MoneyOut_PrepareSalary}">
            <DockPanel Margin="0,8,0,0">
              <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Width="100" Margin="0,0,8,0"><TextBlock Text="{l:Tr Assets_Period}"/><TextBox x:Name="SalaryPeriod"/></StackPanel>
                <StackPanel Width="135" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_PayDate}"/><DatePicker x:Name="SalaryPayDate" SelectedDateFormat="Short"/></StackPanel>
                <StackPanel Width="115" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Mode}"/><ComboBox x:Name="SalaryMode" SelectedIndex="2"><ComboBoxItem Tag="CASH" Content="{l:Tr MoneyOut_ModeCash}"/><ComboBoxItem Tag="UPI" Content="UPI"/><ComboBoxItem Tag="BANK" Content="{l:Tr MoneyOut_ModeBank}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/></ComboBox></StackPanel>
                <Button Margin="0,18,8,0" Click="PrepareSalary_OnClick" Content="{l:Tr MoneyOut_PrepareSalary}"/>
                <Button x:Name="PostSalaryButton" IsEnabled="False" Margin="0,18,8,0" Click="PostSalary_OnClick" Content="{l:Tr MoneyOut_PostSalary}"/>
                <TextBlock x:Name="SalarySelectedCount" VerticalAlignment="Bottom" Margin="0,0,0,8" Text="0 selected"/>
              </WrapPanel>
              <DataGrid Style="{StaticResource CatalogGrid}" x:Name="SalaryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48">
                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsThreeState="True" Loaded="SalaryPageCheck_OnLoaded" Click="SalaryPageCheck_OnClick" AutomationProperties.Name="{l:Tr Selection_ThisPage}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="SalaryCheck_OnClick" AutomationProperties.Name="{l:Tr MoneyOut_SelectSalary}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Width="180" Header="{l:Tr MoneyOut_EmployeeName}" Binding="{Binding EmployeeName}" IsReadOnly="True"/>
                  <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding BaseSalary}"/>
                  <DataGridTextColumn Width="130" Header="{l:Tr MoneyOut_LeaveDeduction}" Binding="{Binding LeaveDeduction}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Overtime}" Binding="{Binding Overtime}"/>
                  <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Bonus}" Binding="{Binding Bonus}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="{l:Tr MoneyOut_PostedPayments}">
              <DockPanel Margin="0,8,0,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <StackPanel Width="100" Margin="0,0,8,0"><TextBlock Text="{l:Tr Assets_Period}"/><TextBox x:Name="SalaryRegisterPeriod"/></StackPanel>
                  <Button Margin="0,18,8,0" Click="RefreshSalaryRegister_OnClick" Content="{l:Tr Stock_Refresh}"/>
                  <Button x:Name="CorrectSalaryButton" IsEnabled="False" Margin="0,18,0,0" Click="CorrectSalary_OnClick" Content="{l:Tr MoneyOut_CorrectPosted}"/>
                </WrapPanel>
                <p:AnimatedSection DockPanel.Dock="Top" Header="{l:Tr MoneyOut_AdvanceDetails}" Margin="0,0,0,8" IsExpanded="False">
                <WrapPanel Margin="0,8,0,0">
                  <StackPanel Width="190" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_EmployeeName}"/><ComboBox x:Name="AdvanceEmployeeBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
                  <StackPanel Width="135" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_PayDate}"/><DatePicker x:Name="AdvancePayDate" SelectedDateFormat="Short"/></StackPanel>
                  <StackPanel Width="115" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Mode}"/><ComboBox x:Name="AdvanceMode" SelectedIndex="2"><ComboBoxItem Tag="CASH" Content="{l:Tr MoneyOut_ModeCash}"/><ComboBoxItem Tag="UPI" Content="UPI"/><ComboBoxItem Tag="BANK" Content="{l:Tr MoneyOut_ModeBank}"/><ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/></ComboBox></StackPanel>
                  <StackPanel Width="110" Margin="0,0,8,0"><TextBlock Text="{l:Tr MoneyOut_Advance}"/><TextBox x:Name="AdvanceAmount"/></StackPanel>
                  <StackPanel Width="180" Margin="0,0,8,0"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="AdvanceNotes"/></StackPanel>
                  <Button Margin="0,18,0,0" Click="RecordAdvance_OnClick" Content="{l:Tr MoneyOut_RecordAdvance}"/>
                </WrapPanel>
                </p:AnimatedSection>
                <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="SalaryRegisterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="SalaryRegisterGrid_OnSelectionChanged">
                  <DataGrid.Columns>
                    <DataGridTextColumn Width="180" Header="{l:Tr MoneyOut_EmployeeName}" Binding="{Binding EmployeeName}"/>
                    <DataGridTextColumn Width="110" Header="{l:Tr Assets_Period}" Binding="{Binding Period}"/>
                    <DataGridTextColumn Width="110" Header="{l:Tr MoneyOut_PayDate}" Binding="{Binding PayDate}"/>
                    <DataGridTextColumn Width="110" Header="{l:Tr MoneyOut_Reason}" Binding="{Binding Kind}"/>
                    <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding Amount}"/>
                    <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
                    <DataGridTextColumn Width="220" Header="{l:Tr Purchasing_Notes}" Binding="{Binding Notes}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
          </TabItem>
        </TabControl>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="PageControls" Grid.Column="1" Orientation="Horizontal" MinWidth="420">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Common_RowsPerPage}"/>
        <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="120" SelectedIndex="2" SelectionChanged="PageSize_OnChanged"><ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox>
        <StackPanel x:Name="ExpiryPager" Orientation="Horizontal" Margin="12,0,0,0">
          <Button x:Name="PreviousExpiryButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousExpiry_OnClick" Content="{l:Tr Sales_Previous}"/>
          <Button x:Name="NextExpiryButton" IsEnabled="False" Click="NextExpiry_OnClick" Content="{l:Tr Sales_Next}"/>
        </StackPanel>
        <StackPanel x:Name="DamagePager" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
          <Button x:Name="PreviousDamageButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousDamage_OnClick" Content="{l:Tr Sales_Previous}"/>
          <Button x:Name="NextDamageButton" IsEnabled="False" Click="NextDamage_OnClick" Content="{l:Tr Sales_Next}"/>
        </StackPanel>
        <StackPanel x:Name="ExpensePager" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
          <Button x:Name="PreviousExpenseButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousExpense_OnClick" Content="{l:Tr Sales_Previous}"/>
          <Button x:Name="NextExpenseButton" IsEnabled="False" Click="NextExpense_OnClick" Content="{l:Tr Sales_Next}"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</Page>
