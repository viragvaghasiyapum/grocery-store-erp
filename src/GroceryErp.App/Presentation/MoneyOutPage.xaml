<Page
    x:Class="GroceryErp.App.Presentation.MoneyOutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr MoneyOut_Title}" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European"
    ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <p:EntryStatusConverter x:Key="EntryStatus"/>
    <p:EmployeeStatusConverter x:Key="EmployeeStatus"/>
    <p:DamageReasonConverter x:Key="DamageReason"/>
  </Page.Resources>
  <Grid Margin="14,8,14,8">
    <TabControl x:Name="MoneyOutTabs" Style="{StaticResource PageTabs}" SelectionChanged="Tabs_OnSelectionChanged"
                AutomationProperties.Name="{l:Tr MoneyOut_Title}">
      <TabItem Header="{l:Tr MoneyOut_Damages}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <ui:TextBox x:Name="DamageSearch" Width="210" Margin="0,0,6,4" PlaceholderText="{l:Tr MoneyOut_DamageSearch}"
                        TextChanged="Search_OnTextChanged" AutomationProperties.Name="{l:Tr MoneyOut_DamageSearch}"/>
            <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr Reports_From}"/>
            <DatePicker x:Name="DamageFromBox" SelectedDateFormat="Short" Width="118" Margin="0,0,6,4" SelectedDateChanged="Date_OnChanged" AutomationProperties.Name="{l:Tr Reports_From}"/>
            <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr Reports_To}"/>
            <DatePicker x:Name="DamageToBox" SelectedDateFormat="Short" Width="118" Margin="0,0,6,4" SelectedDateChanged="Date_OnChanged" AutomationProperties.Name="{l:Tr Reports_To}"/>
            <ComboBox x:Name="DamageStatusFilter" Width="120" Margin="0,0,6,4" SelectedIndex="0" SelectionChanged="Filter_OnChanged" AutomationProperties.Name="{l:Tr Reports_Status}">
              <ComboBoxItem Tag="" Content="{l:Tr Purchasing_AnyStatus}"/>
              <ComboBoxItem Tag="ACTIVE" Content="{l:Tr MoneyOut_Status_ACTIVE}"/>
              <ComboBoxItem Tag="CORRECTED" Content="{l:Tr MoneyOut_Status_CORRECTED}"/>
              <ComboBoxItem Tag="VOID" Content="{l:Tr MoneyOut_Status_VOID}"/>
            </ComboBox>
            <ComboBox x:Name="DamageReasonFilter" Width="130" Margin="0,0,6,4" SelectedIndex="0" SelectionChanged="Filter_OnChanged" AutomationProperties.Name="{l:Tr MoneyOut_Reason}">
              <ComboBoxItem Tag="" Content="{l:Tr MoneyOut_AnyReason}"/>
              <ComboBoxItem Tag="EXPIRED" Content="{l:Tr MoneyOut_ReasonExpired}"/>
              <ComboBoxItem Tag="BROKEN" Content="{l:Tr MoneyOut_ReasonBroken}"/>
              <ComboBoxItem Tag="SPOILED" Content="{l:Tr MoneyOut_ReasonSpoiled}"/>
              <ComboBoxItem Tag="PEST" Content="{l:Tr MoneyOut_ReasonPest}"/>
              <ComboBoxItem Tag="LOST" Content="{l:Tr MoneyOut_ReasonLost}"/>
              <ComboBoxItem Tag="CUSTOMER_RETURN" Content="{l:Tr MoneyOut_ReasonReturn}"/>
              <ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/>
            </ComboBox>
            <Button Style="{StaticResource ToolbarButton}" Margin="0,0,0,4" Click="ClearFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
          </WrapPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="DamageGrid" SelectionChanged="DamageGrid_OnSelectionChanged"
                      AutomationProperties.Name="{l:Tr MoneyOut_Damages}">
              <DataGrid.Columns>
                <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Document}" Binding="{Binding DocumentNumber}"/>
                <DataGridTextColumn Width="108" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date, StringFormat=dd MMM yyyy}"/>
                <DataGridTextColumn Width="2*" MinWidth="150" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
                <DataGridTextColumn Width="90" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Width="100" Header="{l:Tr MoneyOut_Cost}" Binding="{Binding CostValue}"/>
                <DataGridTextColumn Width="100" Header="{l:Tr MoneyOut_Recovered}" Binding="{Binding RecoveredAmount}"/>
                <DataGridTextColumn Width="110" Header="{l:Tr MoneyOut_Reason}" Binding="{Binding Reason, Converter={StaticResource DamageReason}}"/>
                <DataGridTextColumn Width="100" Header="{l:Tr Reports_Status}" Binding="{Binding Status, Converter={StaticResource EntryStatus}}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="DamageEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{l:Tr MoneyOut_DamagesEmpty}"/>
            <p:CorrectionDetailsPanel x:Name="DamageDetails" Grid.Column="1" EditRequested="DamageDetails_OnEdit" VoidRequested="DamageDetails_OnVoid"/>
          </Grid>
          <p:PagerBar x:Name="DamagePager" Grid.Row="2"/>
        </Grid>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Expenses}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <ui:TextBox x:Name="ExpenseSearch" Width="210" Margin="0,0,6,4" PlaceholderText="{l:Tr MoneyOut_ExpenseSearch}"
                        TextChanged="Search_OnTextChanged" AutomationProperties.Name="{l:Tr MoneyOut_ExpenseSearch}"/>
            <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr Reports_From}"/>
            <DatePicker x:Name="ExpenseFromBox" SelectedDateFormat="Short" Width="118" Margin="0,0,6,4" SelectedDateChanged="Date_OnChanged" AutomationProperties.Name="{l:Tr Reports_From}"/>
            <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr Reports_To}"/>
            <DatePicker x:Name="ExpenseToBox" SelectedDateFormat="Short" Width="118" Margin="0,0,6,4" SelectedDateChanged="Date_OnChanged" AutomationProperties.Name="{l:Tr Reports_To}"/>
            <ComboBox x:Name="ExpenseCategoryFilter" Width="160" Margin="0,0,6,4" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="Filter_OnChanged" AutomationProperties.Name="{l:Tr Catalog_Category}"/>
            <ComboBox x:Name="ExpenseStatusFilter" Width="130" Margin="0,0,6,4" SelectedIndex="0" SelectionChanged="Filter_OnChanged" AutomationProperties.Name="{l:Tr Reports_Status}">
              <ComboBoxItem Tag="" Content="{l:Tr Purchasing_AnyStatus}"/>
              <ComboBoxItem Tag="ACTIVE" Content="{l:Tr MoneyOut_Status_ACTIVE}"/>
              <ComboBoxItem Tag="CORRECTED" Content="{l:Tr MoneyOut_Status_CORRECTED}"/>
              <ComboBoxItem Tag="VOID" Content="{l:Tr MoneyOut_Status_VOID}"/>
              <ComboBoxItem Tag="PURCHASE" Content="{l:Tr MoneyOut_Status_PURCHASE}"/>
            </ComboBox>
            <Button Style="{StaticResource ToolbarButton}" Margin="0,0,0,4" Click="ClearFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
          </WrapPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="ExpenseGrid" SelectionChanged="ExpenseGrid_OnSelectionChanged"
                      AutomationProperties.Name="{l:Tr MoneyOut_Expenses}">
              <DataGrid.Columns>
                <DataGridTextColumn Width="108" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date, StringFormat=dd MMM yyyy}"/>
                <DataGridTextColumn Width="*" MinWidth="140" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryName}"/>
                <DataGridTextColumn Width="110" Header="{l:Tr MoneyOut_Amount}" Binding="{Binding Amount}"/>
                <DataGridTextColumn Width="90" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
                <DataGridTextColumn Width="*" MinWidth="120" Header="{l:Tr MoneyOut_PaidTo}" Binding="{Binding PaidTo}"/>
                <DataGridTextColumn Width="110" Header="{l:Tr Reports_Status}" Binding="{Binding Status, Converter={StaticResource EntryStatus}}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ExpenseEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{l:Tr MoneyOut_ExpensesEmpty}"/>
            <p:CorrectionDetailsPanel x:Name="ExpenseDetails" Grid.Column="1" EditRequested="ExpenseDetails_OnEdit" VoidRequested="ExpenseDetails_OnVoid"/>
          </Grid>
          <p:PagerBar x:Name="ExpensePager" Grid.Row="2"/>
        </Grid>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_Employees}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <ui:TextBox x:Name="EmployeeSearch" Width="220" Margin="0,0,6,4" PlaceholderText="{l:Tr MoneyOut_EmployeeSearch}"
                        TextChanged="Search_OnTextChanged" AutomationProperties.Name="{l:Tr MoneyOut_EmployeeSearch}"/>
            <ComboBox x:Name="EmployeeStatusFilter" Width="130" Margin="0,0,6,4" SelectedIndex="0" SelectionChanged="Filter_OnChanged" AutomationProperties.Name="{l:Tr Reports_Status}">
              <ComboBoxItem Tag="ACTIVE" Content="{l:Tr MoneyOut_EmployeeWorking}"/>
              <ComboBoxItem Tag="INACTIVE" Content="{l:Tr MoneyOut_EmployeeRelieved}"/>
              <ComboBoxItem Tag="ALL" Content="{l:Tr Catalog_AnyStatus}"/>
            </ComboBox>
            <Button Style="{StaticResource ToolbarButton}" Margin="0,0,0,4" Click="ClearFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
          </WrapPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="EmployeeGrid" Style="{StaticResource CompactTableGrid}" SelectionChanged="EmployeeGrid_OnSelectionChanged"
                      MouseDoubleClick="EmployeeGrid_OnDoubleClick" AutomationProperties.Name="{l:Tr MoneyOut_Employees}">
              <DataGrid.Columns>
                <DataGridTextColumn Width="2*" MinWidth="160" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}"/>
                <DataGridTextColumn Width="*" MinWidth="100" Header="{l:Tr MoneyOut_Role}" Binding="{Binding Role}"/>
                <DataGridTextColumn Width="120" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding MonthlySalary}"/>
                <DataGridTextColumn Width="105" Header="{l:Tr MoneyOut_JoinDate}" Binding="{Binding JoinDate, StringFormat=dd MMM yyyy}"/>
                <DataGridTextColumn Width="105" Header="{l:Tr MoneyOut_LeaveDate}" Binding="{Binding LeaveDate, StringFormat=dd MMM yyyy}"/>
                <DataGridTextColumn Width="105" Header="{l:Tr Reports_Status}" Binding="{Binding IsActive, Converter={StaticResource EmployeeStatus}}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmployeeEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{l:Tr MoneyOut_EmployeesEmpty}"/>
            <p:CorrectionDetailsPanel x:Name="EmployeeDetails" Grid.Column="1"/>
          </Grid>
          <TextBlock x:Name="EmployeeStatus" Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource StatusText}"/>
        </Grid>
      </TabItem>
      <TabItem Header="{l:Tr MoneyOut_PostedPayments}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr Reports_From}"/>
            <TextBox x:Name="SalaryFromMonth" Width="80" Margin="0,0,6,4" MaxLength="7" ToolTip="YYYY-MM" TextChanged="Search_OnTextChanged"
                     AutomationProperties.Name="{l:Tr Reports_From}"/>
            <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr Reports_To}"/>
            <TextBox x:Name="SalaryToMonth" Width="80" Margin="0,0,6,4" MaxLength="7" ToolTip="YYYY-MM" TextChanged="Search_OnTextChanged"
                     AutomationProperties.Name="{l:Tr Reports_To}"/>
            <ComboBox x:Name="SalaryEmployeeFilter" Width="180" Margin="0,0,6,4" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="Filter_OnChanged" AutomationProperties.Name="{l:Tr MoneyOut_EmployeeName}"/>
            <ComboBox x:Name="SalaryStatusFilter" Width="120" Margin="0,0,6,4" SelectedIndex="0" SelectionChanged="Filter_OnChanged" AutomationProperties.Name="{l:Tr Reports_Status}">
              <ComboBoxItem Tag="" Content="{l:Tr Purchasing_AnyStatus}"/>
              <ComboBoxItem Tag="ACTIVE" Content="{l:Tr MoneyOut_Status_ACTIVE}"/>
              <ComboBoxItem Tag="CORRECTED" Content="{l:Tr MoneyOut_Status_CORRECTED}"/>
              <ComboBoxItem Tag="VOID" Content="{l:Tr MoneyOut_Status_VOID}"/>
            </ComboBox>
            <Button Style="{StaticResource ToolbarButton}" Margin="0,0,0,4" Click="ClearFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
          </WrapPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="SalaryRegisterGrid" SelectionChanged="SalaryRegisterGrid_OnSelectionChanged"
                      AutomationProperties.Name="{l:Tr MoneyOut_PostedPayments}">
              <DataGrid.Columns>
                <DataGridTextColumn Width="2*" MinWidth="150" Header="{l:Tr MoneyOut_EmployeeName}" Binding="{Binding EmployeeName}"/>
                <DataGridTextColumn Width="90" Header="{l:Tr Assets_Period}" Binding="{Binding Period}"/>
                <DataGridTextColumn Width="105" Header="{l:Tr MoneyOut_PayDate}" Binding="{Binding PayDate, StringFormat=dd MMM yyyy}"/>
                <DataGridTextColumn Width="95" Header="{l:Tr MoneyOut_Reason}" Binding="{Binding Kind}"/>
                <DataGridTextColumn Width="110" Header="{l:Tr MoneyOut_Salary}" Binding="{Binding Amount}"/>
                <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Mode}"/>
                <DataGridTextColumn Width="100" Header="{l:Tr Reports_Status}" Binding="{Binding Status, Converter={StaticResource EntryStatus}}"/>
                <DataGridTextColumn Width="*" MinWidth="120" Header="{l:Tr Purchasing_Notes}" Binding="{Binding Notes}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="SalaryEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{l:Tr MoneyOut_PaymentsEmpty}"/>
            <p:CorrectionDetailsPanel x:Name="SalaryDetails" Grid.Column="1" EditRequested="SalaryDetails_OnEdit" VoidRequested="SalaryDetails_OnVoid"/>
          </Grid>
          <TextBlock x:Name="SalaryStatus" Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource StatusText}"/>
        </Grid>
      </TabItem>
    </TabControl>
    <!-- The active tab's actions sit on the tab row's empty right side. -->
    <Grid x:Name="TabActions" Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0">
      <StackPanel x:Name="DamageActions" Orientation="Horizontal">
        <Button Style="{StaticResource ToolbarButton}" Margin="0" Click="RecordDamage_OnClick" Content="{l:Tr MoneyOut_RecordDamage}" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel x:Name="ExpenseActions" Orientation="Horizontal" Visibility="Collapsed">
        <Button Style="{StaticResource ToolbarButton}" Click="OpenAssets_OnClick" Content="{l:Tr MoneyOut_OpenAssets}"/>
        <Button Style="{StaticResource ToolbarButton}" Click="Categories_OnClick" Content="{l:Tr MoneyOut_CategoryDetails}"/>
        <Button Style="{StaticResource ToolbarButton}" Click="RepeatExpense_OnClick" Content="{l:Tr MoneyOut_RepeatLastMonth}"/>
        <Button Style="{StaticResource ToolbarButton}" Margin="0" Click="NewExpense_OnClick" Content="{l:Tr MoneyOut_NewExpense}" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel x:Name="EmployeeActions" Orientation="Horizontal" Visibility="Collapsed">
        <Button x:Name="EditEmployeeButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="EditEmployee_OnClick" Content="{l:Tr Catalog_Edit}"/>
        <Button Style="{StaticResource ToolbarButton}" Margin="0" Click="NewEmployee_OnClick" Content="{l:Tr MoneyOut_NewEmployee}" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel x:Name="SalaryActions" Orientation="Horizontal" Visibility="Collapsed">
        <Button Style="{StaticResource ToolbarButton}" Click="RecordAdvance_OnClick" Content="{l:Tr MoneyOut_RecordAdvance}"/>
        <Button Style="{StaticResource ToolbarButton}" Margin="0" Click="PrepareSalary_OnClick" Content="{l:Tr MoneyOut_PrepareSalary}" FontWeight="SemiBold"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
