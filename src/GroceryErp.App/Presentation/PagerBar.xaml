<UserControl x:Class="GroceryErp.App.Presentation.PagerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Focusable="False" VerticalAlignment="Center">
  <!-- Sits in the page's title row: the status line takes the free width and the page arrows
       follow it, so the table below runs to the bottom edge. -->
  <DockPanel>
    <StackPanel x:Name="PageControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                Visibility="Collapsed">
      <Button x:Name="PreviousButton" Style="{StaticResource PagerButton}" IsEnabled="False" Click="Previous_OnClick"
              Content="{ui:SymbolIcon ChevronLeft20}" ToolTip="{l:Tr Pager_PreviousHint}"
              AutomationProperties.Name="{l:Tr Pager_PreviousHint}"/>
      <TextBlock x:Name="PageText" Style="{StaticResource StatusText}" Margin="8,0"/>
      <Button x:Name="NextButton" Style="{StaticResource PagerButton}" Margin="0,0,12,0" IsEnabled="False" Click="Next_OnClick"
              Content="{ui:SymbolIcon ChevronRight20}" ToolTip="{l:Tr Pager_NextHint}"
              AutomationProperties.Name="{l:Tr Pager_NextHint}"/>
    </StackPanel>
    <TextBlock x:Name="StatusLine" Style="{StaticResource StatusText}" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"
               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </DockPanel>
</UserControl>
