<UserControl x:Class="GroceryErp.App.Presentation.PagerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Focusable="False">
  <DockPanel Margin="0,6,0,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="PageText" Style="{StaticResource StatusText}" Margin="12,0,8,0"/>
      <Button x:Name="PreviousButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="Previous_OnClick"
              Content="{l:Tr Sales_Previous}" ToolTip="{l:Tr Pager_PreviousHint}"/>
      <Button x:Name="NextButton" Style="{StaticResource ToolbarButton}" Margin="0" IsEnabled="False" Click="Next_OnClick"
              Content="{l:Tr Sales_Next}" ToolTip="{l:Tr Pager_NextHint}"/>
    </StackPanel>
    <TextBlock x:Name="StatusLine" Style="{StaticResource StatusText}" AutomationProperties.LiveSetting="Polite"
               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </DockPanel>
</UserControl>
