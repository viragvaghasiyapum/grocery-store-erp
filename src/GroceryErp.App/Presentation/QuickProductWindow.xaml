<Window x:Class="GroceryErp.App.Presentation.QuickProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr Pos_QuickAdd}" Width="650" Height="560" MinWidth="580" MinHeight="500"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="quick-product">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr Pos_QuickAdd}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Pos_QuickProductHint}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="Fields">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <p:FormField Grid.ColumnSpan="2" Margin="0,0,0,10" Label="{l:Tr Catalog_Barcodes}"><TextBox x:Name="BarcodeBox" IsReadOnly="True"/></p:FormField>
        <p:FormField x:Name="SkuField" Grid.Row="1" Label="{l:Tr Catalog_Sku}" IsRequired="True"><TextBox x:Name="SkuBox" IsReadOnly="True"/></p:FormField>
        <p:FormField x:Name="NameField" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Label="{l:Tr Catalog_Name}" IsRequired="True">
          <TextBox x:Name="NameBox" MaxLength="120"/>
        </p:FormField>
        <p:FormField x:Name="CategoryField" Grid.Row="2" Label="{l:Tr Catalog_Category}" IsRequired="True">
          <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </p:FormField>
        <p:FormField x:Name="UnitField" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Label="{l:Tr Catalog_Unit}" IsRequired="True">
          <ComboBox x:Name="UnitBox" DisplayMemberPath="Code" SelectedValuePath="Id"/>
        </p:FormField>
        <p:FormField x:Name="PriceField" Grid.Row="3" Label="{l:Tr Catalog_SellingPrice}" IsRequired="True"><TextBox x:Name="PriceBox"/></p:FormField>
        <p:FormField x:Name="MrpField" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Label="{l:Tr Catalog_Mrp}"><TextBox x:Name="MrpBox"/></p:FormField>
        <p:FormField x:Name="TaxField" Grid.Row="4" Label="{l:Tr Catalog_TaxRate}" IsRequired="True">
          <ComboBox x:Name="TaxBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </p:FormField>
        <p:FormField x:Name="HsnField" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Label="{l:Tr Catalog_Hsn}">
          <TextBox x:Name="HsnBox" MaxLength="8"/>
        </p:FormField>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveButton" IsEnabled="False" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Pos_QuickAdd}"/>
    </StackPanel>
  </Grid>
</Window>
