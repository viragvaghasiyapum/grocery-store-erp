<Window x:Class="GroceryErp.App.Presentation.QuickProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Pos_QuickAdd}" Width="650" Height="560" MinWidth="580" MinHeight="500"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Pos_QuickAdd}"/>
        <TextBlock Margin="0,6,0,16" Opacity="0.7" Text="{l:Tr Pos_QuickProductHint}" TextWrapping="Wrap"/>
        <TextBlock Text="{l:Tr Catalog_Barcodes}"/>
        <TextBox x:Name="BarcodeBox" IsReadOnly="True"/>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{l:Tr Catalog_Sku}"/>
            <TextBox x:Name="SkuBox" IsReadOnly="True"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{l:Tr Catalog_Name}"/>
            <TextBox x:Name="NameBox" MaxLength="120"/>
          </StackPanel>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{l:Tr Catalog_Category}"/>
            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{l:Tr Catalog_Unit}"/>
            <ComboBox x:Name="UnitBox" DisplayMemberPath="Code" SelectedValuePath="Id"/>
          </StackPanel>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{l:Tr Catalog_SellingPrice}"/>
            <TextBox x:Name="PriceBox"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{l:Tr Catalog_Mrp}"/>
            <TextBox x:Name="MrpBox"/>
          </StackPanel>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{l:Tr Catalog_TaxRate}"/>
            <ComboBox x:Name="TaxBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{l:Tr Catalog_Hsn}"/>
            <TextBox x:Name="HsnBox" MaxLength="8"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="Crimson" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveButton" IsEnabled="False" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Pos_QuickAdd}"/>
    </StackPanel>
  </Grid>
</Window>
