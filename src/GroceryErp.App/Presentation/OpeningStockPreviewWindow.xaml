<Window x:Class="GroceryErp.App.Presentation.OpeningStockPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Stock_OpeningPreview}" Width="940" Height="610" MinWidth="740" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{l:Tr Stock_OpeningPreview}"/>
      <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <DataGrid x:Name="RowsGrid" Grid.Row="1" Style="{StaticResource CatalogGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="70" Header="{l:Tr Catalog_Row}" Binding="{Binding RowNumber}"/>
        <DataGridTextColumn Width="180" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Stock_UnitCost}" Binding="{Binding PurchasePrice}"/>
        <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Price}" Binding="{Binding SellingPrice}"/>
        <DataGridTextColumn Width="300" Header="{l:Tr Catalog_ImportErrors}" Binding="{Binding ErrorText}"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Margin="0,0,8,0" Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="ImportButton" Click="Import_OnClick" Content="{l:Tr Stock_ImportReviewed}"/>
    </StackPanel>
  </Grid>
</Window>
