<Window x:Class="GroceryErp.App.Presentation.AssetDisposalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr Assets_Dispose}" Width="480" Height="400" MinHeight="360"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="asset-disposal">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr Assets_Dispose}"/>
      </DockPanel>
      <TextBlock x:Name="AssetText" Style="{StaticResource FormContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <StackPanel x:Name="Fields" Grid.Row="2" Margin="0,8,0,0">
      <UniformGrid Columns="2">
        <p:FormField x:Name="DateField" Label="{l:Tr Assets_DisposalDate}" IsRequired="True"><DatePicker x:Name="DisposalDate" SelectedDateFormat="Short"/></p:FormField>
        <p:FormField x:Name="ProceedsField" Label="{l:Tr Assets_Proceeds}" IsRequired="True"><TextBox x:Name="DisposalValue" Text="0"/></p:FormField>
      </UniformGrid>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Assets_DisposalContext}"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="DisposeButton" Click="Dispose_OnClick" Content="{l:Tr Assets_Dispose}"/>
    </StackPanel>
  </Grid>
</Window>
