<Window x:Class="GroceryErp.App.Presentation.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Stock_Adjust}" Width="430" Height="330" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock x:Name="LotText" FontWeight="SemiBold" Margin="0,0,0,14"/>
    <TextBlock Text="{l:Tr Stock_AdjustQuantity}"/><TextBox x:Name="QuantityBox" Margin="0,4,0,10" ToolTip="Use a negative number to reduce stock"/>
    <TextBlock Text="{l:Tr Stock_Reason}"/><TextBox x:Name="ReasonBox" Margin="0,4,0,10"/>
    <TextBlock x:Name="ErrorText" Foreground="Crimson" TextWrapping="Wrap"/>
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,16,0,0"><Button Margin="0,0,8,0" Click="Save_OnClick" Content="{l:Tr Common_Save}"/><Button Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/></StackPanel>
  </StackPanel>
</Window>
