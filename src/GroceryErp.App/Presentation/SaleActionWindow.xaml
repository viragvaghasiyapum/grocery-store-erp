<Window x:Class="GroceryErp.App.Presentation.SaleActionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 xmlns:p="clr-namespace:GroceryErp.App.Presentation"
 Title="{l:Tr Sales_Action}" Width="1100" Height="620" MinWidth="900" MinHeight="460" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
 NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
 <Grid x:Name="LayoutGrid" Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <DockPanel>
    <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
    <TextBlock x:Name="TitleText" Style="{StaticResource FormTitle}"/>
   </DockPanel>
   <TextBlock x:Name="ContextText" Style="{StaticResource FormContext}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
  </StackPanel>
  <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
  <Grid x:Name="Fields" Grid.Row="2" Margin="0,8,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <p:FormField x:Name="ReasonField" Label="{l:Tr Stock_Reason}" IsRequired="True">
    <TextBox x:Name="ReasonBox" MaxLength="240"/>
   </p:FormField>
   <p:FormField x:Name="RefundModeField" Grid.Column="1" Width="190" Margin="0,0,0,10" Label="{l:Tr Sales_RefundMode}">
    <ComboBox x:Name="RefundModeBox" SelectedIndex="0">
     <ComboBoxItem Content="{l:Tr Receipt_RefundModeCash}" Tag="Cash"/>
     <ComboBoxItem Content="{l:Tr Receipt_RefundModeUpi}" Tag="Upi"/>
     <ComboBoxItem Content="{l:Tr Receipt_RefundModeCard}" Tag="Card"/>
    </ComboBox>
   </p:FormField>
  </Grid>
  <Grid x:Name="ReturnFields" Grid.Row="3">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,6">
    <Button DockPanel.Dock="Right" Click="ReturnAll_OnClick" Content="{l:Tr Sales_ReturnAll}"/>
    <TextBlock Style="{StaticResource FormSection}" Margin="0" VerticalAlignment="Center" Text="{l:Tr Sales_ReturnLine}"/>
   </DockPanel>
   <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="ReturnGrid" Grid.Row="1" AutoGenerateColumns="False"
             CanUserAddRows="False" IsReadOnly="False" RowHeight="34" AutomationProperties.Name="{l:Tr Sales_ReturnLine}">
    <DataGrid.Columns>
     <DataGridTextColumn Width="*" MinWidth="150" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}" IsReadOnly="True"/>
     <DataGridTextColumn Width="92" Header="{l:Tr Stock_LotCode}" Binding="{Binding Lot}" IsReadOnly="True"/>
     <DataGridTextColumn Width="90" Header="{l:Tr Stock_Expiry}" Binding="{Binding Expiry}" IsReadOnly="True"/>
     <DataGridTextColumn Width="70" Header="{l:Tr Sales_ReturnSoldHeader}" Binding="{Binding Sold}" IsReadOnly="True"/>
     <DataGridTextColumn Width="96" Header="{l:Tr Sales_ReturnAlreadyHeader}" Binding="{Binding AlreadyReturned}" IsReadOnly="True"/>
     <DataGridTextColumn Width="92" Header="{l:Tr Sales_ReturnRemainingHeader}" Binding="{Binding Remaining}" IsReadOnly="True"/>
     <DataGridTextColumn Width="90" Header="{l:Tr Sales_ReturnQtyHeader}" Binding="{Binding QuantityText,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Width="86" Header="{l:Tr Sales_ReturnRefundHeader}" Binding="{Binding RefundPreview}" IsReadOnly="True"/>
     <DataGridCheckBoxColumn Width="108" Header="{l:Tr Sales_ResellableShort}" Binding="{Binding Resellable,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Width="120" Header="{l:Tr Sales_ReturnRestockHeader}" Binding="{Binding RestockDisposition}" IsReadOnly="True"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <DockPanel Grid.Row="4" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Style="{StaticResource FormFooter}" Margin="0">
    <Button Width="96" Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
    <Button x:Name="ConfirmButton" MinWidth="110" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Sales_Confirm}"/>
   </StackPanel>
   <TextBlock x:Name="TotalText" Style="{StaticResource FormPreview}" Margin="0,0,12,0" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</Window>
