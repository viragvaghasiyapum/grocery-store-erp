<Window x:Class="GroceryErp.App.Presentation.SaleActionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 Title="{l:Tr Sales_Action}" Width="1100" Height="600" MinWidth="900" MinHeight="440" WindowStartupLocation="CenterOwner"
 NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
 <Grid x:Name="LayoutGrid" Margin="18,14,18,14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock x:Name="ContextText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
  <Grid Grid.Row="1" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Margin="0,0,0,4"><Run Text="{l:Tr Stock_Reason}"/><Run Text=" *" Foreground="Firebrick"/></TextBlock>
    <TextBox x:Name="ReasonBox" Height="34" VerticalContentAlignment="Center" MaxLength="240"
             AutomationProperties.Name="{l:Tr Stock_Reason}"/>
   </StackPanel>
   <StackPanel x:Name="RefundModePanel" Grid.Column="1" Width="190" Margin="12,0,0,0">
    <TextBlock Margin="0,0,0,4" Text="{l:Tr Sales_RefundMode}"/>
    <ComboBox x:Name="RefundModeBox" Height="34" SelectedIndex="0" AutomationProperties.Name="{l:Tr Sales_RefundMode}">
     <ComboBoxItem Content="{l:Tr Sales_CashLabel}" Tag="Cash"/>
     <ComboBoxItem Content="{l:Tr Sales_UpiLabel}" Tag="Upi"/>
     <ComboBoxItem Content="{l:Tr Sales_CardLabel}" Tag="Card"/>
    </ComboBox>
   </StackPanel>
  </Grid>
  <Grid x:Name="ReturnFields" Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,6">
    <Button DockPanel.Dock="Right" Click="ReturnAll_OnClick" Content="{l:Tr Sales_ReturnAll}"/>
    <TextBlock VerticalAlignment="Center" Text="{l:Tr Sales_ReturnLine}"/>
   </DockPanel>
   <DataGrid Style="{StaticResource CompactTableGrid}" x:Name="ReturnGrid" Grid.Row="1" AutoGenerateColumns="False"
             CanUserAddRows="False" IsReadOnly="False" RowHeight="34" AutomationProperties.Name="{l:Tr Sales_ReturnLine}">
    <DataGrid.Columns>
     <DataGridTextColumn Width="*" MinWidth="150" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}" IsReadOnly="True"/>
     <DataGridTextColumn Width="92" Header="{l:Tr Stock_LotCode}" Binding="{Binding Lot}" IsReadOnly="True"/>
     <DataGridTextColumn Width="90" Header="{l:Tr Stock_Expiry}" Binding="{Binding Expiry}" IsReadOnly="True"/>
     <DataGridTextColumn Width="70" Header="{l:Tr Sales_ReturnSoldHeader}" Binding="{Binding Sold}" IsReadOnly="True"/>
     <DataGridTextColumn Width="96" Header="{l:Tr Sales_ReturnAlreadyHeader}" Binding="{Binding AlreadyReturned}" IsReadOnly="True"/>
     <DataGridTextColumn Width="92" Header="{l:Tr Sales_ReturnRemainingHeader}" Binding="{Binding Remaining}" IsReadOnly="True"/>
     <DataGridTextColumn Width="90" Header="{l:Tr Sales_ReturnQtyHeader}" Binding="{Binding QuantityText,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Width="86" Header="{l:Tr Sales_ReturnRefundHeader}" Binding="{Binding RefundPreview}" IsReadOnly="True"/>
     <DataGridCheckBoxColumn Width="108" Header="{l:Tr Sales_ResellableShort}" Binding="{Binding Resellable,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Width="120" Header="{l:Tr Sales_ReturnRestockHeader}" Binding="{Binding RestockDisposition}" IsReadOnly="True"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <Grid Grid.Row="3" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <TextBlock x:Name="TotalText" Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
   <Button Width="96" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
   <Button x:Name="ConfirmButton" Width="110" Margin="8,0,0,0" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Sales_Confirm}"/>
  </StackPanel>
 </Grid>
</Window>
