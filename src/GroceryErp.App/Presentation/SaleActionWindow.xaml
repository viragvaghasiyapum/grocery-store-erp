<Window x:Class="GroceryErp.App.Presentation.SaleActionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 Title="{l:Tr Sales_Action}" Width="440" Height="320" WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="{l:Tr Stock_Reason}"/>
  <TextBox x:Name="ReasonBox" Grid.Row="1" Margin="0,6,0,12"/>
  <StackPanel x:Name="ReturnFields" Grid.Row="2">
   <ComboBox x:Name="LineBox" DisplayMemberPath="ProductName" SelectionChanged="LineBox_OnSelectionChanged"/>
   <TextBox x:Name="QuantityBox" Margin="0,8,0,0"/>
   <CheckBox x:Name="ResellableBox" Margin="0,8,0,0" IsChecked="True" Content="{l:Tr Sales_Resellable}"/>
  </StackPanel>
  <StackPanel Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal">
   <Button Width="90" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
   <Button Width="90" Margin="8,0,0,0" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Sales_Confirm}"/>
  </StackPanel>
 </Grid>
</Window>
