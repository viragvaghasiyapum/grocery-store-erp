<UserControl x:Class="GroceryErp.App.Presentation.VendorLedgerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <!-- A vendor's purchases, payments, returns, ledger and lots supplied, in the Vendors detail panel.
       Each tab keeps its own page; the footer pages the open tab. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Style="{StaticResource FormContext}" Margin="0,0,0,8" Text="{l:Tr Purchasing_LedgerHint}"/>
    <TabControl x:Name="HistoryTabs" Grid.Row="1" SelectionChanged="HistoryTabs_OnSelectionChanged">
      <TabItem Header="{l:Tr Purchasing_Purchases}">
        <DataGrid x:Name="PurchasesGrid" Style="{StaticResource CompactTableGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="140" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date, StringFormat=dd MMM yyyy}"/>
            <DataGridTextColumn Width="230" Header="{l:Tr Purchasing_Document}" Binding="{Binding Reference}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Total}" Binding="{Binding Debit}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Balance}" Binding="{Binding Balance}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_Payments}">
        <DataGrid x:Name="PaymentsGrid" Style="{StaticResource CompactTableGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="140" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date, StringFormat=dd MMM yyyy}"/>
            <DataGridTextColumn Width="230" Header="{l:Tr Purchasing_Reference}" Binding="{Binding Reference}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Amount}" Binding="{Binding Credit}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Balance}" Binding="{Binding Balance}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_VendorReturns}">
        <DataGrid x:Name="ReturnsGrid" Style="{StaticResource CompactTableGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="140" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date, StringFormat=dd MMM yyyy}"/>
            <DataGridTextColumn Width="230" Header="{l:Tr Purchasing_Document}" Binding="{Binding Reference}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Credit}" Binding="{Binding Credit}"/>
            <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Balance}" Binding="{Binding Balance}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_VendorLedger}">
        <DataGrid x:Name="LedgerGrid" Style="{StaticResource CompactTableGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date, StringFormat=dd MMM yyyy}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Kind}"/>
            <DataGridTextColumn Width="180" Header="{l:Tr Purchasing_Document}" Binding="{Binding Reference}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Debit}" Binding="{Binding Debit}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Credit}" Binding="{Binding Credit}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Balance}" Binding="{Binding Balance}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Purchasing_LotsSupplied}">
        <DataGrid x:Name="LotsGrid" Style="{StaticResource CompactTableGrid}" FrozenColumnCount="1">
          <DataGrid.Columns>
            <DataGridTextColumn Width="240" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchNumber}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Received}" Binding="{Binding ReceivedDate, StringFormat=dd MMM yyyy}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate, StringFormat=dd MMM yyyy}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_OnHand}" Binding="{Binding OnHand}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <p:PagerBar x:Name="LedgerPager" Grid.Row="2"/>
  </Grid>
</UserControl>
