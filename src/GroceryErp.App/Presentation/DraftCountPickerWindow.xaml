<Window x:Class="GroceryErp.App.Presentation.DraftCountPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Stock_Count}" Width="620" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="DraftGrid" Style="{StaticResource CatalogGrid}" SelectionMode="Single"
              MouseDoubleClick="DraftGrid_OnDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Width="80" Header="ID" Binding="{Binding Id}"/>
        <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_Date}" Binding="{Binding Date}"/>
        <DataGridTextColumn Width="120" Header="{l:Tr Stock_Lots}" Binding="{Binding LotCount}"/>
        <DataGridTextColumn Width="120" Header="{l:Tr Stock_Counted}" Binding="{Binding CountedCount}"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <TextBlock x:Name="ErrorText" Foreground="Crimson" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PreviousButton" IsEnabled="False" Click="Previous_OnClick" Content="{l:Tr Sales_Previous}" Margin="0,0,8,0"/>
        <Button x:Name="NextButton" IsEnabled="False" Click="Next_OnClick" Content="{l:Tr Sales_Next}" Margin="0,0,8,0"/>
        <Button Click="Open_OnClick" Content="{l:Tr Common_Open}" Margin="0,0,8,0"/>
        <Button Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
