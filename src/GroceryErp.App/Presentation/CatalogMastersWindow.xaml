<Window
    x:Class="GroceryErp.App.Presentation.CatalogMastersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Catalog_Masters}" Width="720" Height="560" MinWidth="620" MinHeight="480"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl>
      <TabItem Header="{l:Tr Catalog_Categories}">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
          <ListBox x:Name="CategoryList" DisplayMemberPath="Name" SelectionChanged="CategoryList_OnSelectionChanged" />
          <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{l:Tr Catalog_Category}" />
            <TextBlock Margin="0,12,0,0" Text="{l:Tr Catalog_Name}" />
            <TextBox x:Name="CategoryNameBox" MaxLength="80" />
            <TextBlock Margin="0,10,0,0" Text="{l:Tr Catalog_NameLocal}" />
            <TextBox x:Name="CategoryLocalBox" MaxLength="80" />
            <TextBlock Margin="0,10,0,0" Text="{l:Tr Catalog_ParentCategory}" />
            <ComboBox x:Name="ParentCategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
            <TextBlock Margin="0,10,0,0" Text="{l:Tr Catalog_ExpiryAlertDays}" />
            <TextBox x:Name="CategoryExpiryBox" />
            <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Margin="0,0,8,0" Click="NewCategory_OnClick" Content="{l:Tr Catalog_Clear}" />
              <Button Click="SaveCategory_OnClick" Content="{l:Tr Common_Save}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{l:Tr Catalog_Brands}">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
          <ListBox x:Name="BrandList" DisplayMemberPath="Name" SelectionChanged="BrandList_OnSelectionChanged" />
          <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{l:Tr Catalog_Brand}" />
            <TextBlock Margin="0,12,0,0" Text="{l:Tr Catalog_Name}" />
            <TextBox x:Name="BrandNameBox" MaxLength="80" />
            <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Margin="0,0,8,0" Click="NewBrand_OnClick" Content="{l:Tr Catalog_Clear}" />
              <Button Click="SaveBrand_OnClick" Content="{l:Tr Common_Save}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{l:Tr Catalog_Units}">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
          <ListBox x:Name="UnitList" DisplayMemberPath="Name" SelectionChanged="UnitList_OnSelectionChanged" />
          <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{l:Tr Catalog_Unit}" />
            <TextBlock Margin="0,12,0,0" Text="{l:Tr Catalog_UnitCode}" />
            <TextBox x:Name="UnitCodeBox" MaxLength="10" />
            <TextBlock Margin="0,10,0,0" Text="{l:Tr Catalog_Name}" />
            <TextBox x:Name="UnitNameBox" MaxLength="60" />
            <TextBlock Margin="0,10,0,0" Text="{l:Tr Catalog_NameLocal}" />
            <TextBox x:Name="UnitLocalBox" MaxLength="60" />
            <CheckBox x:Name="UnitFractionBox" Margin="0,12,0,0" Content="{l:Tr Catalog_AllowFraction}" />
            <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Margin="0,0,8,0" Click="NewUnit_OnClick" Content="{l:Tr Catalog_Clear}" />
              <Button Click="SaveUnit_OnClick" Content="{l:Tr Common_Save}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{l:Tr Catalog_TaxRates}">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
          <ListBox x:Name="TaxList" DisplayMemberPath="Name" SelectionChanged="TaxList_OnSelectionChanged" />
          <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{l:Tr Catalog_TaxRate}" />
            <TextBlock Margin="0,12,0,0" Text="{l:Tr Catalog_Name}" />
            <TextBox x:Name="TaxNameBox" MaxLength="60" />
            <TextBlock Margin="0,10,0,0" Text="{l:Tr Catalog_TaxPercent}" />
            <TextBox x:Name="TaxRateValueBox" />
            <CheckBox x:Name="TaxActiveBox" Margin="0,12,0,0" IsChecked="True" Content="{l:Tr Catalog_Active}" />
            <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Margin="0,0,8,0" Click="NewTax_OnClick" Content="{l:Tr Catalog_Clear}" />
              <Button Click="SaveTax_OnClick" Content="{l:Tr Common_Save}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Foreground="Crimson" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button HorizontalAlignment="Right" IsCancel="True" Content="{l:Tr Common_Close}" />
    </Grid>
  </Grid>
</Window>
