<Window x:Class="GroceryErp.App.Presentation.ReleaseNotesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr ReleaseNotes_Title}"
    Width="560" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="VersionText" Style="{StaticResource FormTitle}"/>
    <ScrollViewer x:Name="NotesScroll" Grid.Row="1" Margin="0,10,0,0" Focusable="False"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="0,0,8,0"/>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Style="{StaticResource FormFooter}">
      <Button x:Name="CloseButton" MinWidth="96" IsDefault="True" IsCancel="True" Click="Close_OnClick"
              Content="{l:Tr Common_Close}"/>
    </StackPanel>
  </Grid>
</Window>
