<Window x:Class="GroceryErp.App.Presentation.AssetFormWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr Assets_Details}" Width="620" Height="640" MinWidth="500" MinHeight="480"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="asset-form">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="TitleText" Style="{StaticResource FormTitle}" Text="{l:Tr Assets_New}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Assets_FormContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Fields" Margin="0,0,10,0">
        <UniformGrid Columns="2">
          <p:FormField x:Name="NameField" Label="{l:Tr Catalog_Name}" IsRequired="True"><TextBox x:Name="AssetName" MaxLength="120"/></p:FormField>
          <p:FormField x:Name="CategoryField" Label="{l:Tr Catalog_Category}" IsRequired="True">
            <ComboBox x:Name="AssetCategory" SelectedIndex="0" SelectionChanged="AssetCategory_OnSelectionChanged">
              <ComboBoxItem Tag="Furniture" Content="{l:Tr Assets_Furniture}"/>
              <ComboBoxItem Tag="Equipment" Content="{l:Tr Assets_Equipment}"/>
              <ComboBoxItem Tag="Electronics" Content="{l:Tr Assets_Electronics}"/>
              <ComboBoxItem Tag="Vehicle" Content="{l:Tr Assets_Vehicle}"/>
              <ComboBoxItem Tag="Other" Content="{l:Tr Assets_Other}"/>
            </ComboBox>
          </p:FormField>
          <p:FormField x:Name="PurchaseField" Label="{l:Tr Assets_PurchaseDate}" IsRequired="True"><DatePicker x:Name="PurchaseDate" SelectedDateFormat="Short"/></p:FormField>
          <p:FormField x:Name="InUseField" Label="{l:Tr Assets_InUseDate}" IsRequired="True"><DatePicker x:Name="InUseDate" SelectedDateFormat="Short" SelectedDateChanged="AssetTerms_OnChanged"/></p:FormField>
          <p:FormField x:Name="CostField" Label="{l:Tr Assets_Cost}" IsRequired="True"><TextBox x:Name="AssetCost" TextChanged="AssetTerms_OnChanged"/></p:FormField>
          <p:FormField x:Name="MethodField" Label="{l:Tr Assets_Method}" IsRequired="True">
            <ComboBox x:Name="AssetMethod" SelectedIndex="0" SelectionChanged="AssetTerms_OnChanged">
              <ComboBoxItem Tag="WDV" Content="WDV"/><ComboBoxItem Tag="SLM" Content="SLM"/>
            </ComboBox>
          </p:FormField>
          <p:FormField x:Name="RateField" Label="{l:Tr Assets_Rate}" IsRequired="True"><TextBox x:Name="AssetRate" Text="10" TextChanged="AssetTerms_OnChanged"/></p:FormField>
          <p:FormField x:Name="SalvageField" Label="{l:Tr Assets_Salvage}" IsRequired="True"><TextBox x:Name="AssetSalvage" Text="0" TextChanged="AssetTerms_OnChanged"/></p:FormField>
          <p:FormField x:Name="EffectiveField" Label="{l:Tr Assets_EffectiveFrom}" IsRequired="True" Hint="YYYY-MM" Visibility="Collapsed">
            <TextBox x:Name="AssetEffectiveFrom" MaxLength="7" TextChanged="AssetTerms_OnChanged"/>
          </p:FormField>
          <p:FormField x:Name="VendorField" Label="{l:Tr Purchasing_Vendor}"><ComboBox x:Name="AssetVendor" DisplayMemberPath="Name" SelectedValuePath="Id"/></p:FormField>
        </UniformGrid>
        <p:FormField Label="{l:Tr Purchasing_Notes}"><TextBox x:Name="AssetNotes" MaxLength="500"/></p:FormField>
        <TextBlock x:Name="AssetFinancialLockText" Style="{StaticResource FormPreview}" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveAssetButton" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Common_Save}"/>
    </StackPanel>
  </Grid>
</Window>
