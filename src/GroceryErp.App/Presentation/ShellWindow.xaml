<ui:FluentWindow
    x:Class="GroceryErp.App.Presentation.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:local="clr-namespace:GroceryErp.App.Presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr App_Title}"
    Width="1180"
    Height="760"
    MinWidth="960"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override"
    NumberSubstitution.CultureOverride="en-IN"
    NumberSubstitution.Substitution="European"
    mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="20,10" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="StoreHeading" FontSize="18" FontWeight="SemiBold" Text="{l:Tr App_Title}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="BusinessDate" FontSize="12" Opacity="0.72"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
          <Border x:Name="PrinterStatusBadge" Margin="0,0,8,0" Padding="8,4" CornerRadius="5"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  VerticalAlignment="Center">
            <TextBlock x:Name="PrinterStatusText" FontSize="12" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
          </Border>
          <Border x:Name="ScannerStatusBadge" Margin="0,0,8,0" Padding="8,4" CornerRadius="5"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  VerticalAlignment="Center">
            <TextBlock x:Name="ScannerStatusText" FontSize="12" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
          </Border>
          <Button x:Name="BackupStatusButton" Margin="0,0,8,0" Click="BackupStatus_OnClick" Content="{l:Tr Settings_NoBackup}"/>
          <Button x:Name="UpdateButton" Margin="0,0,8,0" Click="Update_OnClick" Content="{l:Tr Settings_Update_CheckFolder}" />
          <Button x:Name="LockButton" Margin="0,0,8,0" Click="Lock_OnClick" Content="{l:Tr Lock_Command}" />
          <Button Margin="0,0,6,0" Command="{Binding UseEnglishCommand}" Content="EN" ToolTip="{l:Tr Shell_English}" />
          <Button Command="{Binding UseGujaratiCommand}" Content="ગુ" ToolTip="{l:Tr Shell_Gujarati}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="MaintenanceWarning" Grid.Row="1" Visibility="Collapsed"
            Padding="16,10" Background="{x:Static SystemColors.InfoBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Click="BackupStatus_OnClick"
                Content="{l:Tr Settings_Title}"/>
        <TextBlock VerticalAlignment="Center" Foreground="{x:Static SystemColors.InfoTextBrush}"
                   Text="{l:Tr Startup_MaintenanceFailed}" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <ui:NavigationView
        x:Name="RootNavigation"
        Grid.Row="2"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        OpenPaneLength="220"
        PaneDisplayMode="Left">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem
            Content="{l:Tr Dashboard_Navigation}"
            Icon="{ui:SymbolIcon Home24}"
            TargetPageType="{x:Type local:DashboardPage}" />
      </ui:NavigationView.MenuItems>
    </ui:NavigationView>

    <Border x:Name="LockOverlay" Grid.RowSpan="3" Panel.ZIndex="20" Background="#F7F8FA" Visibility="Collapsed">
      <StackPanel Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Lock_Title}" />
        <TextBlock Margin="0,10,0,18" Text="{l:Tr Lock_Body}" TextWrapping="Wrap" />
        <PasswordBox x:Name="UnlockPassword" Height="36" KeyDown="UnlockPassword_OnKeyDown" />
        <Button Margin="0,12,0,0" Click="Unlock_OnClick" Content="{l:Tr Lock_Action}" />
        <TextBlock x:Name="LockError" Margin="0,10,0,0" Foreground="Crimson" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
