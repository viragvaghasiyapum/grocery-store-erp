<ui:FluentWindow
    x:Class="GroceryErp.App.Presentation.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:local="clr-namespace:GroceryErp.App.Presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr App_Title}"
    Width="1180"
    Height="760"
    MinWidth="960"
    MinHeight="640"
    WindowState="Maximized"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override"
    NumberSubstitution.CultureOverride="en-IN"
    NumberSubstitution.Substitution="European"
    mc:Ignorable="d">
  <DockPanel>
    <!-- One row above every page: the brand and business date, the device and backup status, then
         the window buttons. Both content areas stay clickable; the rest of the bar drags the window. -->
    <ui:TitleBar x:Name="ShellTitleBar" DockPanel.Dock="Top" Title="{l:Tr App_Title}" Height="44">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Image Width="28" Height="28" Margin="0,0,8,0"
                 Source="/GroceryErp.App;component/Assets/logo.jpeg" Stretch="Uniform"/>
          <TextBlock x:Name="StoreHeading" FontSize="15" FontWeight="SemiBold" Text="Hare Krushna"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="220"/>
          <TextBlock x:Name="StoreTagline" Margin="8,0,0,0" FontSize="12" Opacity="0.72" Text="Dairy &amp; Grocery Store" VerticalAlignment="Center"/>
          <TextBlock x:Name="BusinessDate" Margin="10,0,0,0" FontSize="12" Opacity="0.72" VerticalAlignment="Center"/>
        </StackPanel>
      </ui:TitleBar.Header>
      <ui:TitleBar.TrailingContent>
        <StackPanel x:Name="StatusBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
          <Border x:Name="PrinterStatusBadge" MaxWidth="150" Margin="0,0,6,0" Padding="8,3" CornerRadius="5"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  VerticalAlignment="Center">
            <TextBlock x:Name="PrinterStatusText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite" />
          </Border>
          <Border x:Name="ScannerStatusBadge" MaxWidth="150" Margin="0,0,6,0" Padding="8,3" CornerRadius="5"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  VerticalAlignment="Center">
            <TextBlock x:Name="ScannerStatusText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite" />
          </Border>
          <Button x:Name="BackupStatusButton" Style="{StaticResource ToolbarButton}" MaxWidth="160" Click="BackupStatus_OnClick" Content="{l:Tr Settings_NoBackup}"/>
          <Button x:Name="UpdateButton" Style="{StaticResource ToolbarButton}" Click="Update_OnClick" Content="USB"
                  ToolTip="{l:Tr Settings_Update_CheckFolder}" AutomationProperties.Name="{l:Tr Settings_Update_CheckFolder}" />
          <Button x:Name="LockButton" Style="{StaticResource ToolbarButton}" Click="Lock_OnClick" Content="{l:Tr Lock_Command}"
                  ToolTip="Ctrl+Shift+L" />
          <Button Style="{StaticResource ToolbarButton}" MinWidth="40" Padding="8,4" Command="{Binding UseEnglishCommand}" Content="EN"
                  ToolTip="{l:Tr Shell_English}" AutomationProperties.Name="{l:Tr Shell_English}" />
          <Button Style="{StaticResource ToolbarButton}" MinWidth="40" Padding="8,4" Margin="0" Command="{Binding UseGujaratiCommand}" Content="ગુ"
                  ToolTip="{l:Tr Shell_Gujarati}" AutomationProperties.Name="{l:Tr Shell_Gujarati}" />
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="MaintenanceWarning" Grid.Row="0" Visibility="Collapsed"
            Padding="16,10" Background="{x:Static SystemColors.InfoBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Click="BackupStatus_OnClick"
                Content="{l:Tr Settings_Title}"/>
        <TextBlock VerticalAlignment="Center" Foreground="{x:Static SystemColors.InfoTextBrush}"
                   Text="{l:Tr Startup_MaintenanceFailed}" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <local:ShellNavigationView
        x:Name="RootNavigation"
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        OpenPaneLength="220"
        PaneDisplayMode="Left">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem
            Content="{l:Tr Dashboard_Navigation}"
            ToolTip="{l:Tr Dashboard_Navigation}"
            Icon="{ui:SymbolIcon Home24}"
            TargetPageType="{x:Type local:DashboardPage}" />
      </ui:NavigationView.MenuItems>
    </local:ShellNavigationView>

    <Border x:Name="LockOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Background="White" Visibility="Collapsed">
      <Grid MaxWidth="1000" Margin="48,32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="280"/>
          <ColumnDefinition Width="2"/>
          <ColumnDefinition Width="*" MinWidth="330"/>
        </Grid.ColumnDefinitions>
        <Image Source="/GroceryErp.App;component/Assets/logo.jpeg" Stretch="Uniform"
               MaxWidth="420" MaxHeight="420" Margin="0,0,36,0" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Width="2" Margin="0,32" Background="#B7C4D5"/>
        <StackPanel Grid.Column="2" MaxWidth="360" Margin="36,0,0,0"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Lock_Title}" />
          <TextBlock Margin="0,10,0,24" Text="{l:Tr Lock_Body}" TextWrapping="Wrap" />
          <PasswordBox x:Name="UnlockPassword" Height="38" KeyDown="UnlockPassword_OnKeyDown" />
          <Button Margin="0,16,0,0" Click="Unlock_OnClick" Content="{l:Tr Lock_Action}" />
          <TextBlock x:Name="LockError" Margin="0,12,0,0" Foreground="Crimson" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </DockPanel>
</ui:FluentWindow>
