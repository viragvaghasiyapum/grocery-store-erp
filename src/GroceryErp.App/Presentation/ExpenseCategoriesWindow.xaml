<Window x:Class="GroceryErp.App.Presentation.ExpenseCategoriesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr MoneyOut_CategoryDetails}" Width="620" Height="480" MinWidth="520" MinHeight="380"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}" p:ScreenHelp.Topic="expense-categories">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr MoneyOut_CategoryDetails}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr MoneyOut_CategoriesContext}"/>
    </StackPanel>
    <ListBox x:Name="CategoryList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="CategoryList_OnSelectionChanged"
             AutomationProperties.Name="{l:Tr Catalog_Categories}"/>
    <StackPanel x:Name="Fields" Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
      <p:FormErrorSummary x:Name="Summary"/>
      <p:FormField x:Name="NameField" Label="{l:Tr MoneyOut_CategoryName}" IsRequired="True">
        <TextBox x:Name="NameBox" MaxLength="80"/>
      </p:FormField>
      <p:FormField x:Name="LocalField" Label="{l:Tr MoneyOut_LocalName}">
        <TextBox x:Name="LocalBox" MaxLength="80"/>
      </p:FormField>
      <CheckBox x:Name="ActiveBox" IsChecked="True" Content="{l:Tr MoneyOut_Active}"/>
      <TextBlock x:Name="SavedText" Margin="0,10,0,0" Style="{StaticResource StatusText}"/>
    </StackPanel>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Button DockPanel.Dock="Left" Click="New_OnClick" Content="{l:Tr MoneyOut_New}"/>
      <StackPanel Style="{StaticResource FormFooter}" Margin="0">
        <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Close}"/>
        <Button x:Name="SaveButton" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Common_Save}"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
