<Window x:Class="GroceryErp.App.Presentation.DirectCountReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Stock_Count}" Width="960" Height="650" MinWidth="760" MinHeight="470"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="{l:Tr Stock_Count}"/>
      <TextBlock x:Name="PageText" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="{l:Tr Stock_Reason}"/>
        <TextBox x:Name="ReasonBox" MaxLength="500" AutomationProperties.Name="{l:Tr Stock_Reason}"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="{l:Tr MoneyOut_Reason}"/>
        <ComboBox x:Name="CategoryBox" SelectedIndex="5" AutomationProperties.Name="{l:Tr MoneyOut_Reason}">
          <ComboBoxItem Tag="EXPIRED" Content="{l:Tr MoneyOut_ReasonExpired}"/>
          <ComboBoxItem Tag="BROKEN" Content="{l:Tr MoneyOut_ReasonBroken}"/>
          <ComboBoxItem Tag="SPOILED" Content="{l:Tr MoneyOut_ReasonSpoiled}"/>
          <ComboBoxItem Tag="PEST" Content="{l:Tr MoneyOut_ReasonPest}"/>
          <ComboBoxItem Tag="LOST" Content="{l:Tr MoneyOut_ReasonLost}"/>
          <ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/>
        </ComboBox>
      </StackPanel>
    </Grid>
    <DataGrid Grid.Row="2" x:Name="CountGrid" Style="{StaticResource CompactTableGrid}"
              IsReadOnly="False" CanUserAddRows="False" CellEditEnding="CountGrid_OnCellEditEnding">
      <DataGrid.Columns>
        <DataGridTextColumn Width="240" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}" IsReadOnly="True"/>
        <DataGridTextColumn Width="130" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}" IsReadOnly="True"/>
        <DataGridTextColumn Width="105" Header="{l:Tr Stock_Expected}" Binding="{Binding Expected}" IsReadOnly="True"/>
        <DataGridTextColumn Width="105" Header="{l:Tr Stock_Counted}" Binding="{Binding Counted, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Width="105" Header="{l:Tr Stock_Difference}" Binding="{Binding Difference}" IsReadOnly="True"/>
        <DataGridTextColumn Width="125" Header="{l:Tr Stock_DifferenceValue}" Binding="{Binding DifferenceValue}" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button x:Name="EditButton" Margin="0,0,8,0" IsEnabled="False" Click="Edit_OnClick" Content="{l:Tr Catalog_Edit}"/>
        <Button x:Name="ReviewButton" Margin="0,0,8,0" Click="Review_OnClick" Content="{l:Tr Stock_ReviewCount}"/>
        <Button x:Name="PostButton" Margin="0,0,8,0" IsEnabled="False" Click="Post_OnClick" Content="{l:Tr Purchasing_Post}"/>
        <Button x:Name="NextButton" Margin="0,0,8,0" IsEnabled="False" Click="Next_OnClick" Content="{l:Tr Sales_Next}"/>
        <Button Click="Close_OnClick" Content="{l:Tr Common_Cancel}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
