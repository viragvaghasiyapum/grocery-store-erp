<Page
    x:Class="GroceryErp.App.Presentation.StockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Stock_Title}" ScrollViewer.CanContentScroll="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Stock_Title}" />
    <TabControl x:Name="StockTabs" Grid.Row="1" Margin="0,16,0,0" SelectionChanged="StockTabs_OnSelectionChanged">
      <TabItem Header="{l:Tr Stock_Overview}">
        <DockPanel Margin="0,8,0,0">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button Margin="0,0,8,0" Click="OpeningImport_OnClick" Content="{l:Tr Stock_OpeningImport}" />
          <Button Margin="0,0,8,0" Click="OpeningTemplate_OnClick" Content="{l:Tr Stock_OpeningTemplate}" />
          <Button x:Name="ResumeCountButton" Margin="0,0,8,0" Click="Count_OnClick" Content="{l:Tr Stock_ResumeCount}" />
          <Button Margin="0,0,8,0" Click="NewCount_OnClick" Content="{l:Tr Stock_NewCount}" />
          <Button Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}" />
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBox x:Name="OverviewSearchBox" Width="240" Margin="0,0,6,0" ToolTip="Product name or SKU"/>
          <Button Click="OverviewSearch_OnClick" Content="Search"/>
        </WrapPanel>
        <DataGrid Style="{StaticResource CatalogGrid}" x:Name="OverviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="OverviewGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}" />
            <DataGridTextColumn Width="260" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}" />
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}" />
            <DataGridTextColumn Width="130" Header="{l:Tr Stock_CostValue}" Binding="{Binding CostValue}" />
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_Reorder}" Binding="{Binding ReorderLevel}" />
            <DataGridCheckBoxColumn Width="90" Header="{l:Tr Stock_Low}" Binding="{Binding IsLow}" />
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr Stock_Lots}">
        <DockPanel Margin="0,8,0,0">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button x:Name="AdjustButton" IsEnabled="False" Margin="0,0,8,0" Click="Adjust_OnClick" Content="{l:Tr Stock_Adjust}" />
          <Button x:Name="PriceButton" IsEnabled="False" Margin="0,0,8,0" Click="Price_OnClick" Content="{l:Tr Stock_CorrectLot}" />
          <Button x:Name="ToggleLotButton" IsEnabled="False" Margin="0,0,8,0" Click="ToggleLot_OnClick" Content="{l:Tr Stock_BlockToggle}" />
          <Button x:Name="WriteOffButton" IsEnabled="False" Margin="0,0,8,0" Click="WriteOff_OnClick" Content="{l:Tr Stock_WriteOffExpired}" />
          <Button Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}" />
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBox x:Name="LotSearchBox" Width="240" Margin="0,0,6,0" ToolTip="Product, lot or batch"/>
          <Button Click="LotSearch_OnClick" Content="Search"/>
        </WrapPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="BulkBlockLotsButton" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,0" Click="BulkBlockLots_OnClick" Content="{l:Tr Stock_BlockSelected}"/>
          <Button x:Name="BulkUnblockLotsButton" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,0" Click="BulkUnblockLots_OnClick" Content="{l:Tr Stock_UnblockSelected}"/>
          <Button x:Name="BulkWriteOffLotsButton" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,0" Click="BulkWriteOffLots_OnClick" Content="{l:Tr Stock_WriteOffSelectedExpired}"/>
          <TextBlock x:Name="LotSelectedCountText" VerticalAlignment="Center" Text="0 selected"/>
        </StackPanel>
        <DataGrid Style="{StaticResource CatalogGrid}" x:Name="LotsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="LotsGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="42">
              <DataGridTemplateColumn.HeaderTemplate><DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsThreeState="True" Loaded="LotPageCheck_OnLoaded" Click="LotPageCheck_OnClick" AutomationProperties.Name="{l:Tr Selection_ThisPage}"/>
              </DataTemplate></DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Loaded="LotCheck_OnLoaded" Click="LotCheck_OnClick" AutomationProperties.Name="{l:Tr Stock_SelectLot}"/>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Width="210" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}" />
            <DataGridTextColumn Width="105" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}" />
            <DataGridTextColumn Width="90" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchNumber}" />
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate}" />
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_ExpiryStatus}" Binding="{Binding ExpiryBucketCode,Converter={StaticResource ExpiryBucketConverter}}" ElementStyle="{StaticResource ExpiryBucketStyle}" />
            <DataGridTextColumn Width="90" Header="{l:Tr Stock_OnHand}" Binding="{Binding OnHand}" />
            <DataGridTextColumn Width="90" Header="{l:Tr Stock_UnitCost}" Binding="{Binding UnitCost}" />
            <DataGridTextColumn Width="90" Header="{l:Tr Catalog_Price}" Binding="{Binding SellingPrice}" />
            <DataGridTemplateColumn Width="70" Header="{l:Tr Catalog_Active}">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsChecked="{Binding IsActive, Mode=OneWay}" Click="LotActive_OnClick"
                          AutomationProperties.Name="{l:Tr Catalog_Active}"/>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:Tr Stock_Ledger}">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,8,0,10">
          <TextBlock x:Name="LedgerProductText" Text="{l:Tr Stock_LedgerSelectProduct}" Margin="0,0,0,8"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <WrapPanel>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Stock_FilterFrom}"/>
            <DatePicker x:Name="LedgerFromBox" Width="130" SelectedDateFormat="Short" Margin="0,0,12,0"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Stock_FilterTo}"/>
            <DatePicker x:Name="LedgerToBox" Width="130" SelectedDateFormat="Short" Margin="0,0,12,0"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Stock_MovementType}"/>
            <ComboBox x:Name="LedgerTypeBox" Width="160" Margin="0,0,8,0"/>
            <Button Margin="0,0,8,0" Click="ApplyLedgerFilter_OnClick" Content="{l:Tr Stock_ApplyFilter}"/>
            <Button x:Name="OpenSourceButton" IsEnabled="False" Click="OpenSource_OnClick" Content="{l:Tr Stock_OpenSource}"/>
          </WrapPanel>
          </StackPanel>
          <DataGrid Style="{StaticResource CatalogGrid}" x:Name="LedgerGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="LedgerGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_MoveDate}" Binding="{Binding MoveDate}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Stock_MovementType}" Binding="{Binding Type}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_OnHand}" Binding="{Binding LotBalance}"/>
            <DataGridTextColumn Width="190" Header="{l:Tr Purchasing_Notes}" Binding="{Binding Note}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Stock_Source}" Binding="{Binding RefType}"/>
            <DataGridTextColumn Width="90" Header="{l:Tr Stock_SourceId}" Binding="{Binding RefId}"/>
          </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="{l:Tr Stock_Valuation}">
        <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8" Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}"/>
        <DataGrid Style="{StaticResource CatalogGrid}" x:Name="ValuationGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Width="260" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryName}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
            <DataGridTextColumn Width="140" Header="{l:Tr Stock_CostValue}" Binding="{Binding CostValue}"/>
            <DataGridTextColumn Width="140" Header="{l:Tr Stock_SellingValue}" Binding="{Binding SellingValue}"/>
            <DataGridTextColumn Width="140" Header="{l:Tr Stock_MrpValue}" Binding="{Binding MrpValue}"/>
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <StackPanel x:Name="PageSizePanel" DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Common_RowsPerPage}"/>
        <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="120" SelectedIndex="2" SelectionChanged="PageSize_OnChanged"><ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox>
        <StackPanel x:Name="OverviewPager" Orientation="Horizontal" Margin="12,0,0,0">
          <Button x:Name="PreviousOverviewButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousOverview_OnClick" Content="{l:Tr Sales_Previous}"/>
          <Button x:Name="NextOverviewButton" IsEnabled="False" Click="NextOverview_OnClick" Content="{l:Tr Sales_Next}"/>
        </StackPanel>
        <StackPanel x:Name="LotsPager" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
          <Button x:Name="PreviousLotButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousLot_OnClick" Content="{l:Tr Sales_Previous}"/>
          <Button x:Name="NextLotButton" IsEnabled="False" Click="NextLot_OnClick" Content="{l:Tr Sales_Next}"/>
        </StackPanel>
        <StackPanel x:Name="LedgerPager" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
          <Button x:Name="PreviousLedgerButton" IsEnabled="False" Margin="0,0,6,0" Click="PreviousLedger_OnClick" Content="{l:Tr Sales_Previous}"/>
          <Button x:Name="NextLedgerButton" IsEnabled="False" Click="NextLedger_OnClick" Content="{l:Tr Sales_Next}"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
</Page>
