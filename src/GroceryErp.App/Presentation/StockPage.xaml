<Page
    x:Class="GroceryErp.App.Presentation.StockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Stock_Title}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Stock_Title}" />
    <TabControl Grid.Row="1" Margin="0,18,0,0">
      <TabItem Header="{l:Tr Stock_Overview}">
        <DataGrid x:Name="OverviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="OverviewGrid_OnSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}" />
            <DataGridTextColumn Width="2*" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}" />
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}" />
            <DataGridTextColumn Width="130" Header="{l:Tr Stock_CostValue}" Binding="{Binding CostValue}" />
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_Reorder}" Binding="{Binding ReorderLevel}" />
            <DataGridCheckBoxColumn Width="90" Header="{l:Tr Stock_Low}" Binding="{Binding IsLow}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Stock_Lots}">
        <DataGrid x:Name="LotsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Width="2*" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}" />
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}" />
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchNumber}" />
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate}" />
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_OnHand}" Binding="{Binding OnHand}" />
            <DataGridTextColumn Width="100" Header="{l:Tr Stock_UnitCost}" Binding="{Binding UnitCost}" />
            <DataGridTextColumn Width="100" Header="{l:Tr Catalog_Price}" Binding="{Binding SellingPrice}" />
            <DataGridCheckBoxColumn Width="80" Header="{l:Tr Catalog_Active}" Binding="{Binding IsActive}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Stock_Ledger}">
        <DataGrid x:Name="LedgerGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Width="110" Header="{l:Tr Purchasing_Received}" Binding="{Binding MoveDate}"/>
            <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_Mode}" Binding="{Binding Type}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
            <DataGridTextColumn Width="110" Header="{l:Tr Stock_OnHand}" Binding="{Binding LotBalance}"/>
            <DataGridTextColumn Width="2*" Header="{l:Tr Purchasing_Notes}" Binding="{Binding Note}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:Tr Stock_Valuation}">
        <DataGrid x:Name="ValuationGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Width="2*" Header="{l:Tr Catalog_Category}" Binding="{Binding CategoryName}"/>
            <DataGridTextColumn Width="120" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
            <DataGridTextColumn Width="140" Header="{l:Tr Stock_CostValue}" Binding="{Binding CostValue}"/>
            <DataGridTextColumn Width="140" Header="{l:Tr Stock_SellingValue}" Binding="{Binding SellingValue}"/>
            <DataGridTextColumn Width="140" Header="{l:Tr Stock_MrpValue}" Binding="{Binding MrpValue}"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Margin="0,0,8,0" Click="OpeningImport_OnClick" Content="{l:Tr Stock_OpeningImport}" />
        <Button Margin="0,0,8,0" Click="OpeningTemplate_OnClick" Content="{l:Tr Stock_OpeningTemplate}" />
        <Button Margin="0,0,8,0" Click="Adjust_OnClick" Content="{l:Tr Stock_Adjust}" />
        <Button Margin="0,0,8,0" Click="Price_OnClick" Content="{l:Tr Stock_ChangePrice}" />
        <Button Margin="0,0,8,0" Click="ToggleLot_OnClick" Content="{l:Tr Stock_BlockToggle}" />
        <Button Margin="0,0,8,0" Click="Count_OnClick" Content="{l:Tr Stock_Count}" />
        <Button Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
