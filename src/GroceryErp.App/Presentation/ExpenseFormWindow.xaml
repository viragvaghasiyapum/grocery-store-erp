<Window x:Class="GroceryErp.App.Presentation.ExpenseFormWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr MoneyOut_NewExpense}" Width="520" Height="560" MinWidth="440" MinHeight="440"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="expense-form">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr MoneyOut_NewExpense}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr MoneyOut_ExpenseContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Fields" Margin="0,0,8,0">
        <UniformGrid Columns="2">
          <p:FormField x:Name="DateField" Label="{l:Tr Purchasing_Date}" IsRequired="True">
            <DatePicker x:Name="DateBox" SelectedDateFormat="Short" SelectedDateChanged="Date_OnChanged"/>
          </p:FormField>
          <p:FormField x:Name="CategoryField" Label="{l:Tr Catalog_Category}" IsRequired="True">
            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
          </p:FormField>
          <p:FormField x:Name="AmountField" Label="{l:Tr MoneyOut_Amount}" IsRequired="True">
            <TextBox x:Name="AmountBox"/>
          </p:FormField>
          <p:FormField x:Name="ModeField" Label="{l:Tr Purchasing_Mode}" IsRequired="True">
            <ComboBox x:Name="ModeBox" SelectedIndex="0">
              <ComboBoxItem Tag="CASH" Content="{l:Tr MoneyOut_ModeCash}"/>
              <ComboBoxItem Tag="UPI" Content="UPI"/>
              <ComboBoxItem Tag="BANK" Content="{l:Tr MoneyOut_ModeBank}"/>
              <ComboBoxItem Tag="CARD" Content="{l:Tr MoneyOut_ModeCard}"/>
              <ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/>
            </ComboBox>
          </p:FormField>
          <p:FormField x:Name="PaidToField" Label="{l:Tr MoneyOut_PaidTo}">
            <TextBox x:Name="PaidToBox" MaxLength="120"/>
          </p:FormField>
          <p:FormField x:Name="ReferenceField" Label="{l:Tr MoneyOut_Reference}">
            <TextBox x:Name="ReferenceBox" MaxLength="120"/>
          </p:FormField>
        </UniformGrid>
        <p:FormField x:Name="NotesField" Label="{l:Tr Purchasing_Notes}">
          <TextBox x:Name="NotesBox" MaxLength="500"/>
        </p:FormField>
        <TextBlock x:Name="PeriodText" Style="{StaticResource FormPreview}"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveButton" IsDefault="True" Click="Save_OnClick" Content="{l:Tr MoneyOut_SaveExpense}"/>
    </StackPanel>
  </Grid>
</Window>
