<Page x:Class="GroceryErp.App.Presentation.SalesHistoryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 xmlns:local="clr-namespace:GroceryErp.App.Presentation"
 Title="{l:Tr Sales_History_Title}" NumberSubstitution.Substitution="European"
 ScrollViewer.CanContentScroll="False">
 <Page.Resources>
  <local:SaleStatusConverter x:Key="SaleStatusConverter"/>
  <local:PaymentModesConverter x:Key="PaymentModesConverter"/>
 </Page.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="250"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Sales_History_Title}"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock x:Name="StatusText" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <Button x:Name="ExportButton" Margin="8,0,0,0" Click="Export_OnClick" Content="{l:Tr Sales_Export}"/>
    <Button x:Name="CancelExportButton" Margin="6,0,0,0" IsEnabled="False" Click="CancelExport_OnClick" Content="Cancel"/>
    <ProgressBar x:Name="ExportProgress" Width="64" Height="5" Margin="10,0,0,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  <WrapPanel Grid.Row="1" Margin="0,12,0,8">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Sales_From}"/><DatePicker x:Name="FromPicker" Width="135" SelectedDateFormat="Short"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Sales_To}"/><DatePicker x:Name="ToPicker" Width="135" SelectedDateFormat="Short"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Sales_Invoice}"/><TextBox x:Name="InvoiceBox" Width="145" Height="32"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Purchasing_Status}"/>
    <ComboBox x:Name="StatusBox" Width="115" Height="32" SelectedIndex="0">
     <ComboBoxItem Content="{l:Tr Sales_All}"/><ComboBoxItem Content="{l:Tr Sales_CompletedStatus}" Tag="Completed"/>
     <ComboBoxItem Content="{l:Tr Sales_Void}" Tag="Void"/>
    </ComboBox>
   </StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Purchasing_Mode}"/>
    <ComboBox x:Name="PaymentBox" Width="115" Height="32" SelectedIndex="0">
     <ComboBoxItem Content="{l:Tr Sales_All}"/><ComboBoxItem Content="{l:Tr Sales_CashLabel}" Tag="Cash"/>
     <ComboBoxItem Content="{l:Tr Sales_UpiLabel}" Tag="Upi"/><ComboBoxItem Content="{l:Tr Sales_CardLabel}" Tag="Card"/>
    </ComboBox>
   </StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Sales_Minimum}"/><TextBox x:Name="MinimumBox" Width="100" Height="32"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Sales_Maximum}"/><TextBox x:Name="MaximumBox" Width="100" Height="32"/></StackPanel>
   <Button Margin="0,15,8,8" Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}"/>
   <Button Margin="0,15,0,8" Click="DayEnd_OnClick" Content="{l:Tr Sales_DayEnd}"/>
  </WrapPanel>
  <DataGrid x:Name="HistoryGrid" Grid.Row="2" Margin="0,0,0,10" Style="{StaticResource CatalogGrid}"
            SelectionChanged="HistoryGrid_OnSelectionChanged">
   <DataGrid.Columns>
    <DataGridTextColumn Width="155" Header="{l:Tr Sales_Invoice}" Binding="{Binding InvoiceNumber}"/>
    <DataGridTextColumn Width="115" Header="{l:Tr Sales_Date}" Binding="{Binding SaleDate}"/>
    <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_Status}" Binding="{Binding Status,Converter={StaticResource SaleStatusConverter}}"/>
    <DataGridTextColumn Width="78" Header="{l:Tr Sales_Items}" Binding="{Binding LineCount}"/>
    <DataGridTextColumn Width="125" Header="{l:Tr Purchasing_Total}" Binding="{Binding GrandTotal}"/>
    <DataGridTextColumn Width="155" Header="{l:Tr Purchasing_Mode}" Binding="{Binding PaymentModes,Converter={StaticResource PaymentModesConverter}}"/>
   </DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="3" Style="{StaticResource CatalogCard}" Margin="0,0,0,10">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="DetailHeading" FontSize="16" FontWeight="SemiBold" Text="{l:Tr Sales_SelectHistory}"/>
    <TabControl Grid.Row="1" Margin="0,8,0,0">
     <TabItem Header="{l:Tr Sales_Items}">
    <DataGrid x:Name="DetailGrid" Style="{StaticResource CatalogGrid}" RowHeight="40">
     <DataGrid.Columns>
      <DataGridTextColumn Width="320" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
      <DataGridTextColumn Width="85" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
      <DataGridTextColumn Width="110" Header="{l:Tr Catalog_Price}" Binding="{Binding UnitPrice}"/>
      <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Total}" Binding="{Binding Total}"/>
     </DataGrid.Columns>
    </DataGrid>
     </TabItem>
     <TabItem Header="{l:Tr Sales_ReturnsTab}">
      <DataGrid x:Name="ReturnsGrid" Style="{StaticResource CatalogGrid}" RowHeight="36">
       <DataGrid.Columns>
        <DataGridTextColumn Width="120" Header="{l:Tr Sales_Return}" Binding="{Binding ReturnNumber}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Sales_Date}" Binding="{Binding Date}"/>
        <DataGridTextColumn Width="*" MinWidth="160" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="90" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Receipt_RefundTotal}" Binding="{Binding Refund}"/>
        <DataGridCheckBoxColumn Width="90" Header="{l:Tr Sales_Resellable}" Binding="{Binding Resellable}"/>
        <DataGridTextColumn Width="150" Header="{l:Tr Stock_Reason}" Binding="{Binding Reason}"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="{l:Tr Sales_MovementsTab}">
      <DataGrid x:Name="MovementsGrid" Style="{StaticResource CatalogGrid}" RowHeight="36">
       <DataGrid.Columns>
        <DataGridTextColumn Width="110" Header="{l:Tr Sales_Date}" Binding="{Binding Date}"/>
        <DataGridTextColumn Width="*" MinWidth="160" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
        <DataGridTextColumn Width="140" Header="{l:Tr Stock_MovementType}" Binding="{Binding Type}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
   </Grid>
  </Border>
  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Common_RowsPerPage}"/>
    <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="120" SelectedIndex="2" SelectionChanged="PageSize_OnChanged">
     <ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/>
    </ComboBox>
    <Button x:Name="PreviousButton" Margin="12,0,0,0" Click="Previous_OnClick" Content="{l:Tr Sales_Previous}"/>
    <Button x:Name="NextButton" Margin="6,0,0,0" Click="Next_OnClick" Content="{l:Tr Sales_Next}"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="ReprintButton" Margin="0,0,8,0" Click="Reprint_OnClick" Content="{l:Tr Sales_Reprint}"/>
    <Button x:Name="VoidButton" Margin="0,0,8,0" Click="Void_OnClick" Content="{l:Tr Sales_Void}"/>
    <Button x:Name="ReturnButton" Click="Return_OnClick" Content="{l:Tr Sales_Return}"/>
   </StackPanel>
  </Grid>
 </Grid>
</Page>
