<Page x:Class="GroceryErp.App.Presentation.SalesHistoryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 xmlns:local="clr-namespace:GroceryErp.App.Presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 FontFamily="{StaticResource AppFont}" NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN"
 Title="{l:Tr Sales_History_Title}" NumberSubstitution.Substitution="European"
 ScrollViewer.CanContentScroll="False" local:ScreenHelp.Topic="sales-history">
 <Page.Resources>
  <local:SaleStatusConverter x:Key="SaleStatusConverter"/>
  <local:LegacySnapshotTextConverter x:Key="LegacySnapshotTextConverter"/>
  <local:PaymentModesConverter x:Key="PaymentModesConverter"/>
  <local:SaleActivityConverter x:Key="SaleActivityConverter"/>
 </Page.Resources>
 <Grid x:Name="Layout" Margin="14,8,14,8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel x:Name="TitleRow" Grid.Row="0" Margin="0,0,0,6">
   <!-- Most important first: when the row is narrow the last actions fold behind More. -->
   <StackPanel x:Name="TitleActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ViewItemsButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="ViewBillItems_OnClick"
            Content="{l:Tr Sales_ViewBillItems}" FontWeight="SemiBold" ToolTip="Enter"/>
    <Button x:Name="ReturnButton" Style="{StaticResource ToolbarButton}" Click="Return_OnClick" Content="{l:Tr Sales_Return}"/>
    <Button x:Name="ReprintButton" Style="{StaticResource ToolbarButton}" Click="Reprint_OnClick" Content="{l:Tr Sales_Reprint}"/>
    <Button x:Name="VoidButton" Style="{StaticResource ToolbarButton}" Click="Void_OnClick" Content="{l:Tr Sales_Void}"/>
    <Button Style="{StaticResource ToolbarButton}" Click="DayEnd_OnClick" Content="{l:Tr Sales_DayEnd}"/>
    <Button x:Name="ExportButton" Style="{StaticResource ToolbarButton}" Margin="0" Click="Export_OnClick" Content="{l:Tr Sales_Export}"/>
    <Menu x:Name="MoreActionsMenu" VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed">
     <MenuItem x:Name="MoreActions" Header="{l:Tr Common_MoreActions}"/>
    </Menu>
   </StackPanel>
   <!-- Shown only while an export runs. -->
   <StackPanel x:Name="ExportPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
               Visibility="Collapsed">
    <ProgressBar x:Name="ExportProgress" Width="64" Height="5" Margin="0,0,8,0" VerticalAlignment="Center" IsIndeterminate="True"/>
    <Button x:Name="CancelExportButton" Style="{StaticResource ToolbarButton}" Margin="0" IsEnabled="False" Click="CancelExport_OnClick" Content="{l:Tr Common_Cancel}"/>
   </StackPanel>
   <StackPanel x:Name="TitleHeader" Orientation="Horizontal">
     <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Text="{l:Tr Sales_History_Title}" Margin="0,0,6,0"/>
     <local:HelpButton VerticalAlignment="Center"/>
   </StackPanel>
  </DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,2">
  <WrapPanel x:Name="FilterBar">
   <ui:TextBox x:Name="InvoiceBox" Width="150" Margin="0,0,6,4" PlaceholderText="{l:Tr Sales_Invoice}" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_Invoice}" ToolTip="Ctrl+F"/>
   <ui:TextBox x:Name="ProductBox" Width="190" Margin="0,0,6,4" PlaceholderText="{l:Tr Sales_ProductFilter}" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_ProductFilter}"/>
   <TextBlock x:Name="FromLabel" Style="{StaticResource FilterLabel}" Text="{l:Tr Sales_From}"/>
   <DatePicker x:Name="FromPicker" Width="132" Margin="0,0,6,4" SelectedDateFormat="Short" AutomationProperties.Name="{l:Tr Sales_From}"/>
   <TextBlock x:Name="ToLabel" Style="{StaticResource FilterLabel}" Text="{l:Tr Sales_To}"/>
   <DatePicker x:Name="ToPicker" Width="132" Margin="0,0,6,4" SelectedDateFormat="Short" AutomationProperties.Name="{l:Tr Sales_To}"/>
   <ComboBox x:Name="StatusBox" Width="150" Margin="0,0,6,4" SelectedIndex="0" AutomationProperties.Name="{l:Tr Purchasing_Status}">
    <ComboBoxItem Content="{l:Tr Purchasing_AnyStatus}"/><ComboBoxItem Content="{l:Tr Sales_CompletedStatus}" Tag="Completed"/>
    <ComboBoxItem Content="{l:Tr Sales_Status_PartiallyRefunded}" Tag="PartiallyRefunded"/>
    <ComboBoxItem Content="{l:Tr Sales_Status_Refunded}" Tag="Refunded"/>
    <ComboBoxItem Content="{l:Tr Sales_Status_Void}" Tag="Void"/>
   </ComboBox>
   <ToggleButton x:Name="MoreFiltersToggle" Margin="0,0,6,4" MinHeight="32" Padding="10,4" Click="MoreFilters_OnClick" Content="{l:Tr Common_MoreFilters}"/>
   <Button Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" Click="Refresh_OnClick" Content="{l:Tr Sales_Search}" FontWeight="SemiBold" ToolTip="Enter"/>
   <Button Style="{StaticResource ToolbarButton}" Margin="0,0,0,4" Click="ClearFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
  </WrapPanel>
  <WrapPanel x:Name="MoreFiltersPanel" Visibility="Collapsed">
   <ui:TextBox x:Name="CustomerBox" Width="190" Margin="0,0,6,4" PlaceholderText="{l:Tr Sales_Customer}" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_Customer}"/>
   <ComboBox x:Name="PaymentBox" Width="130" Margin="0,0,10,4" SelectedIndex="0" AutomationProperties.Name="{l:Tr Purchasing_Mode}">
    <ComboBoxItem Content="{l:Tr Sales_AnyPayment}"/><ComboBoxItem Content="{l:Tr Sales_CashLabel}" Tag="Cash"/>
    <ComboBoxItem Content="{l:Tr Sales_UpiLabel}" Tag="Upi"/><ComboBoxItem Content="{l:Tr Sales_CardLabel}" Tag="Card"/>
   </ComboBox>
   <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr Sales_AmountBetween}"/>
   <TextBox x:Name="MinimumBox" Width="90" Margin="0,0,4,4" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_Minimum}" ToolTip="{l:Tr Sales_Minimum}"/>
   <TextBox x:Name="MaximumBox" Width="90" Margin="0,0,0,4" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_Maximum}" ToolTip="{l:Tr Sales_Maximum}"/>
  </WrapPanel>
  </StackPanel>
  <DataGrid x:Name="HistoryGrid" Grid.Row="2" Style="{StaticResource CompactTableGrid}"
            SelectionChanged="HistoryGrid_OnSelectionChanged" MouseDoubleClick="HistoryGrid_OnDoubleClick"
            PreviewKeyDown="HistoryGrid_OnPreviewKeyDown" AutomationProperties.Name="{l:Tr Sales_History_Title}">
   <DataGrid.Columns>
    <DataGridTextColumn Width="155" Header="{l:Tr Sales_Invoice}" Binding="{Binding InvoiceNumber}"/>
    <DataGridTextColumn Width="115" Header="{l:Tr Sales_Date}" Binding="{Binding SaleDate, StringFormat=dd MMM yyyy}"/>
    <DataGridTextColumn Width="145" Header="{l:Tr Purchasing_Status}" Binding="{Binding Status,Converter={StaticResource SaleStatusConverter}}"/>
    <DataGridTextColumn Width="78" Header="{l:Tr Sales_Items}" Binding="{Binding LineCount}"/>
    <DataGridTextColumn Width="125" Header="{l:Tr Purchasing_Total}" Binding="{Binding GrandTotal}"/>
    <DataGridTextColumn Width="155" Header="{l:Tr Purchasing_Mode}" Binding="{Binding PaymentModes,Converter={StaticResource PaymentModesConverter}}"/>
   </DataGrid.Columns>
  </DataGrid>
  <local:PagerBar x:Name="Pager" Grid.Row="3"/>
  <!-- The bill opens beside the list; its arrows and the list both move to another bill. -->
  <local:DetailPanel x:Name="Detail" Grid.Column="1" Grid.RowSpan="4" Margin="10,-8,-14,-8" Visibility="Collapsed"
                     CloseRequested="Detail_OnCloseRequested">
   <local:DetailPanel.Actions>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="DetailReturnButton" Style="{StaticResource ToolbarButton}" Click="Return_OnClick" Content="{l:Tr Sales_Return}"/>
     <Button x:Name="DetailReprintButton" Style="{StaticResource ToolbarButton}" Click="Reprint_OnClick" Content="{l:Tr Sales_Reprint}"/>
     <Button x:Name="DetailVoidButton" Style="{StaticResource ToolbarButton}" Margin="0" Click="Void_OnClick" Content="{l:Tr Sales_Void}"/>
    </StackPanel>
   </local:DetailPanel.Actions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="DetailTabs" SelectionChanged="DetailTabs_OnSelectionChanged">
     <TabItem Header="{l:Tr Sales_Items}">
    <DataGrid x:Name="DetailGrid" Style="{StaticResource CompactTableGrid}" RowHeight="38" FrozenColumnCount="1">
     <DataGrid.Columns>
      <DataGridTextColumn Width="240" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
      <DataGridTextColumn Width="105" Header="{l:Tr Catalog_Sku}" Binding="{Binding SkuDisplay,Converter={StaticResource LegacySnapshotTextConverter}}"/>
      <DataGridTextColumn Width="105" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
      <DataGridTextColumn Width="115" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchDisplay,Converter={StaticResource LegacySnapshotTextConverter}}"/>
      <DataGridTextColumn Width="115" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDisplay,Converter={StaticResource LegacySnapshotTextConverter}}"/>
      <DataGridTextColumn Width="85" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
      <DataGridTextColumn Width="100" Header="{l:Tr Catalog_Price}" Binding="{Binding UnitPrice, Converter={StaticResource Amount}}"/>
      <!-- The cost side, per piece, then the sale side from the line's saved amounts:
           Before tax + Tax charged = Total as shown. -->
      <DataGridTextColumn Width="100" Header="{l:Tr Stock_UnitCost}" Binding="{Binding PurchasePrice, Converter={StaticResource Amount}}"/>
      <DataGridTextColumn Width="118" Header="{l:Tr Stock_CostInclTax}" Binding="{Binding UnitCostInclTax, Converter={StaticResource Amount}}"/>
      <DataGridTextColumn Width="82" Header="{l:Tr Purchasing_Gst}" Binding="{Binding TaxLabel, TargetNullValue=—}"
                          HeaderStyle="{StaticResource TableGroupHeader}" CellStyle="{StaticResource TableGroupCell}"/>
      <DataGridTextColumn Width="100" Header="{l:Tr Sales_BeforeTax}" Binding="{Binding Taxable, Converter={StaticResource Amount}}"/>
      <DataGridTextColumn Width="100" Header="{l:Tr Sales_TaxCharged}" Binding="{Binding TaxChargedShown, Converter={StaticResource Amount}}"/>
      <DataGridTextColumn Width="110" Header="{l:Tr Purchasing_Total}" Binding="{Binding Total, Converter={StaticResource Amount}}"/>
     </DataGrid.Columns>
    </DataGrid>
     </TabItem>
     <TabItem Header="{l:Tr Sales_ReturnsTab}">
      <DataGrid x:Name="ReturnsGrid" Style="{StaticResource CompactTableGrid}" RowHeight="34">
       <DataGrid.Columns>
        <DataGridTextColumn Width="120" Header="{l:Tr Sales_Return}" Binding="{Binding ReturnNumber}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Sales_Date}" Binding="{Binding Date, StringFormat=dd MMM yyyy}"/>
        <DataGridTextColumn Width="*" MinWidth="160" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding RestockLotCode}"/>
        <DataGridTextColumn Width="90" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Sales_ReturnRefundHeader}" Binding="{Binding Refund}"/>
        <DataGridTextColumn Width="135" Header="{l:Tr Sales_ReturnRestockHeader}" Binding="{Binding DispositionCode,Converter={StaticResource SaleActivityConverter}}"/>
        <DataGridTextColumn Width="150" Header="{l:Tr Stock_Reason}" Binding="{Binding Reason}"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="{l:Tr Sales_ActivityTab}">
      <DataGrid x:Name="ActivityGrid" Style="{StaticResource CompactTableGrid}" RowHeight="34">
       <DataGrid.Columns>
        <DataGridTextColumn Width="110" Header="{l:Tr Sales_Date}" Binding="{Binding Date, StringFormat=dd MMM yyyy}"/>
        <DataGridTextColumn Width="*" MinWidth="160" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
        <DataGridTextColumn Width="140" Header="{l:Tr Sales_ActivityEvent}" Binding="{Binding Type,Converter={StaticResource SaleActivityConverter}}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <local:PagerBar x:Name="DetailPager" Grid.Row="1"/>
   </Grid>
  </local:DetailPanel>
 </Grid>
</Page>
