<Page x:Class="GroceryErp.App.Presentation.SalesHistoryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 xmlns:local="clr-namespace:GroceryErp.App.Presentation"
 Title="{l:Tr Sales_History_Title}" NumberSubstitution.Substitution="European"
 ScrollViewer.CanContentScroll="False">
 <Page.Resources>
  <local:SaleStatusConverter x:Key="SaleStatusConverter"/>
  <local:LegacySnapshotTextConverter x:Key="LegacySnapshotTextConverter"/>
  <local:PaymentModesConverter x:Key="PaymentModesConverter"/>
  <local:SaleActivityConverter x:Key="SaleActivityConverter"/>
 </Page.Resources>
 <Grid Margin="16,12,16,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock FontSize="22" FontWeight="SemiBold" Text="{l:Tr Sales_History_Title}"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock x:Name="StatusText" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <Button Margin="8,0,0,0" Click="DayEnd_OnClick" Content="{l:Tr Sales_DayEnd}"/>
    <Button x:Name="ExportButton" Margin="6,0,0,0" Click="Export_OnClick" Content="{l:Tr Sales_Export}"/>
    <Button x:Name="CancelExportButton" Margin="6,0,0,0" IsEnabled="False" Click="CancelExport_OnClick" Content="{l:Tr Common_Cancel}"/>
    <ProgressBar x:Name="ExportProgress" Width="64" Height="5" Margin="10,0,0,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,6,0,4">
  <WrapPanel>
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Sales_From}"/><DatePicker x:Name="FromPicker" Width="130" SelectedDateFormat="Short" AutomationProperties.Name="{l:Tr Sales_From}"/></StackPanel>
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Sales_To}"/><DatePicker x:Name="ToPicker" Width="130" SelectedDateFormat="Short" AutomationProperties.Name="{l:Tr Sales_To}"/></StackPanel>
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Sales_Invoice}"/><TextBox x:Name="InvoiceBox" Width="140" Height="32" VerticalContentAlignment="Center" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_Invoice}"/></StackPanel>
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Catalog_Name}"/><TextBox x:Name="ProductBox" Width="170" Height="32" VerticalContentAlignment="Center" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Catalog_Name}"/></StackPanel>
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Purchasing_Status}"/>
    <ComboBox x:Name="StatusBox" Width="150" Height="32" SelectedIndex="0" AutomationProperties.Name="{l:Tr Purchasing_Status}">
     <ComboBoxItem Content="{l:Tr Sales_All}"/><ComboBoxItem Content="{l:Tr Sales_CompletedStatus}" Tag="Completed"/>
     <ComboBoxItem Content="{l:Tr Sales_Status_PartiallyRefunded}" Tag="PartiallyRefunded"/>
     <ComboBoxItem Content="{l:Tr Sales_Status_Refunded}" Tag="Refunded"/>
     <ComboBoxItem Content="{l:Tr Sales_Void}" Tag="Void"/>
    </ComboBox>
   </StackPanel>
   <Button Margin="0,18,6,4" Click="Refresh_OnClick" Content="{l:Tr Sales_Search}" FontWeight="SemiBold"/>
   <Button Margin="0,18,0,4" Click="ClearFilters_OnClick" Content="{l:Tr Purchasing_ClearFilters}"/>
  </WrapPanel>
  <local:AnimatedSection Header="{l:Tr Sales_MoreFilters}" IsExpanded="False" Margin="0,0,0,2">
   <WrapPanel Margin="0,4,0,0">
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Sales_Customer}"/><TextBox x:Name="CustomerBox" Width="170" Height="32" VerticalContentAlignment="Center" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_Customer}"/></StackPanel>
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Purchasing_Mode}"/>
    <ComboBox x:Name="PaymentBox" Width="115" Height="32" SelectedIndex="0" AutomationProperties.Name="{l:Tr Purchasing_Mode}">
     <ComboBoxItem Content="{l:Tr Sales_All}"/><ComboBoxItem Content="{l:Tr Sales_CashLabel}" Tag="Cash"/>
     <ComboBoxItem Content="{l:Tr Sales_UpiLabel}" Tag="Upi"/><ComboBoxItem Content="{l:Tr Sales_CardLabel}" Tag="Card"/>
    </ComboBox>
   </StackPanel>
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Sales_Minimum}"/><TextBox x:Name="MinimumBox" Width="100" Height="32" VerticalContentAlignment="Center" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_Minimum}"/></StackPanel>
   <StackPanel Margin="0,0,10,4"><TextBlock Margin="0,0,0,2" Text="{l:Tr Sales_Maximum}"/><TextBox x:Name="MaximumBox" Width="100" Height="32" VerticalContentAlignment="Center" KeyDown="Filter_OnKeyDown" AutomationProperties.Name="{l:Tr Sales_Maximum}"/></StackPanel>
   </WrapPanel>
  </local:AnimatedSection>
  </StackPanel>
  <DataGrid x:Name="HistoryGrid" Grid.Row="2" Margin="0,0,0,6" Style="{StaticResource CompactTableGrid}"
            SelectionChanged="HistoryGrid_OnSelectionChanged">
   <DataGrid.Columns>
    <DataGridTemplateColumn Width="132">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Button Content="{l:Tr Sales_ViewBillItems}" Tag="{Binding}" Click="ViewBillItems_OnClick"
              HorizontalAlignment="Center" VerticalAlignment="Center" Height="28" MinHeight="0" MinWidth="0"
              Padding="8,2" FontSize="11"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Width="155" Header="{l:Tr Sales_Invoice}" Binding="{Binding InvoiceNumber}"/>
    <DataGridTextColumn Width="115" Header="{l:Tr Sales_Date}" Binding="{Binding SaleDate}"/>
    <DataGridTextColumn Width="145" Header="{l:Tr Purchasing_Status}" Binding="{Binding Status,Converter={StaticResource SaleStatusConverter}}"/>
    <DataGridTextColumn Width="78" Header="{l:Tr Sales_Items}" Binding="{Binding LineCount}"/>
    <DataGridTextColumn Width="125" Header="{l:Tr Purchasing_Total}" Binding="{Binding GrandTotal}"/>
    <DataGridTextColumn Width="155" Header="{l:Tr Purchasing_Mode}" Binding="{Binding PaymentModes,Converter={StaticResource PaymentModesConverter}}"/>
   </DataGrid.Columns>
  </DataGrid>
  <Grid Grid.RowSpan="4" Panel.ZIndex="10" Visibility="Collapsed" x:Name="DetailOverlay">
   <Border x:Name="DetailBackdrop" Background="#88000000" MouseDown="DetailBackdrop_OnMouseDown"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="DetailPanel" Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
           BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="18">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="DetailHeading" FontSize="17" FontWeight="SemiBold" Text="{l:Tr Sales_SelectHistory}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Margin="12,0,0,0" Click="CloseDetails_OnClick" Content="{l:Tr Common_Close}"/>
    </Grid>
    <TabControl x:Name="DetailTabs" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="DetailTabs_OnSelectionChanged">
     <TabItem Header="{l:Tr Sales_Items}">
    <DataGrid x:Name="DetailGrid" Style="{StaticResource CompactTableGrid}" RowHeight="38">
     <DataGrid.Columns>
      <DataGridTextColumn Width="240" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
      <DataGridTextColumn Width="105" Header="{l:Tr Catalog_Sku}" Binding="{Binding SkuDisplay,Converter={StaticResource LegacySnapshotTextConverter}}"/>
      <DataGridTextColumn Width="105" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
      <DataGridTextColumn Width="115" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchDisplay,Converter={StaticResource LegacySnapshotTextConverter}}"/>
      <DataGridTextColumn Width="115" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDisplay,Converter={StaticResource LegacySnapshotTextConverter}}"/>
      <DataGridTextColumn Width="85" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
      <DataGridTextColumn Width="110" Header="{l:Tr Catalog_Price}" Binding="{Binding UnitPrice}"/>
      <DataGridTextColumn Width="120" Header="{l:Tr Purchasing_Total}" Binding="{Binding Total}"/>
     </DataGrid.Columns>
    </DataGrid>
     </TabItem>
     <TabItem Header="{l:Tr Sales_ReturnsTab}">
      <DataGrid x:Name="ReturnsGrid" Style="{StaticResource CompactTableGrid}" RowHeight="34">
       <DataGrid.Columns>
        <DataGridTextColumn Width="120" Header="{l:Tr Sales_Return}" Binding="{Binding ReturnNumber}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Sales_Date}" Binding="{Binding Date}"/>
        <DataGridTextColumn Width="*" MinWidth="160" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding RestockLotCode}"/>
        <DataGridTextColumn Width="90" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Receipt_RefundTotal}" Binding="{Binding Refund}"/>
        <DataGridTextColumn Width="135" Header="{l:Tr Sales_ReturnRestockHeader}" Binding="{Binding DispositionCode,Converter={StaticResource SaleActivityConverter}}"/>
        <DataGridTextColumn Width="150" Header="{l:Tr Stock_Reason}" Binding="{Binding Reason}"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="{l:Tr Sales_MovementsTab}">
      <DataGrid x:Name="MovementsGrid" Style="{StaticResource CompactTableGrid}" RowHeight="34">
       <DataGrid.Columns>
        <DataGridTextColumn Width="110" Header="{l:Tr Sales_Date}" Binding="{Binding Date}"/>
        <DataGridTextColumn Width="*" MinWidth="160" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
        <DataGridTextColumn Width="140" Header="{l:Tr Stock_MovementType}" Binding="{Binding Type,Converter={StaticResource SaleActivityConverter}}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
     <TextBlock x:Name="DetailPageText" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <Button x:Name="PreviousDetailButton" Click="PreviousDetail_OnClick" Content="{l:Tr Sales_Previous}"/>
     <Button x:Name="NextDetailButton" Margin="6,0,0,0" Click="NextDetail_OnClick" Content="{l:Tr Sales_Next}"/>
    </StackPanel>
   </Grid>
   </Border></Grid>
  </Grid>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Common_RowsPerPage}"/>
    <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="120" SelectedIndex="2" SelectionChanged="PageSize_OnChanged">
     <ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/>
    </ComboBox>
    <Button x:Name="PreviousButton" Margin="12,0,0,0" Click="Previous_OnClick" Content="{l:Tr Sales_Previous}"/>
    <Button x:Name="NextButton" Margin="6,0,0,0" Click="Next_OnClick" Content="{l:Tr Sales_Next}"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="ReprintButton" Margin="0,0,8,0" Click="Reprint_OnClick" Content="{l:Tr Sales_Reprint}"/>
    <Button x:Name="VoidButton" Margin="0,0,8,0" Click="Void_OnClick" Content="{l:Tr Sales_Void}"/>
    <Button x:Name="ReturnButton" Click="Return_OnClick" Content="{l:Tr Sales_Return}"/>
   </StackPanel>
  </Grid>
 </Grid>
</Page>
