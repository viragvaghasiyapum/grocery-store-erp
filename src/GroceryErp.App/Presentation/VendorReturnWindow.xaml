<Window x:Class="GroceryErp.App.Presentation.VendorReturnWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 Title="{l:Tr Purchasing_VendorReturn}" Width="980" Height="650" MinWidth="780" MinHeight="530"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
 NumberSubstitution.Substitution="European">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Purchasing_VendorReturn}"/>
  <WrapPanel Grid.Row="1" Margin="0,12,0,12">
   <StackPanel Margin="0,0,12,0"><TextBlock Text="{l:Tr Purchasing_Date}"/><DatePicker x:Name="DatePicker" Width="145" SelectedDateFormat="Short"/></StackPanel>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="{l:Tr Purchasing_CreditNumber}"/><TextBox x:Name="CreditNumberBox" Width="180" Height="34"/></StackPanel>
   <StackPanel><TextBlock Text="{l:Tr Stock_Reason}"/><TextBox x:Name="ReasonBox" Width="350" Height="34"/></StackPanel>
  </WrapPanel>
  <TextBlock Grid.Row="2" Margin="0,0,0,10" Text="{l:Tr Purchasing_ReturnHint}" TextWrapping="Wrap"/>
  <DataGrid Style="{StaticResource CatalogGrid}" x:Name="ReturnGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" RowHeight="42">
   <DataGrid.Columns>
    <DataGridTextColumn Width="*" MinWidth="200" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}" IsReadOnly="True"/>
    <DataGridTextColumn Width="120" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}" IsReadOnly="True"/>
    <DataGridTextColumn Width="95" Header="{l:Tr Stock_OnHand}" Binding="{Binding OnHand}" IsReadOnly="True"/>
    <DataGridTextColumn Width="95" Header="{l:Tr Sales_ReturnRemainingHeader}" Binding="{Binding Returnable}" IsReadOnly="True"/>
    <DataGridTextColumn Width="100" Header="{l:Tr Stock_Quantity}" Binding="{Binding QuantityText,UpdateSourceTrigger=PropertyChanged}"/>
    <DataGridTextColumn Width="150" Header="{l:Tr Purchasing_CreditBeforeTax}" Binding="{Binding BeforeTaxText,UpdateSourceTrigger=PropertyChanged}"/>
    <DataGridTextColumn Width="105" Header="{l:Tr Purchasing_TaxCredit}" Binding="{Binding TaxText,UpdateSourceTrigger=PropertyChanged}"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="TotalsText" Grid.Row="4" Margin="0,12,0,0" FontWeight="SemiBold"/>
  <Grid Grid.Row="5" Margin="0,14,0,0">
   <TextBlock x:Name="ErrorText" Margin="0,0,220,0" TextWrapping="Wrap" Foreground="Firebrick" VerticalAlignment="Center"/>
   <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
    <Button Width="90" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
    <Button x:Name="PostButton" Width="120" Margin="8,0,0,0" Click="Post_OnClick" Content="{l:Tr Purchasing_PostReturn}"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
