<Window x:Class="GroceryErp.App.Presentation.VendorReturnWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 xmlns:p="clr-namespace:GroceryErp.App.Presentation"
 Title="{l:Tr Purchasing_VendorReturn}" Width="1040" Height="650" MinWidth="800" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
 NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr Purchasing_VendorReturn}"/>
   <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Purchasing_ReturnHint}"/>
  </StackPanel>
  <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
  <WrapPanel x:Name="Fields" Grid.Row="2" Margin="0,8,0,0">
   <p:FormField x:Name="DateField" Width="160" Label="{l:Tr Purchasing_Date}" IsRequired="True"><DatePicker x:Name="DatePicker" SelectedDateFormat="Short"/></p:FormField>
   <p:FormField x:Name="CreditField" Width="190" Label="{l:Tr Purchasing_CreditNumber}"><TextBox x:Name="CreditNumberBox" MaxLength="60"/></p:FormField>
   <p:FormField x:Name="ReasonField" Width="360" Label="{l:Tr Stock_Reason}" IsRequired="True"><TextBox x:Name="ReasonBox" MaxLength="500"/></p:FormField>
  </WrapPanel>
  <DataGrid Style="{StaticResource CatalogGrid}" x:Name="ReturnGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" RowHeight="40"
            AutomationProperties.Name="{l:Tr Purchasing_VendorReturn}">
   <DataGrid.Columns>
    <DataGridTextColumn Width="*" MinWidth="180" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}" IsReadOnly="True"/>
    <DataGridTextColumn Width="115" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}" IsReadOnly="True"/>
    <DataGridTextColumn Width="85" Header="{l:Tr Purchasing_ReturnReceived}" Binding="{Binding Received}" IsReadOnly="True"/>
    <DataGridTextColumn Width="85" Header="{l:Tr Purchasing_ReturnAlready}" Binding="{Binding AlreadyReturned}" IsReadOnly="True"/>
    <DataGridTextColumn Width="85" Header="{l:Tr Stock_OnHand}" Binding="{Binding OnHand}" IsReadOnly="True"/>
    <DataGridTextColumn Width="90" Header="{l:Tr Sales_ReturnRemainingHeader}" Binding="{Binding Returnable}" IsReadOnly="True"/>
    <DataGridTextColumn Width="95" Header="{l:Tr Stock_Quantity}" Binding="{Binding QuantityText,UpdateSourceTrigger=PropertyChanged}"/>
    <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_CreditBeforeTax}" Binding="{Binding BeforeTaxText,UpdateSourceTrigger=PropertyChanged}"/>
    <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_TaxCredit}" Binding="{Binding TaxText,UpdateSourceTrigger=PropertyChanged}"/>
   </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="4" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Style="{StaticResource FormFooter}" Margin="0">
    <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
    <Button x:Name="PostButton" Click="Post_OnClick" Content="{l:Tr Purchasing_PostReturn}"/>
   </StackPanel>
   <TextBlock x:Name="TotalsText" Style="{StaticResource FormPreview}" Margin="0" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</Window>
