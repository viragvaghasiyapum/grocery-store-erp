<Window x:Class="GroceryErp.App.Presentation.LotBulkDamageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr Stock_BulkDamage}" Width="800" Height="560" MinWidth="640" MinHeight="440"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr Stock_BulkDamage}"/>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Stock_BulkDamageContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <WrapPanel x:Name="Fields" Grid.Row="2" Margin="0,8,0,0">
      <p:FormField x:Name="ReasonField" Width="200" Label="{l:Tr MoneyOut_Reason}" IsRequired="True">
        <ComboBox x:Name="ReasonBox" SelectedIndex="0">
          <ComboBoxItem Tag="EXPIRED" Content="{l:Tr MoneyOut_ReasonExpired}"/>
          <ComboBoxItem Tag="BROKEN" Content="{l:Tr MoneyOut_ReasonBroken}"/>
          <ComboBoxItem Tag="SPOILED" Content="{l:Tr MoneyOut_ReasonSpoiled}"/>
          <ComboBoxItem Tag="PEST" Content="{l:Tr MoneyOut_ReasonPest}"/>
          <ComboBoxItem Tag="LOST" Content="{l:Tr MoneyOut_ReasonLost}"/>
          <ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/>
        </ComboBox>
      </p:FormField>
      <p:FormField x:Name="DateField" Width="180" Label="{l:Tr MoneyOut_DamageDate}" IsRequired="True">
        <DatePicker x:Name="DateBox" SelectedDateFormat="Short"/>
      </p:FormField>
    </WrapPanel>
    <DataGrid x:Name="LinesGrid" Grid.Row="3" Style="{StaticResource CompactTableGrid}"
              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" CellEditEnding="LinesGrid_OnCellEditEnding"
              AutomationProperties.Name="{l:Tr Stock_BulkDamage}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="120" IsReadOnly="True" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
        <DataGridTextColumn Width="*" IsReadOnly="True" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="100" IsReadOnly="True" Header="{l:Tr Stock_Available}" Binding="{Binding Available}"/>
        <DataGridTextColumn Width="100" IsReadOnly="True" Header="{l:Tr Stock_UnitCost}" Binding="{Binding UnitCost}"/>
        <DataGridTextColumn Width="110" Header="{l:Tr Stock_Quantity}" Binding="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Style="{StaticResource FormFooter}" Margin="0">
        <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
        <Button x:Name="SaveButton" Click="Save_OnClick" Content="{l:Tr MoneyOut_RecordDamage}"/>
      </StackPanel>
      <TextBlock x:Name="PreviewText" Style="{StaticResource FormPreview}" Margin="0" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
