<Window x:Class="GroceryErp.App.Presentation.VendorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Purchasing_NewVendor}" Width="650" Height="650" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="0,0,18,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,8,10"><TextBlock Text="{l:Tr Catalog_Name}"/><TextBox x:Name="NameBox"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Purchasing_Contact}"/><TextBox x:Name="ContactBox"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,8,10"><TextBlock Text="{l:Tr Purchasing_Phone}"/><TextBox x:Name="PhoneBox"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Purchasing_AltPhone}"/><TextBox x:Name="AltPhoneBox"/></StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,8,10"><TextBlock Text="{l:Tr Purchasing_Email}"/><TextBox x:Name="EmailBox"/></StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="GSTIN"/><TextBox x:Name="GstinBox"/></StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,8,10"><TextBlock Text="PAN"/><TextBox x:Name="PanBox"/></StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Purchasing_Pincode}"/><TextBox x:Name="PincodeBox"/></StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,8,10"><TextBlock Text="{l:Tr Purchasing_City}"/><TextBox x:Name="CityBox"/></StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Purchasing_State}"/><TextBox x:Name="StateBox"/></StackPanel>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="{l:Tr Purchasing_Address}"/><TextBox x:Name="AddressBox"/></StackPanel>
        <StackPanel Grid.Row="6" Margin="0,0,8,10"><TextBlock Text="{l:Tr Purchasing_Upi}"/><TextBox x:Name="UpiBox"/></StackPanel>
        <StackPanel Grid.Row="6" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{l:Tr Purchasing_Terms}"/><TextBox x:Name="TermsBox" Text="0"/></StackPanel>
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="{l:Tr Purchasing_Bank}"/><TextBox x:Name="BankBox"/></StackPanel>
        <StackPanel Grid.Row="8" Margin="0,0,8,10"><TextBlock Text="{l:Tr Purchasing_OpeningBalance}"/><TextBox x:Name="OpeningBox" Text="0"/></StackPanel>
        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="NotesBox" Height="60" AcceptsReturn="True"/></StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="10" Grid.ColumnSpan="2" Foreground="Crimson" TextWrapping="Wrap"/>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Margin="0,0,8,0" Click="Save_OnClick" Content="{l:Tr Common_Save}"/>
      <Button Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/>
    </StackPanel>
  </Grid>
</Window>
