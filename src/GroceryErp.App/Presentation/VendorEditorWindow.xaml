<Window x:Class="GroceryErp.App.Presentation.VendorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        xmlns:p="clr-namespace:GroceryErp.App.Presentation"
        Title="{l:Tr Purchasing_NewVendor}" Width="660" Height="660" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
        NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="vendor-editor">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="TitleText" Style="{StaticResource FormTitle}" Text="{l:Tr Purchasing_NewVendor}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr Purchasing_VendorContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Fields" Margin="0,0,10,0">
        <TextBlock Style="{StaticResource FormSection}" Text="{l:Tr Purchasing_SectionContact}"/>
        <UniformGrid Columns="2">
          <p:FormField x:Name="NameField" Label="{l:Tr Catalog_Name}" IsRequired="True"><TextBox x:Name="NameBox" MaxLength="120"/></p:FormField>
          <p:FormField Label="{l:Tr Purchasing_Contact}"><TextBox x:Name="ContactBox" MaxLength="120"/></p:FormField>
          <p:FormField Label="{l:Tr Purchasing_Phone}"><TextBox x:Name="PhoneBox" MaxLength="20"/></p:FormField>
          <p:FormField Label="{l:Tr Purchasing_AltPhone}"><TextBox x:Name="AltPhoneBox" MaxLength="20"/></p:FormField>
          <p:FormField Label="{l:Tr Purchasing_Email}"><TextBox x:Name="EmailBox" MaxLength="120"/></p:FormField>
        </UniformGrid>
        <TextBlock Style="{StaticResource FormSection}" Text="{l:Tr Purchasing_SectionTax}"/>
        <UniformGrid Columns="2">
          <p:FormField x:Name="GstinField" Label="GSTIN" Hint="{l:Tr Purchasing_GstinHint}"><TextBox x:Name="GstinBox" MaxLength="15" CharacterCasing="Upper"/></p:FormField>
          <p:FormField x:Name="PanField" Label="PAN"><TextBox x:Name="PanBox" MaxLength="10" CharacterCasing="Upper"/></p:FormField>
        </UniformGrid>
        <TextBlock Style="{StaticResource FormSection}" Text="{l:Tr Purchasing_SectionAddress}"/>
        <p:FormField Label="{l:Tr Purchasing_Address}"><TextBox x:Name="AddressBox" MaxLength="300"/></p:FormField>
        <UniformGrid Columns="3">
          <p:FormField Label="{l:Tr Purchasing_City}"><TextBox x:Name="CityBox" MaxLength="80"/></p:FormField>
          <p:FormField Label="{l:Tr Purchasing_State}"><TextBox x:Name="StateBox" MaxLength="80"/></p:FormField>
          <p:FormField x:Name="PincodeField" Label="{l:Tr Purchasing_Pincode}"><TextBox x:Name="PincodeBox" MaxLength="6"/></p:FormField>
        </UniformGrid>
        <TextBlock Style="{StaticResource FormSection}" Text="{l:Tr Purchasing_SectionPayment}"/>
        <UniformGrid Columns="2">
          <p:FormField Label="{l:Tr Purchasing_Upi}"><TextBox x:Name="UpiBox" MaxLength="80"/></p:FormField>
          <p:FormField x:Name="TermsField" Label="{l:Tr Purchasing_Terms}" IsRequired="True"><TextBox x:Name="TermsBox" Text="0"/></p:FormField>
          <p:FormField x:Name="OpeningField" Label="{l:Tr Purchasing_OpeningBalance}" IsRequired="True"><TextBox x:Name="OpeningBox" Text="0"/></p:FormField>
        </UniformGrid>
        <p:FormField Label="{l:Tr Purchasing_Bank}"><TextBox x:Name="BankBox" MaxLength="300"/></p:FormField>
        <p:FormField Label="{l:Tr Purchasing_Notes}"><TextBox x:Name="NotesBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500"/></p:FormField>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveButton" IsDefault="True" Click="Save_OnClick" Content="{l:Tr Common_Save}"/>
    </StackPanel>
  </Grid>
</Window>
