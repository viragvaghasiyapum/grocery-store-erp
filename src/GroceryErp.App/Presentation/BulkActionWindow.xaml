<Window x:Class="GroceryErp.App.Presentation.BulkActionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Width="580" Height="470" MinWidth="460" MinHeight="380"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="TitleText" Style="{StaticResource FormTitle}"/>
      <TextBlock x:Name="SelectionText" Style="{StaticResource FormContext}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource FormSection}" Text="{l:Tr Bulk_Preview}"/>
        <TextBlock x:Name="PlanText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="SkipText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
        <TextBlock x:Name="EffectText" Style="{StaticResource FormPreview}" Margin="0,8,0,0"/>
        <StackPanel x:Name="ProgressPanel" Margin="0,8,0,0" Visibility="Collapsed">
          <TextBlock Style="{StaticResource FormSection}" Text="{l:Tr Bulk_Progress}"/>
          <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1"/>
          <TextBlock x:Name="ProgressText" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <StackPanel x:Name="ResultPanel" Margin="0,8,0,0" Visibility="Collapsed">
          <TextBlock Style="{StaticResource FormSection}" Text="{l:Tr Bulk_Result}"/>
          <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="OperationText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"/>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button x:Name="SaveResultButton" DockPanel.Dock="Left" IsEnabled="False" Click="SaveResult_OnClick" Content="{l:Tr Bulk_SaveResult}"/>
      <StackPanel Style="{StaticResource FormFooter}" Margin="0">
        <Button x:Name="CloseButton" Margin="0,0,8,0" Click="Close_OnClick" Content="{l:Tr Common_Cancel}"/>
        <Button x:Name="RunButton" IsDefault="True" IsEnabled="False" Click="Run_OnClick"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
