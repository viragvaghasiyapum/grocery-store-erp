<Page x:Class="GroceryErp.App.Presentation.ReportsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 xmlns:p="clr-namespace:GroceryErp.App.Presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="{l:Tr Reports_Title}" FontFamily="{StaticResource AppFont}" ScrollViewer.CanContentScroll="False" p:ScreenHelp.Topic="reports">
 <Grid Margin="14,8,14,8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- One title row with the actions; the totals and the status line stay in view under the table. -->
  <DockPanel Margin="0,0,0,6">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Style="{StaticResource ToolbarButton}" Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}"/>
    <Menu VerticalAlignment="Center" Background="Transparent">
     <MenuItem Header="{l:Tr Common_Actions}">
      <MenuItem x:Name="ExportExcelButton" Click="Export_OnClick" Header="{l:Tr Reports_ExportExcel}"/>
      <MenuItem x:Name="PnlCsvButton" Click="ExportPnlCsv_OnClick" Header="{l:Tr Reports_ExportPnlCsv}"/>
      <MenuItem x:Name="FullCsvButton" Click="ExportFullCsv_OnClick" Header="{l:Tr Reports_ExportFullCsv}"/>
      <MenuItem x:Name="PreviewA4Button" Click="Preview_OnClick" Header="{l:Tr Reports_PrintA4}"/>
     </MenuItem>
    </Menu>
   </StackPanel>
   <!-- Shown only while an export runs. -->
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
    <ProgressBar x:Name="ExportProgress" Width="64" Height="5" Margin="0,0,8,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed"/>
    <Button x:Name="CancelExportButton" Style="{StaticResource ToolbarButton}" Margin="0" IsEnabled="False" Visibility="Collapsed" Click="CancelExport_OnClick" Content="{l:Tr Reports_CancelExport}"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal">
    <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,6,0" Text="{l:Tr Reports_Title}"/>
    <p:HelpButton VerticalAlignment="Center"/>
   </StackPanel>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,2">
   <TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="{l:Tr Reports_Report}"/>
   <ComboBox x:Name="ReportPicker" Width="230" Margin="0,0,14,6" SelectionChanged="ReportPicker_OnSelectionChanged" AutomationProperties.Name="{l:Tr Reports_Report}"/>
   <StackPanel x:Name="PnlPeriodControls" Orientation="Horizontal" Margin="0,0,14,6">
    <ComboBox x:Name="ScopePicker" Width="150" Margin="0,0,8,0" SelectionChanged="ScopePicker_OnSelectionChanged" AutomationProperties.Name="{l:Tr Reports_PnlScope}"/>
    <ComboBox x:Name="PnlPeriodPicker" Width="250" SelectionChanged="PnlPeriodPicker_OnSelectionChanged" AutomationProperties.Name="{l:Tr Reports_Period}"/>
   </StackPanel>
   <StackPanel x:Name="RangeControls" Orientation="Horizontal" Margin="0,0,14,6">
    <ComboBox x:Name="PeriodPicker" Width="140" Margin="0,0,8,0" SelectionChanged="PeriodPicker_OnSelectionChanged" AutomationProperties.Name="{l:Tr Reports_Period}"/>
    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Tr Reports_From}"/>
    <DatePicker x:Name="FromPicker" Width="132" Margin="0,0,8,0" Language="en-IN" SelectedDateFormat="Short" SelectedDateChanged="DatePicker_OnSelectedDateChanged" AutomationProperties.Name="{l:Tr Reports_From}"/>
    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Tr Reports_To}"/>
    <DatePicker x:Name="ToPicker" Width="132" Language="en-IN" SelectedDateFormat="Short" SelectedDateChanged="DatePicker_OnSelectedDateChanged" AutomationProperties.Name="{l:Tr Reports_To}"/>
   </StackPanel>
   <CheckBox x:Name="MonthsCheck" Margin="0,0,14,6" Click="MonthsCheck_OnClick" Content="{l:Tr Reports_MonthlyMatrix}"/>
   <CheckBox x:Name="CompareCheck" Margin="0,0,14,6" Click="CompareCheck_OnClick" Content="{l:Tr Reports_ComparePrevious}"/>
   <CheckBox x:Name="IncludeExpiredCheck" Visibility="Collapsed" IsChecked="True" Margin="0,0,14,6" Click="IncludeExpired_OnClick" Content="{l:Tr Reports_IncludeExpired}"/>
   <CheckBox x:Name="MismatchesCheck" Visibility="Collapsed" Margin="0,0,14,6" Click="IncludeExpired_OnClick" Content="{l:Tr Reports_MismatchesOnly}"/>
   <ToggleButton x:Name="MoreFiltersToggle" Margin="0,0,0,6" MinHeight="32" Padding="10,4" Click="MoreFilters_OnClick"
                 Content="{l:Tr Common_MoreFilters}"/>
  </WrapPanel>
  <!-- Only the filters that apply to the chosen report are shown. -->
  <WrapPanel x:Name="MoreFiltersPanel" Grid.Row="2" Margin="0,0,0,2" Visibility="Collapsed">
    <StackPanel x:Name="StatusFilterPanel" Orientation="Horizontal"><TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="{l:Tr Reports_Status}"/><ComboBox x:Name="StatusPicker" Width="130" Margin="0,0,12,6" SelectionChanged="FilterPicker_OnSelectionChanged" AutomationProperties.Name="{l:Tr Reports_Status}"/></StackPanel>
    <StackPanel x:Name="PaymentFilterPanel" Orientation="Horizontal"><TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="{l:Tr Reports_Payment}"/><ComboBox x:Name="PaymentPicker" Width="130" Margin="0,0,12,6" SelectionChanged="FilterPicker_OnSelectionChanged" AutomationProperties.Name="{l:Tr Reports_Payment}"/></StackPanel>
    <!-- A product is found by name, SKU or barcode; several matches are listed under the box. -->
    <StackPanel x:Name="ProductFilterPanel" Orientation="Horizontal">
     <TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="{l:Tr Reports_FilterProduct}"/>
     <Grid Margin="0,0,12,6">
      <ui:TextBox x:Name="ProductFilter" Width="240" PlaceholderText="{l:Tr Reports_ProductSearch}" ToolTip="{l:Tr Purchasing_ProductSearchHint}"
                  KeyDown="ProductFilter_OnKeyDown" TextChanged="ProductFilter_OnTextChanged" AutomationProperties.Name="{l:Tr Reports_FilterProduct}"/>
      <p:ProductChoices x:Name="ProductChoices" PlacementTarget="{Binding ElementName=ProductFilter}"
                        Picked="ProductChoices_OnPicked" Closed="ProductChoices_OnClosed"/>
     </Grid>
    </StackPanel>
    <StackPanel x:Name="VendorFilterPanel" Orientation="Horizontal"><TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="{l:Tr Reports_FilterVendor}"/><ComboBox x:Name="VendorFilter" Width="220" Margin="0,0,12,6" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterPicker_OnSelectionChanged" AutomationProperties.Name="{l:Tr Reports_FilterVendor}"/></StackPanel>
  </WrapPanel>
  <Border Grid.Row="3" Padding="6" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="PnlStatusBadge" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="8,3" CornerRadius="4" Visibility="Collapsed"
           Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
           ToolTip="{l:Tr Reports_PnlExplanation}">
    <TextBlock x:Name="PnlStatusText" TextWrapping="Wrap"/>
   </Border>
   <DataGrid x:Name="ReportGrid" Grid.Row="1" Style="{StaticResource CompactTableGrid}" RowHeight="34"/>
   <Grid x:Name="PnlPanel" Grid.Row="1" Visibility="Collapsed">
    <DataGrid x:Name="PnlGrid" Style="{StaticResource CompactTableGrid}" RowHeight="32" IsReadOnly="True"
              AutoGenerateColumns="False" PreviewMouseLeftButtonUp="PnlGrid_OnPreviewMouseLeftButtonUp" PreviewKeyDown="PnlGrid_OnPreviewKeyDown"
              AutomationProperties.Name="{l:Tr Reports_Kind_ProfitAndLoss}">
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
       <Style.Triggers><DataTrigger Binding="{Binding IsBold}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Width="*" MinWidth="360" Header="{l:Tr Reports_Particulars}" Binding="{Binding Label}"/>
      <DataGridTextColumn Width="180" Header="{l:Tr Reports_Amount}" Binding="{Binding Amount}">
       <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
   <!-- The totals of the whole result, or the profit and loss margins, under the table. -->
   <p:TotalsBar x:Name="Totals" Grid.Row="2"/>
  </Grid></Border>
  <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource StatusText}" TextWrapping="Wrap"
             TextTrimming="None" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Page>
