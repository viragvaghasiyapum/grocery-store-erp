<Page x:Class="GroceryErp.App.Presentation.ReportsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 Title="{l:Tr Reports_Title}">
 <Grid Margin="20,16,20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock FontSize="26" FontWeight="SemiBold" Text="{l:Tr Reports_Title}"/>
  <Border Grid.Row="1" Margin="0,14,0,12" Padding="16" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
   <StackPanel>
    <WrapPanel>
     <StackPanel Margin="0,0,16,8"><TextBlock Margin="0,0,0,5" Text="{l:Tr Reports_Report}"/><ComboBox x:Name="ReportPicker" Width="220" SelectionChanged="ReportPicker_OnSelectionChanged"/></StackPanel>
     <StackPanel Margin="0,0,16,8"><TextBlock Margin="0,0,0,5" Text="{l:Tr Reports_Period}"/><ComboBox x:Name="PeriodPicker" Width="140" SelectionChanged="PeriodPicker_OnSelectionChanged"/></StackPanel>
     <StackPanel Margin="0,0,16,8"><TextBlock Margin="0,0,0,5" Text="{l:Tr Reports_From}"/><DatePicker x:Name="FromPicker" Width="140" Language="en-IN" SelectedDateFormat="Short" SelectedDateChanged="DatePicker_OnSelectedDateChanged"/></StackPanel>
     <StackPanel Margin="0,0,0,8"><TextBlock Margin="0,0,0,5" Text="{l:Tr Reports_To}"/><DatePicker x:Name="ToPicker" Width="140" Language="en-IN" SelectedDateFormat="Short" SelectedDateChanged="DatePicker_OnSelectedDateChanged"/></StackPanel>
    </WrapPanel>
    <Separator Margin="0,4,0,12"/>
    <WrapPanel>
     <Button Margin="0,0,8,6" Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}"/>
     <Button x:Name="ExportExcelButton" Margin="0,0,8,6" Click="Export_OnClick" Content="{l:Tr Reports_ExportExcel}"/>
     <Button x:Name="FullCsvButton" Margin="0,0,8,6" Click="ExportFullCsv_OnClick" Content="{l:Tr Reports_ExportFullCsv}"/>
     <Button x:Name="CancelExportButton" IsEnabled="False" Margin="0,0,8,6" Click="CancelExport_OnClick" Content="{l:Tr Reports_CancelExport}"/>
     <Button x:Name="PreviewA4Button" Margin="0,0,12,6" Click="Preview_OnClick" Content="{l:Tr Reports_PrintA4}"/>
     <ProgressBar x:Name="ExportProgress" Width="72" Height="5" Margin="0,0,0,6" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Expander x:Name="MoreFiltersExpander" Grid.Row="2" Header="{l:Tr Reports_MoreFilters}" Margin="0,0,0,8">
   <Border Padding="12" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <WrapPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_Status}"/><ComboBox x:Name="StatusPicker" Width="130" SelectionChanged="FilterPicker_OnSelectionChanged"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_Payment}"/><ComboBox x:Name="PaymentPicker" Width="130" SelectionChanged="FilterPicker_OnSelectionChanged"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_FilterProduct}"/><TextBox x:Name="ProductFilter" Width="100"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_FilterLot}"/><TextBox x:Name="LotFilter" Width="100"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_FilterVendor}"/><TextBox x:Name="VendorFilter" Width="100"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_FilterAsset}"/><TextBox x:Name="AssetFilter" Width="100"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_FilterSlowDays}"/><TextBox x:Name="SlowDaysFilter" Width="100" Text="90"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_FilterEntity}"/><TextBox x:Name="EntityFilter" Width="120"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{l:Tr Reports_FilterAction}"/><TextBox x:Name="ActionFilter" Width="120"/></StackPanel>
     <CheckBox x:Name="MatrixCheck" Margin="0,18,14,8" Click="MatrixCheck_OnClick" Content="{l:Tr Reports_MonthlyMatrix}"/>
     <CheckBox x:Name="CompareCheck" Margin="0,18,0,8" Click="CompareCheck_OnClick" Content="{l:Tr Reports_ComparePrevious}"/>
    </WrapPanel>
   </Border>
  </Expander>
  <Border Grid.Row="3" Padding="8" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid>
   <DataGrid x:Name="ReportGrid" Style="{StaticResource CatalogGrid}" RowHeight="38"/>
    <Grid x:Name="PnlPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{l:Tr Reports_PnlExplanation}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <DataGrid x:Name="PnlGrid" Grid.Row="1" Style="{StaticResource CatalogGrid}" RowHeight="38">
      <DataGrid.Columns><DataGridTextColumn Width="*" MinWidth="420" Header="{l:Tr Reports_Particulars}" Binding="{Binding Label}"/><DataGridTextColumn Width="180" Header="{l:Tr Reports_Amount}" Binding="{Binding Amount}"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="PnlTotals" Grid.Row="2" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Grid.Row="3" Text="{l:Tr Reports_PnlCutMonthNote}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
    <ScrollViewer x:Name="HourlyPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="{l:Tr Reports_HourlyHint}" Margin="4,2,4,12" TextWrapping="Wrap"/>
      <UniformGrid x:Name="HourlyGrid" Columns="25" MinWidth="1000"/>
     </StackPanel>
    </ScrollViewer>
  </Grid></Border>
  <Grid Grid.Row="4" Margin="0,8,0,0"><TextBlock x:Name="StatusText"/><TextBlock x:Name="TotalsText" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
 </Grid>
</Page>
