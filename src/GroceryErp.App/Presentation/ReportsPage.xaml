<Page x:Class="GroceryErp.App.Presentation.ReportsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
 Title="{l:Tr Reports_Title}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Tr Reports_Title}"/>
  <WrapPanel Grid.Row="1" Margin="0,14,0,12">
   <ComboBox x:Name="ReportPicker" Width="230" SelectionChanged="ReportPicker_OnSelectionChanged"/>
   <ComboBox x:Name="PeriodPicker" Width="140" Margin="8,0,0,0" SelectionChanged="PeriodPicker_OnSelectionChanged"/>
   <DatePicker x:Name="FromPicker" Width="145" Margin="8,0,0,0"/>
   <DatePicker x:Name="ToPicker" Width="145" Margin="8,0,0,0"/>
   <ComboBox x:Name="StatusPicker" Width="110" Margin="8,0,0,0" SelectionChanged="FilterPicker_OnSelectionChanged"/>
   <ComboBox x:Name="PaymentPicker" Width="110" Margin="8,0,0,0" SelectionChanged="FilterPicker_OnSelectionChanged"/>
   <TextBox x:Name="ProductFilter" Width="70" Margin="8,0,0,0" ToolTip="{l:Tr Reports_FilterProduct}"/>
   <TextBox x:Name="LotFilter" Width="70" Margin="8,0,0,0" ToolTip="{l:Tr Reports_FilterLot}"/>
   <TextBox x:Name="VendorFilter" Width="70" Margin="8,0,0,0" ToolTip="{l:Tr Reports_FilterVendor}"/>
   <TextBox x:Name="AssetFilter" Width="70" Margin="8,0,0,0" ToolTip="{l:Tr Reports_FilterAsset}"/>
   <TextBox x:Name="SlowDaysFilter" Width="70" Margin="8,0,0,0" Text="90" ToolTip="{l:Tr Reports_FilterSlowDays}"/>
   <TextBox x:Name="EntityFilter" Width="90" Margin="8,0,0,0" ToolTip="{l:Tr Reports_FilterEntity}"/>
   <TextBox x:Name="ActionFilter" Width="90" Margin="8,0,0,0" ToolTip="{l:Tr Reports_FilterAction}"/>
   <CheckBox x:Name="MatrixCheck" Margin="12,0,0,0" VerticalAlignment="Center" Click="MatrixCheck_OnClick" Content="{l:Tr Reports_MonthlyMatrix}"/>
   <CheckBox x:Name="CompareCheck" Margin="12,0,0,0" VerticalAlignment="Center" Click="CompareCheck_OnClick" Content="{l:Tr Reports_ComparePrevious}"/>
   <Button Margin="8,0,0,0" Click="Refresh_OnClick" Content="{l:Tr Stock_Refresh}"/>
   <Button Margin="8,0,0,0" Click="Export_OnClick" Content="{l:Tr Reports_ExportExcel}"/>
   <Button Margin="8,0,0,0" Click="Preview_OnClick" Content="{l:Tr Reports_PrintA4}"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <DataGrid x:Name="ReportGrid" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"
             EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="32"/>
   <ScrollViewer x:Name="PnlPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{l:Tr Reports_PnlExplanation}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <DataGrid x:Name="PnlGrid" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" EnableRowVirtualization="True">
      <DataGrid.Columns><DataGridTextColumn Width="*" Header="{l:Tr Reports_Particulars}" Binding="{Binding Label}"/><DataGridTextColumn Width="180" Header="{l:Tr Reports_Amount}" Binding="{Binding Amount}"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="PnlTotals" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="{l:Tr Reports_PnlCutMonthNote}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="StatusText"/><TextBlock x:Name="TotalsText" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
 </Grid>
</Page>
