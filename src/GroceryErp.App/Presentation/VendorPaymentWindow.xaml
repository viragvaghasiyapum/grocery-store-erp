<Window x:Class="GroceryErp.App.Presentation.VendorPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Purchasing_Payment}" Width="470" Height="600" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,18,0">
    <TextBlock Text="{l:Tr Purchasing_Vendor}"/><ComboBox x:Name="VendorBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="VendorBox_OnSelectionChanged" Margin="0,4,0,10"/>
    <TextBlock Text="{l:Tr Purchasing_OptionalPurchase}"/>
    <TextBox x:Name="PurchaseSearchBox" Margin="0,4,0,6" TextChanged="PurchaseSearch_OnChanged" ToolTip="Search document or vendor invoice"/>
    <ComboBox x:Name="PurchaseBox" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,0,0,6"/>
    <TextBlock Text="{l:Tr Purchasing_Received}"/><DatePicker x:Name="DateBox" Margin="0,4,0,10"/>
    <TextBlock Text="{l:Tr Purchasing_Amount}"/><TextBox x:Name="AmountBox" Margin="0,4,0,10"/>
    <TextBlock Text="{l:Tr Purchasing_Mode}"/><ComboBox x:Name="ModeBox" Margin="0,4,0,10"><ComboBoxItem Content="CASH"/><ComboBoxItem Content="UPI"/><ComboBoxItem Content="BANK"/><ComboBoxItem Content="CHEQUE"/><ComboBoxItem Content="OTHER"/></ComboBox>
    <TextBlock Text="{l:Tr Purchasing_Reference}"/><TextBox x:Name="ReferenceBox" Margin="0,4,0,10"/>
    <TextBlock Text="{l:Tr Purchasing_Notes}"/><TextBox x:Name="NotesBox" Margin="0,4,0,10"/>
    <TextBlock x:Name="ErrorText" Foreground="Crimson" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="1" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="PurchasePreviousButton" IsEnabled="False" Click="PurchasePrevious_OnClick" Content="{l:Tr Sales_Previous}" Margin="0,0,8,0"/>
        <Button x:Name="PurchaseNextButton" IsEnabled="False" Click="PurchaseNext_OnClick" Content="{l:Tr Sales_Next}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Common_RowsPerPage}"/>
        <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="88" SelectedIndex="2" SelectionChanged="PageSize_OnChanged"><ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox>
      </StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0"><Button Margin="0,0,8,0" Click="Save_OnClick" Content="{l:Tr Common_Save}"/><Button Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/></StackPanel>
  </Grid>
</Window>
