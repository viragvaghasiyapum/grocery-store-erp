<UserControl x:Class="GroceryErp.App.Presentation.ProductLedgerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6">
      <Button x:Name="OpenSourceButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" IsEnabled="False"
              Click="OpenSource_OnClick" Content="{l:Tr Stock_OpenSource}"/>
      <TextBlock Style="{StaticResource FormContext}" Margin="0" VerticalAlignment="Center" Text="{l:Tr Stock_HistoricalLedgerNote}"/>
    </DockPanel>
    <DataGrid x:Name="LedgerGrid" Grid.Row="1" Style="{StaticResource CompactTableGrid}" SelectionChanged="LedgerGrid_OnSelectionChanged"
              AutomationProperties.Name="{l:Tr Stock_Ledger}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="100" Header="{l:Tr Stock_MoveDate}" Binding="{Binding MoveDate, StringFormat=dd MMM yyyy}"/>
        <DataGridTextColumn Width="115" Header="{l:Tr Stock_MovementType}" Binding="{Binding Type}"/>
        <DataGridTextColumn Width="105" Header="{l:Tr Stock_LotCode}" Binding="{Binding LotCode}"/>
        <DataGridTextColumn Width="90" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
        <DataGridTextColumn Width="90" Header="{l:Tr Stock_OnHand}" Binding="{Binding LotBalance}"/>
        <DataGridTextColumn Width="*" MinWidth="140" Header="{l:Tr Purchasing_Notes}" Binding="{Binding Note}"/>
        <DataGridTextColumn Width="100" Header="{l:Tr Stock_Source}" Binding="{Binding RefType}"/>
      </DataGrid.Columns>
    </DataGrid>
    <p:PagerBar x:Name="Pager" Grid.Row="2"/>
  </Grid>
</UserControl>
