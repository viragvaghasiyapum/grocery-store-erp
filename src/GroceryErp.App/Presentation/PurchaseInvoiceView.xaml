<UserControl x:Class="GroceryErp.App.Presentation.PurchaseInvoiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <!-- A purchase's lines, totals and notes in the Purchases detail panel, whose header names the
       vendor and dates. The type, SKU and name stay in view while the wide line table scrolls. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="LinesGrid" Style="{StaticResource CatalogGrid}" RowHeight="38" FrozenColumnCount="3"
              AutomationProperties.Name="{l:Tr Purchasing_Lines}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="100" Header="{l:Tr Purchasing_LineType}" Binding="{Binding LineKind, Converter={StaticResource PurchaseLineKindConverter}}"/>
        <DataGridTextColumn Width="80" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}"/>
        <DataGridTextColumn Width="190" Header="{l:Tr Catalog_Name}" Binding="{Binding ProductName}"/>
        <DataGridTextColumn Width="130" Header="{l:Tr Purchasing_ExpenseCategory}" Binding="{Binding ExpenseCategoryName}"/>
        <DataGridTextColumn Width="90" Header="{l:Tr Stock_Batch}" Binding="{Binding BatchNumber}"/>
        <DataGridTextColumn Width="95" Header="{l:Tr Purchasing_MfgDate}" Binding="{Binding ManufacturingDate, StringFormat=dd MMM yyyy}"/>
        <DataGridTextColumn Width="95" Header="{l:Tr Stock_Expiry}" Binding="{Binding ExpiryDate, StringFormat=dd MMM yyyy}"/>
        <DataGridTextColumn Width="75" Header="{l:Tr Stock_Quantity}" Binding="{Binding Quantity}"/>
        <DataGridTextColumn Width="75" Header="{l:Tr Purchasing_FreeQty}" Binding="{Binding FreeQuantity}"/>
        <DataGridTextColumn Width="85" Header="{l:Tr Purchasing_Rate}" Binding="{Binding Rate, Converter={StaticResource Amount}}"/>
        <DataGridTextColumn Width="85" Header="{l:Tr Purchasing_Discount}" Binding="{Binding Discount, Converter={StaticResource Amount}}"/>
        <DataGridTextColumn Width="82" Header="{l:Tr Purchasing_Gst}" Binding="{Binding TaxLabel, TargetNullValue=—}"/>
        <DataGridTextColumn Width="85" Header="{l:Tr Purchasing_TaxTotal}" Binding="{Binding TaxAmount, Converter={StaticResource Amount}}"/>
        <DataGridTextColumn Width="95" Header="{l:Tr Purchasing_ComputedTotal}" Binding="{Binding LineTotal, Converter={StaticResource Amount}}"/>
        <!-- One piece, with its share of other charges: Purchase price + Tax/unit = incl. tax as shown. -->
        <DataGridTextColumn Width="100" Header="{l:Tr Stock_UnitCost}" Binding="{Binding PurchasePrice, Converter={StaticResource Amount}}"/>
        <DataGridTextColumn Width="76" Header="{l:Tr Stock_UnitTax}" Binding="{Binding UnitTaxShown, Converter={StaticResource Amount}}"/>
        <DataGridTextColumn Width="118" Header="{l:Tr Stock_CostInclTax}" Binding="{Binding UnitCostInclTax, Converter={StaticResource Amount}}"/>
        <DataGridTextColumn Width="75" Header="MRP" Binding="{Binding Mrp, Converter={StaticResource Amount}}"/>
        <DataGridTextColumn Width="92" Header="{l:Tr Catalog_Price}" Binding="{Binding SellingPrice, Converter={StaticResource Amount}}"/>
      </DataGrid.Columns>
    </DataGrid>
    <!-- A draft has no saved lines to show; it is finished in the purchase form. -->
    <TextBlock x:Name="DraftText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource FormContext}"
               Text="{l:Tr Purchasing_DraftDetail}"/>
    <Grid x:Name="TotalsRow" Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{l:Tr Purchasing_Subtotal}" Opacity="0.7"/><TextBlock x:Name="SubtotalText" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="{l:Tr Purchasing_Discount}" Opacity="0.7"/><TextBlock x:Name="DiscountText" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="{l:Tr Purchasing_TaxTotal}" Opacity="0.7"/><TextBlock x:Name="TaxText" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="{l:Tr Purchasing_OtherCharges}" Opacity="0.7"/><TextBlock x:Name="ChargesText" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="{l:Tr Purchasing_RoundOff}" Opacity="0.7"/><TextBlock x:Name="RoundOffText" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="5"><TextBlock Text="{l:Tr Purchasing_ComputedTotal}" Opacity="0.7"/><TextBlock x:Name="TotalText" FontWeight="SemiBold"/></StackPanel>
    </Grid>
    <StackPanel x:Name="NotesPanel" Grid.Row="2" Margin="0,10,0,0">
      <TextBlock x:Name="LegacySnapshotText" Foreground="#9A6700" TextWrapping="Wrap"/>
      <TextBlock x:Name="TaxModeText"/>
      <TextBlock x:Name="BillTotalText"/>
      <TextBlock x:Name="DifferenceText"/>
      <TextBlock x:Name="NotesText" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
