<Window x:Class="GroceryErp.App.Presentation.UnknownBarcodeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr Pos_UnknownBarcodeTitle}" Width="780" Height="480" MinWidth="680" MinHeight="460"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="unknown-barcode">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Pos_UnknownBarcodeTitle}"/>
      </DockPanel>
      <TextBlock x:Name="BarcodeText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="16"/>
    </StackPanel>
    <TabControl x:Name="OptionsTabs" Grid.Row="1">
      <TabItem Header="{l:Tr Pos_QuickAdd}">
        <StackPanel Margin="16">
          <TextBlock Text="{l:Tr Pos_QuickAddHint}" TextWrapping="Wrap" Opacity="0.75"/>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{l:Tr Pos_OpeningQuantity}"/>
              <TextBox x:Name="OpeningQuantityBox" AutomationProperties.Name="{l:Tr Pos_OpeningQuantity}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{l:Tr Stock_UnitCost}"/>
              <TextBox x:Name="UnitCostBox" AutomationProperties.Name="{l:Tr Stock_UnitCost}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{l:Tr Pos_OpeningExpiry}"/>
              <TextBox x:Name="ExpiryBox" AutomationProperties.Name="{l:Tr Pos_OpeningExpiry}"/>
            </StackPanel>
          </Grid>
          <Button x:Name="CreateButton" Width="180" Margin="0,22,0,0" HorizontalAlignment="Left"
                  Click="Create_OnClick" Content="{l:Tr Pos_QuickAdd}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="{l:Tr Pos_AttachExisting}">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Margin="0,0,0,4" Text="{l:Tr Catalog_SearchHint}"/>
            <TextBox x:Name="SearchBox" Height="36" VerticalContentAlignment="Center" TextChanged="Search_OnChanged"
                     AutomationProperties.Name="{l:Tr Catalog_SearchHint}"/>
          </StackPanel>
          <DataGrid x:Name="ProductsGrid" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CatalogGrid}"
                    SelectionMode="Single" SelectionChanged="ProductsGrid_OnSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Width="120" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}"/>
              <DataGridTextColumn Width="250" Header="{l:Tr Catalog_Name}" Binding="{Binding Name}"/>
              <DataGridTextColumn Width="155" Header="{l:Tr Catalog_Category}" Binding="{Binding Category}"/>
              <DataGridTextColumn Width="100" Header="{l:Tr Catalog_Stock}" Binding="{Binding Stock}"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="OpenOwnerButton" IsEnabled="False" Margin="0,0,8,0" Click="OpenOwner_OnClick"
                    Content="{l:Tr Pos_OpenBarcodeOwner}"/>
            <Button x:Name="AttachButton" IsEnabled="False" Click="Attach_OnClick" Content="{l:Tr Pos_AttachExisting}"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Margin="0,0,120,0" Foreground="Crimson" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <Button HorizontalAlignment="Right" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
    </Grid>
  </Grid>
</Window>
