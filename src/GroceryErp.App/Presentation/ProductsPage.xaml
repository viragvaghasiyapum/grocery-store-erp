<Page x:Class="GroceryErp.App.Presentation.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Catalog_Title}" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European"
    ScrollViewer.CanContentScroll="False">
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Button Margin="0,0,8,0" Click="Masters_OnClick" Content="{l:Tr Catalog_Masters}"/>
        <Button Margin="0,0,8,0" Click="Import_OnClick" Content="{l:Tr Catalog_Import}"/>
        <Button Click="New_OnClick" Content="{l:Tr Catalog_New}" FontWeight="SemiBold"/>
      </WrapPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Catalog_Title}"/>
        <TextBlock Margin="0,4,12,0" Opacity="0.7" TextWrapping="Wrap" Text="{l:Tr Catalog_Subtitle}"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource CatalogCard}" Margin="0,0,0,16">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Margin="0,0,0,6" Text="{l:Tr Catalog_SearchHint}"/>
          <TextBlock Grid.Column="1" Margin="12,0,0,6" Text="{l:Tr Catalog_Category}"/>
          <TextBlock Grid.Column="2" Margin="12,0,0,6" Text="{l:Tr Catalog_Brand}"/>
          <TextBox x:Name="SearchBox" Grid.Row="1" MinHeight="36" VerticalContentAlignment="Center" TextChanged="SearchBox_OnTextChanged" AutomationProperties.Name="{l:Tr Catalog_SearchHint}"/>
          <ComboBox x:Name="CategoryFilter" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="MasterFilter_OnChanged" ToolTip="{l:Tr Catalog_Category}"/>
          <ComboBox x:Name="BrandFilter" Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="MasterFilter_OnChanged" ToolTip="{l:Tr Catalog_Brand}"/>
          <Menu Grid.Row="1" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
            <MenuItem Header="{l:Tr Catalog_Filters}">
              <MenuItem x:Name="LowStockFilter" IsCheckable="True" Click="Filter_OnChanged" Header="{l:Tr Catalog_LowStock}"/>
              <MenuItem x:Name="NoBarcodeFilter" IsCheckable="True" Click="Filter_OnChanged" Header="{l:Tr Catalog_NoBarcode}"/>
              <MenuItem x:Name="MissingLocalFilter" IsCheckable="True" Click="Filter_OnChanged" Header="{l:Tr Catalog_MissingLocal}"/>
              <MenuItem x:Name="LooseFilter" IsCheckable="True" Click="Filter_OnChanged" Header="{l:Tr Catalog_Loose}"/>
              <MenuItem x:Name="ArchivedFilter" IsCheckable="True" Click="Filter_OnChanged" Header="{l:Tr Catalog_IncludeArchived}"/>
            </MenuItem>
          </Menu>
        </Grid>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
      <Button x:Name="EditButton" IsEnabled="False" Margin="0,0,8,0" Click="Edit_OnClick" Content="{l:Tr Catalog_Edit}"/>
      <Menu VerticalAlignment="Center" Margin="0,0,8,0" MinHeight="36" Padding="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"><MenuItem Header="{l:Tr Common_Actions}">
        <MenuItem x:Name="LotsButton" IsEnabled="False" Click="Lots_OnClick" Header="{l:Tr Stock_Lots}"/>
        <MenuItem x:Name="LedgerButton" IsEnabled="False" Click="Ledger_OnClick" Header="{l:Tr Stock_Ledger}"/>
        <MenuItem x:Name="LabelsButton" IsEnabled="False" Click="Labels_OnClick" Header="{l:Tr Catalog_PrintLabels}"/>
        <MenuItem x:Name="BarcodeButton" IsEnabled="False" Click="GenerateBarcode_OnClick" Header="{l:Tr Catalog_GenerateBarcode}"/>
        <MenuItem x:Name="RestoreButton" IsEnabled="False" Click="Restore_OnClick" Header="{l:Tr Catalog_Restore}"/>
      </MenuItem></Menu>
      <Menu x:Name="BulkActionsMenu" IsEnabled="False" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0" MinHeight="36" Padding="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <MenuItem Header="{l:Tr Catalog_BulkActions}">
          <MenuItem x:Name="BulkRestoreButton" IsEnabled="False" Click="BulkRestore_OnClick" Header="{l:Tr Catalog_RestoreSelected}"/>
          <MenuItem x:Name="BulkRemoveButton" IsEnabled="False" Click="BulkRemove_OnClick" Header="{l:Tr Catalog_RemoveSelected}"/>
          <MenuItem x:Name="BulkButton" Click="Bulk_OnClick" Header="{l:Tr Catalog_BulkEdit}"/>
          <MenuItem Click="BulkLabels_OnClick" Header="{l:Tr Catalog_PrintLabelsSelected}"/>
          <MenuItem x:Name="BulkBarcodeButton" IsEnabled="False" Click="BulkBarcode_OnClick" Header="{l:Tr Catalog_GenerateBarcodeSelected}"/>
        </MenuItem>
      </Menu>
      <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" Text="0 selected"/>
    </StackPanel>
    <Grid Grid.Row="3">
      <DataGrid x:Name="ProductsGrid" Style="{StaticResource CatalogGrid}" SelectionMode="Single" SelectionChanged="ProductsGrid_OnSelectionChanged" MouseDoubleClick="ProductsGrid_OnDoubleClick">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="42">
            <DataGridTemplateColumn.HeaderTemplate><DataTemplate>
              <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsThreeState="True"
                        Loaded="PageSelectionCheck_OnLoaded" Click="PageSelectionCheck_OnClick"
                        AutomationProperties.Name="Select all products on this page"/>
            </DataTemplate></DataGridTemplateColumn.HeaderTemplate>
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Loaded="ProductCheck_OnLoaded"
                        Click="ProductCheck_OnClick" AutomationProperties.Name="Select product"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="110" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}"/>
          <DataGridTemplateColumn Width="2*" MinWidth="170" Header="{l:Tr Catalog_Name}">
            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
              <TextBlock Text="{Binding NameLocal}" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="*" MinWidth="100" Header="{l:Tr Catalog_Category}" Binding="{Binding Category}"/>
          <DataGridTextColumn Width="95" Header="{l:Tr Catalog_Stock}" Binding="{Binding Stock}"/>
          <DataGridTextColumn Width="95" Header="{l:Tr Catalog_Price}" Binding="{Binding SellingPrice}"/>
          <DataGridTextColumn Width="95" Header="{l:Tr Catalog_Mrp}" Binding="{Binding Mrp}"/>
          <DataGridTemplateColumn Width="80" Header="{l:Tr Catalog_Active}">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsChecked="{Binding IsActive, Mode=OneWay}" Click="ProductActive_OnClick"
                        AutomationProperties.Name="{l:Tr Catalog_Active}"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:Tr Catalog_Empty}"/>
    </Grid>
    <DockPanel Grid.Row="4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Common_RowsPerPage}"/>
        <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="120" SelectedIndex="2" SelectionChanged="PageSize_OnChanged">
          <ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/>
        </ComboBox>
        <Button x:Name="PreviousPageButton" IsEnabled="False" Margin="8,0" Click="PreviousPage_OnClick" Content="{l:Tr Sales_Previous}"/>
        <Button x:Name="NextPageButton" IsEnabled="False" Click="NextPage_OnClick" Content="{l:Tr Sales_Next}"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Page>
