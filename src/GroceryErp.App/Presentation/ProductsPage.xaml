<Page x:Class="GroceryErp.App.Presentation.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr Catalog_Title}" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European">
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Button Margin="0,0,8,0" Click="Masters_OnClick" Content="{l:Tr Catalog_Masters}"/>
        <Button Margin="0,0,8,0" Click="Import_OnClick" Content="{l:Tr Catalog_Import}"/>
        <Button Click="New_OnClick" Content="{l:Tr Catalog_New}" FontWeight="SemiBold"/>
      </WrapPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Catalog_Title}"/>
        <TextBlock Margin="0,4,12,0" Opacity="0.7" TextWrapping="Wrap" Text="{l:Tr Catalog_Subtitle}"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource CatalogCard}" Margin="0,0,0,16">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Margin="0,0,0,6" Text="{l:Tr Catalog_SearchHint}"/>
          <TextBlock Grid.Column="1" Margin="12,0,0,6" Text="{l:Tr Catalog_Category}"/>
          <TextBlock Grid.Column="2" Margin="12,0,0,6" Text="{l:Tr Catalog_Brand}"/>
          <TextBox x:Name="SearchBox" Grid.Row="1" MinHeight="36" VerticalContentAlignment="Center" TextChanged="SearchBox_OnTextChanged" AutomationProperties.Name="{l:Tr Catalog_SearchHint}"/>
          <ComboBox x:Name="CategoryFilter" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="MasterFilter_OnChanged" ToolTip="{l:Tr Catalog_Category}"/>
          <ComboBox x:Name="BrandFilter" Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="MasterFilter_OnChanged" ToolTip="{l:Tr Catalog_Brand}"/>
        </Grid>
        <WrapPanel Margin="0,12,0,0">
          <CheckBox x:Name="LowStockFilter" Margin="0,0,20,8" Checked="Filter_OnChanged" Unchecked="Filter_OnChanged" Content="{l:Tr Catalog_LowStock}"/>
          <CheckBox x:Name="NoBarcodeFilter" Margin="0,0,20,8" Checked="Filter_OnChanged" Unchecked="Filter_OnChanged" Content="{l:Tr Catalog_NoBarcode}"/>
          <CheckBox x:Name="MissingLocalFilter" Margin="0,0,20,8" Checked="Filter_OnChanged" Unchecked="Filter_OnChanged" Content="{l:Tr Catalog_MissingLocal}"/>
          <CheckBox x:Name="LooseFilter" Margin="0,0,20,8" Checked="Filter_OnChanged" Unchecked="Filter_OnChanged" Content="{l:Tr Catalog_Loose}"/>
          <CheckBox x:Name="ArchivedFilter" Margin="0,0,0,8" Checked="Filter_OnChanged" Unchecked="Filter_OnChanged" Content="{l:Tr Catalog_IncludeArchived}"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <DataGrid x:Name="ProductsGrid" Style="{StaticResource CatalogGrid}" SelectionMode="Single" SelectionChanged="ProductsGrid_OnSelectionChanged" MouseDoubleClick="ProductsGrid_OnDoubleClick">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="42" Header="✓"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Loaded="ProductCheck_OnLoaded" Click="ProductCheck_OnClick" AutomationProperties.Name="Select product"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Width="110" Header="{l:Tr Catalog_Sku}" Binding="{Binding Sku}"/>
          <DataGridTemplateColumn Width="2*" MinWidth="170" Header="{l:Tr Catalog_Name}">
            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
              <TextBlock Text="{Binding NameLocal}" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="*" MinWidth="100" Header="{l:Tr Catalog_Category}" Binding="{Binding Category}"/>
          <DataGridTextColumn Width="95" Header="{l:Tr Catalog_Stock}" Binding="{Binding Stock}"/>
          <DataGridTextColumn Width="95" Header="{l:Tr Catalog_Price}" Binding="{Binding SellingPrice}"/>
          <DataGridTextColumn Width="95" Header="{l:Tr Catalog_Mrp}" Binding="{Binding Mrp}"/>
          <DataGridCheckBoxColumn Width="80" Header="{l:Tr Catalog_Active}" Binding="{Binding IsActive}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:Tr Catalog_Empty}"/>
    </Grid>
    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
      <Button Margin="0,0,8,8" Click="SelectPage_OnClick" Content="{l:Tr Selection_ThisPage}"/>
      <Button x:Name="SelectMatchingButton" Margin="0,0,8,8" Click="SelectMatching_OnClick" Content="{l:Tr Selection_AllMatching}"/>
      <Button x:Name="ClearSelectionButton" IsEnabled="False" Margin="0,0,8,8" Click="ClearSelection_OnClick" Content="{l:Tr Selection_Clear}"/>
      <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" Margin="0,0,16,8" Text="0 selected"/>
      <Button x:Name="EditButton" IsEnabled="False" Margin="0,0,8,8" Click="Edit_OnClick" Content="{l:Tr Catalog_Edit}"/>
      <Button x:Name="LotsButton" IsEnabled="False" Margin="0,0,8,8" Click="Lots_OnClick" Content="{l:Tr Stock_Lots}"/>
      <Button x:Name="LedgerButton" IsEnabled="False" Margin="0,0,8,8" Click="Ledger_OnClick" Content="{l:Tr Stock_Ledger}"/>
      <Button x:Name="LabelsButton" IsEnabled="False" Margin="0,0,8,8" Click="Labels_OnClick" Content="{l:Tr Catalog_PrintLabels}"/>
      <Button x:Name="BarcodeButton" IsEnabled="False" Margin="0,0,8,8" Click="GenerateBarcode_OnClick" Content="{l:Tr Catalog_GenerateBarcode}"/>
      <Button x:Name="BulkButton" IsEnabled="False" Margin="0,0,8,8" Click="Bulk_OnClick" Content="{l:Tr Catalog_BulkEdit}"/>
      <Button x:Name="RestoreButton" IsEnabled="False" Margin="0,0,8,8" Click="Restore_OnClick" Content="{l:Tr Catalog_Restore}"/>
      <Button x:Name="RemoveButton" IsEnabled="False" Margin="0,0,0,8" Click="Remove_OnClick" Content="{l:Tr Catalog_Remove}"/>
      <Button x:Name="BulkRemoveButton" IsEnabled="False" Margin="8,0,8,8" Click="BulkRemove_OnClick" Content="{l:Tr Catalog_RemoveSelected}"/>
      <Button x:Name="BulkRestoreButton" IsEnabled="False" Margin="0,0,8,8" Click="BulkRestore_OnClick" Content="{l:Tr Catalog_RestoreSelected}"/>
    </WrapPanel>
    <DockPanel Grid.Row="4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Common_RowsPerPage}"/>
        <ComboBox x:Name="PageSizeBox" ToolTip="{l:Tr Common_RowsPerPage}" Width="65" SelectedIndex="2" SelectionChanged="PageSize_OnChanged">
          <ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/>
        </ComboBox>
        <Button x:Name="PreviousPageButton" IsEnabled="False" Margin="8,0" Click="PreviousPage_OnClick" Content="{l:Tr Sales_Previous}"/>
        <Button x:Name="NextPageButton" IsEnabled="False" Click="NextPage_OnClick" Content="{l:Tr Sales_Next}"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Page>
