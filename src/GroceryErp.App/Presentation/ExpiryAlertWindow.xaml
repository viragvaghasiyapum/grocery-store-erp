<Window
    x:Class="GroceryErp.App.Presentation.ExpiryAlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    Title="{l:Tr MoneyOut_ExpiryAlertTitle}"
    Width="420" Height="250" MinWidth="390" MinHeight="240" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{l:Tr MoneyOut_ExpiryAlertTitle}"/>
    <TextBlock x:Name="AlertText" Grid.Row="1" Margin="0,16" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Margin="0,0,8,0" Click="Later_OnClick" Content="{l:Tr MoneyOut_Later}"/>
      <Button Click="View_OnClick" Content="{l:Tr MoneyOut_ViewExpiry}"/>
    </StackPanel>
  </Grid>
</Window>
