<Window x:Class="GroceryErp.App.Presentation.AdvanceFormWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
    xmlns:p="clr-namespace:GroceryErp.App.Presentation"
    Title="{l:Tr MoneyOut_RecordAdvance}" Width="500" Height="480" MinWidth="420" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}"
    NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-IN" NumberSubstitution.Substitution="European" p:ScreenHelp.Topic="advance-form">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <p:HelpButton DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"/>
        <TextBlock Style="{StaticResource FormTitle}" Text="{l:Tr MoneyOut_RecordAdvance}"/>
      </DockPanel>
      <TextBlock Style="{StaticResource FormContext}" Text="{l:Tr MoneyOut_AdvanceContext}"/>
    </StackPanel>
    <p:FormErrorSummary x:Name="Summary" Grid.Row="1"/>
    <StackPanel x:Name="Fields" Grid.Row="2" Margin="0,8,0,0">
      <p:FormField x:Name="EmployeeField" Label="{l:Tr MoneyOut_EmployeeName}" IsRequired="True">
        <ComboBox x:Name="EmployeeBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
      </p:FormField>
      <UniformGrid Columns="2">
        <p:FormField x:Name="AmountField" Label="{l:Tr MoneyOut_Advance}" IsRequired="True">
          <TextBox x:Name="AmountBox"/>
        </p:FormField>
        <p:FormField x:Name="PayDateField" Label="{l:Tr MoneyOut_PayDate}" IsRequired="True">
          <DatePicker x:Name="PayDateBox" SelectedDateFormat="Short" SelectedDateChanged="PayDate_OnChanged"/>
        </p:FormField>
        <p:FormField x:Name="ModeField" Label="{l:Tr Purchasing_Mode}" IsRequired="True">
          <ComboBox x:Name="ModeBox" SelectedIndex="0">
            <ComboBoxItem Tag="CASH" Content="{l:Tr MoneyOut_ModeCash}"/>
            <ComboBoxItem Tag="UPI" Content="UPI"/>
            <ComboBoxItem Tag="BANK" Content="{l:Tr MoneyOut_ModeBank}"/>
            <ComboBoxItem Tag="OTHER" Content="{l:Tr MoneyOut_ReasonOther}"/>
          </ComboBox>
        </p:FormField>
      </UniformGrid>
      <p:FormField x:Name="NotesField" Label="{l:Tr Purchasing_Notes}">
        <TextBox x:Name="NotesBox" MaxLength="500"/>
      </p:FormField>
      <TextBlock x:Name="PeriodText" Style="{StaticResource FormPreview}"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Style="{StaticResource FormFooter}">
      <Button Margin="0,0,8,0" IsCancel="True" Content="{l:Tr Common_Cancel}"/>
      <Button x:Name="SaveButton" IsDefault="True" Click="Save_OnClick" Content="{l:Tr MoneyOut_RecordAdvance}"/>
    </StackPanel>
  </Grid>
</Window>
