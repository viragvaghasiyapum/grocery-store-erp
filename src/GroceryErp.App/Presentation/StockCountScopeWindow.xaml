<Window x:Class="GroceryErp.App.Presentation.StockCountScopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GroceryErp.Localization;assembly=GroceryErp.Localization"
        Title="{l:Tr Stock_NewCount}" Width="500" Height="540" MinHeight="440" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{l:Tr Stock_NewCount}"/>
      <TextBlock Margin="0,4,0,0" Text="{l:Tr Stock_ScopeHint}" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <CheckBox x:Name="AllCategoriesBox" Grid.Row="1" IsChecked="False" Checked="AllCategoriesBox_OnChanged"
              Unchecked="AllCategoriesBox_OnChanged" Content="{l:Tr Stock_AllCategories}" Margin="0,0,0,12"/>
    <ListBox x:Name="CategoriesBox" Grid.Row="2" DisplayMemberPath="Name" SelectionMode="Multiple" IsEnabled="True"/>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="{l:Tr Purchasing_Notes}"/>
      <TextBox x:Name="NotesBox" Margin="0,4,0,0"/>
      <TextBlock x:Name="ErrorText" Foreground="Crimson" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Margin="0,0,8,0" Click="Continue_OnClick" Content="{l:Tr Stock_CreateSheet}"/>
      <Button Click="Cancel_OnClick" Content="{l:Tr Common_Cancel}"/>
    </StackPanel>
  </Grid>
</Window>
