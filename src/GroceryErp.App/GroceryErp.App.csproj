<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>GroceryErp.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <!-- WithCulture="false": without it MSBuild reads ".en"/".gu" as a resource culture and moves each
         file into a satellite assembly, where ReleaseNotesService cannot find it. -->
    <EmbeddedResource Include="CHANGELOG.en.md" WithCulture="false" />
    <EmbeddedResource Include="CHANGELOG.gu.md" WithCulture="false" />
    <!-- Screen help: one file per screen and language, shared with the user guide (ScreenHelp.Read). -->
    <EmbeddedResource Include="../../docs/user-guide/help/en/*.md" LogicalName="GroceryErp.App.Help.en.%(Filename).md" WithCulture="false" />
    <EmbeddedResource Include="../../docs/user-guide/help/gu/*.md" LogicalName="GroceryErp.App.Help.gu.%(Filename).md" WithCulture="false" />
    <Resource Include="../../logo/logo.jpeg" Link="Assets/logo.jpeg" />
    <InternalsVisibleTo Include="GroceryErp.UI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GroceryErp.Localization/GroceryErp.Localization.csproj" />
    <ProjectReference Include="../GroceryErp.Data/GroceryErp.Data.csproj" />
    <ProjectReference Include="../GroceryErp.UI.Common/GroceryErp.UI.Common.csproj" />
    <ProjectReference Include="../GroceryErp.Printing/GroceryErp.Printing.csproj" />
    <ProjectReference Include="../Modules/GroceryErp.Catalog/GroceryErp.Catalog.csproj" />
    <ProjectReference Include="../Modules/GroceryErp.Inventory/GroceryErp.Inventory.csproj" />
    <ProjectReference Include="../Modules/GroceryErp.Purchasing/GroceryErp.Purchasing.csproj" />
    <ProjectReference Include="../Modules/GroceryErp.Sales/GroceryErp.Sales.csproj" />
    <ProjectReference Include="../Modules/GroceryErp.Expenses/GroceryErp.Expenses.csproj" />
    <ProjectReference Include="../Modules/GroceryErp.Assets/GroceryErp.Assets.csproj" />
    <ProjectReference Include="../Modules/GroceryErp.Reports/GroceryErp.Reports.csproj" />
    <ProjectReference Include="../Modules/GroceryErp.Settings/GroceryErp.Settings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
